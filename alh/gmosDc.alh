GROUP NULL MAIN

   $GUIDANCE
   Top level alarm group for GMOS - $(name)
   $END

   GROUP MAIN TEMPERATURES

      $GUIDANCE
      Detector controller temperature alarms.
      --------------------------------------------
      Check dewar vacuum if too warm.
      If the detector temperature is static at around 201C,
      the GMOS DC needs re-initialising. Use initCad from
      the DC screens.
      $END

      CHANNEL TEMPERATURES $(top)sad:dc:detTemp
      $ALIAS Detector temperature
