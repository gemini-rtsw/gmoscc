recordtype(assemblyControl) {
	include "dbCommon.dbd" 
	field(DIR,DBF_MENU) {
		prompt("Directive")
		pp(TRUE)
		interest(1)
		menu(assemblyControlDIR)
	}
	field(MODE,DBF_MENU) {
		prompt("Operating Mode")
		promptgroup(GUI_COMMON)
