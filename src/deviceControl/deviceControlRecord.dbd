menu(deviceControlDIR) {
	choice(DDR_DIR_STOP,"STOP")
	choice(DDR_DIR_CHECK,"CHECK")
	choice(DDR_DIR_GO,"GO")
}
menu(deviceControlMODE) {
	choice(DDR_MODE_INIT,"INIT")
	choice(DDR_MODE_MOVE,"MOVE")
	choice(DDR_MODE_TRACK,"TRACK")
	choice(DDR_MODE_INDEX,"INDEX")
	choice(DDR_MODE_PARK,"PARK")
	choice(DDR_MODE_TEST,"TEST")
}
menu(deviceControlIALG) {
	choice(DDR_INDEX_NONE,"NONE")
	choice(DDR_INDEX_LHSW,"LOWHOME")
	choice(DDR_INDEX_UHSW,"UPPHOME")
	choice(DDR_INDEX_CHSW,"CENHOME")
	choice(DDR_INDEX_LLSW,"LOWLIM")
	choice(DDR_INDEX_ULSW,"UPPLIM")
}
menu(deviceControlBUSY) {
	choice(DDR_CMD_IDLE,"IDLE")
	choice(DDR_CMD_BUSY,"BUSY")
	choice(DDR_CMD_ERROR,"ERROR")
}
menu(deviceControlSIMM) {
	choice(DDR_SIM_NONE,"NONE")
	choice(DDR_SIM_VSM,"VSM")
	choice(DDR_SIM_FAST,"FAST")
	choice(DDR_SIM_FULL,"FULL")
}
menu(deviceControlDBUG) {
	choice(DDR_DBUG_QUIET,"QUIET")
	choice(DDR_DBUG_NONE,"NONE")
	choice(DDR_DBUG_MIN,"MIN")
	choice(DDR_DBUG_FULL,"FULL")
	choice(DDR_DBUG_MAX,"MAX")
}
menu(deviceControlMIP) {
	choice(DDR_MIP_STOPPED,"STOPPED")
	choice(DDR_MIP_BEGINNING,"BEGINNING")
	choice(DDR_MIP_MOVING,"MOVING")
	choice(DDR_MIP_HOLDING,"HOLDING")
	choice(DDR_MIP_ENDING,"ENDING")
	choice(DDR_MIP_ERROR,"ERROR")
}
menu(deviceControlUAPB) {
	choice(DDR_UAPB_NO,"NO")
	choice(DDR_UAPB_YES,"YES")
}
recordtype(deviceControl) {
	include "dbCommon.dbd" 
	field(DIR,DBF_MENU) {
		prompt("Directive")
		pp(TRUE)
		interest(1)
		menu(deviceControlDIR)
	}
	field(MODE,DBF_MENU) {
		prompt("Operating Mode")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(deviceControlMODE)
	}
	field(VAL,DBF_DOUBLE) {
		prompt("User Position Value")
	}
	field(VALS,DBF_STRING) {
		prompt("User Position String")
		interest(1)
		size(40)
	}
	field(VELO,DBF_FLOAT) {
		prompt("Velocity (EGU/s)")
		promptgroup(GUI_COMMON)
	}
	field(VBAS,DBF_FLOAT) {
		prompt("Base Velocity (EGU/s)")
		promptgroup(GUI_COMMON)
	}
	field(FIVL,DBF_FLOAT) {
		prompt("Final Index Vel (EGU/s)")
		promptgroup(GUI_COMMON)
	}
	field(ACCL,DBF_FLOAT) {
		prompt("Acceleration (EGU/Sec)")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(MRES,DBF_FLOAT) {
		prompt("Motor Resolution")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(ERES,DBF_FLOAT) {
		prompt("Encoder Resolution")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(IALG,DBF_MENU) {
		prompt("Index Algorithm")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(deviceControlIALG)
	}
	field(MRND,DBF_LONG) {
		prompt("Motor Rounding Factor")
		promptgroup(GUI_COMMON)
	}
	field(BLCO,DBF_FLOAT) {
		prompt("BL Correction (EGU)")
		promptgroup(GUI_COMMON)
	}
	field(PWR,DBF_LONG) {
		prompt("Power Control")
		interest(1)
	}
	field(BRK,DBF_LONG) {
		prompt("Brake Control")
		interest(1)
	}
	field(PSTA,DBF_LONG) {
		prompt("Power Feedback State")
	}
	field(BSTA,DBF_LONG) {
		prompt("Brake Feedback State")
	}
	field(FLT,DBF_LONG) {
		prompt("Fault")
		special(SPC_MOD)
	}
	field(UAPB,DBF_MENU) {
		prompt("Use Auxiliary Power Bit")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(deviceControlUAPB)
	}
	field(UEIP,DBF_MENU) {
		prompt("Use Encoder if Present")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(deviceControlUAPB)
	}
	field(UPSB,DBF_MENU) {
		prompt("Use Power Status Bit")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(deviceControlUAPB)
	}
	field(UBSB,DBF_MENU) {
		prompt("Use Brake Status Bit")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(deviceControlUAPB)
	}
	field(MDBD,DBF_FLOAT) {
		prompt("Motion Deadband (EGU)")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(EDBD,DBF_LONG) {
		prompt("Encoder Deadband")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(OMSL,DBF_MENU) {
		prompt("Output Mode Select")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(menuOmsl)
	}
	field(SIMM,DBF_MENU) {
		prompt("Simulation Mode")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(deviceControlSIMM)
	}
	field(DBUG,DBF_MENU) {
		prompt("Debug Mode")
		promptgroup(GUI_COMMON)
		interest(1)
		menu(deviceControlDBUG)
	}
	field(TDIR,DBF_STRING) {
		prompt("Translation Directory")
		promptgroup(GUI_COMMON)
		interest(1)
		size(40)
	}
	field(TFIL,DBF_STRING) {
		prompt("Translation File")
		promptgroup(GUI_COMMON)
		interest(1)
		size(40)
	}
	field(OUT,DBF_OUTLINK) {
		prompt("Output Specification")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(DOL,DBF_INLINK) {
		prompt("Desired Output Loc")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(BSYL,DBF_OUTLINK) {
		prompt("Busy Link")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(MSGL,DBF_OUTLINK) {
		prompt("Error Message Link")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(PWRL,DBF_OUTLINK) {
		prompt("Power Control Link")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(BRKL,DBF_OUTLINK) {
		prompt("Brake Control Link")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(SIML,DBF_INLINK) {
		prompt("Simulation Mode Link")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(DBGL,DBF_INLINK) {
		prompt("Debug Mode Link")
		promptgroup(GUI_COMMON)
		special(SPC_NOMOD)
		interest(1)
	}
	field(ACK,DBF_LONG) {
		prompt("Command Status")
	}
	field(BUSY,DBF_MENU) {
		prompt("Device Action State")
		menu(deviceControlBUSY)
	}
	field(MESS,DBF_STRING) {
		prompt("Error Message")
		size(40)
	}
	field(MPOS,DBF_DOUBLE) {
		prompt("Motor Position")
	}
	field(MIP,DBF_MENU) {
		prompt("Motion In Progress")
		interest(1)
		menu(deviceControlMIP)
	}
	field(MSTA,DBF_LONG) {
		prompt("Motor Status")
		interest(1)
	}
	field(HPVL,DBF_SHORT) {
		prompt("Home Position Valid")
		interest(1)
	}
	field(HSWA,DBF_SHORT) {
		prompt("Home Switch Active")
	}
	field(LSWA,DBF_SHORT) {
		prompt("Limit Switch Active")
	}
	field(RPOS,DBF_LONG) {
		prompt("Raw motor position")
		interest(1)
	}
	field(RVEL,DBF_LONG) {
		prompt("Raw motor velocity")
		interest(1)
	}
	field(RRBV,DBF_LONG) {
		prompt("Raw position readback")
		interest(1)
	}
	field(RENC,DBF_LONG) {
		prompt("Raw encoder readback")
		interest(1)
	}
	field(PHLM,DBF_FLOAT) {
		prompt("Position High Limit")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(PLLM,DBF_FLOAT) {
		prompt("Position Low Limit")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(VHLM,DBF_FLOAT) {
		prompt("Velocity High Limit")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(VLLM,DBF_FLOAT) {
		prompt("Velocity Low Limit")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(LVIO,DBF_SHORT) {
		prompt("Limit Violation")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(BTMO,DBF_SHORT) {
		prompt("Brake Timeout")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(PTMO,DBF_SHORT) {
		prompt("Power Timeout")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(PREC,DBF_SHORT) {
		prompt("Display Precision")
		promptgroup(GUI_COMMON)
		interest(1)
	}
	field(EGU,DBF_STRING) {
		prompt("Engineering Units")
		promptgroup(GUI_COMMON)
		interest(1)
		size(16)
	}
	field(VERS,DBF_FLOAT) {
		prompt("Code Version")
		interest(1)
		initial("1")
	}
	field(ALST,DBF_DOUBLE) {
		prompt("Last Value Archived")
		special(SPC_NOMOD)
		interest(3)
	}
	field(MLST,DBF_DOUBLE) {
		prompt("Last Value Monitored")
		special(SPC_NOMOD)
		interest(3)
	}
	field(PP,DBF_SHORT) {
		prompt("Post process command")
		interest(2)
	}
	field(OSTA,DBF_SHORT) {
		prompt("Operating State")
		interest(2)
	}
	field(LTHP,DBF_NOACCESS) {
		prompt("Lookup Table Head Ptr")
		special(SPC_NOMOD)
		interest(1)
		extra("void *lthp")
	}
	field(MMAP,DBF_ULONG) {
		prompt("Monitor Mask")
		interest(3)
	}
	field(LMAP,DBF_ULONG) {
		prompt("Link Trigger Mask")
		interest(3)
	}
	field(MDEL,DBF_FLOAT) {
		prompt("Monitor Deadband")
		promptgroup(GUI_COMMON)
		interest(3)
	}
	field(ADEL,DBF_FLOAT) {
		prompt("Archive Deadband")
		promptgroup(GUI_COMMON)
		interest(3)
	}
	field(HIHI,DBF_FLOAT) {
		prompt("Hihi Alarm Limit")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
	}
	field(LOLO,DBF_FLOAT) {
		prompt("Lolo Alarm Limit")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
	}
	field(HIGH,DBF_FLOAT) {
		prompt("High Alarm Limit")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
	}
	field(LOW,DBF_FLOAT) {
		prompt("Low Alarm Limit")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
	}
	field(HHSV,DBF_MENU) {
		prompt("Hihi Severity")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
		menu(menuAlarmSevr)
	}
	field(LLSV,DBF_MENU) {
		prompt("Lolo Severity")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
		menu(menuAlarmSevr)
	}
	field(HSV,DBF_MENU) {
		prompt("High Severity")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
		menu(menuAlarmSevr)
	}
	field(LSV,DBF_MENU) {
		prompt("Low Severity")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
		menu(menuAlarmSevr)
	}
	field(HLSV,DBF_MENU) {
		prompt("HW Limit Violation Svr")
		promptgroup(GUI_COMMON)
		pp(TRUE)
		interest(2)
		menu(menuAlarmSevr)
	}
}
