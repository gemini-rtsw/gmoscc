/*
*   FILENAME
*   --------
*   dtaAssemblyCar.stpp
*
*   DESCRIPTION
*   -----------
*   This file contains the EPICS state transition language program for
*   managing the CAR record associated with the GMOS translation assembly.
*   The program monitors the BUSY field of the assembly record and transmits
*   changes of state to the corresponding assembly CAR record. The major
*   difference between the translation assembly and other assemblies is
*   that the CAR record should not go BUSY when the assembly is being driven
*   by the instrument sequencer in FOLLOW mode. This prevents the OCS seeing
*   the instrument going BUSY spontaneously in this mode.
*   SNL is used because it ensures the assembly and CAR records are in different
*   lock sets.
*
*   FUNCTION NAME(S)
*   ----------------
*   dta_ss  - Manage detector translation assembly CAR record.
*
*   PROGRAM
*   --------
*   dtaAssemblyCar
*
*   INVOCATION
*   -----------
*   Include the following line in the VxWorks startup script:
*
*   seq &dtaAssemblyCar, "top=gm:, dev=dta"
*
*   NOTE
*   ----
*   This task needs to be run at a sufficiently high priority so the task which results in the
*   assembly record going BUSY does not itself lock out this task and prevent it responding to
*   the IDLE-BUSY event.
*
*   PARAMETERS (all are input)
*   --------------------------
*      top      string    String to be substituted for the {top} macro
*                         used to for the top level name of the prefix
*                         EPICS database. The default value is "gm:cc:"
*
*      dev      string    String to be substituted for the {dev} macro
*                         used for the name of the device. The default
*                         value is "dta"
*
*   RETURN VALUE
*   ------------
*   N/A
*
*
*   AUTHOR
*   ------
*   Steven Beard, UKATC  (smb@roe.ac.uk)
*
*/
/* *INDENT-OFF* */
/*
 * $Log$
 * Revision 1.1  2001/01/26 11:40:03  gmos
 * New SNL code based on assemblyCar.stpp. This one only allows the CAR record to go BUSY when the assembly is not tracking.
 *
 *
 */
/* *INDENT-ON* */

program dtaAssemblyCar ("top=gm:, dev=dta")

/*
 * The following option is needed to make the code reentrant.
 * This allows a separate copy of this sequence program to be
 * loaded for each assembly.
 */

option +r;

%%static char rcsid[]="$Id$";

%%#include <stdlib.h>
%%#include <stdioLib.h>
%%#include <string.h>
%%#include <ctype.h>
%%#include <logLib.h>

%%#include <cad.h>
%%#include <car.h>


/*
 * The following declarations assign variables to fields in the EPICS database.
 */

long trackingFlag;     /* Whether instrument sequencer is in following mode. */
assign trackingFlag to "{top}{dev}CadtrackingXY.VAL";
monitor trackingFlag;

long assemblyBusy;     /* BUSY output from the assembly record */
assign assemblyBusy to "{top}cc:{dev}Assembly.BUSY";
monitor assemblyBusy;

string assemblyMess;   /* Message output from the assembly record */
assign assemblyMess to "{top}cc:{dev}Assembly.MESS";

string assemblyName;   /* Name of assembly record */
assign assemblyName to "{top}cc:{dev}Assembly.NAME";

long carIval;          /* State input to the CAR record */
assign carIval to "{top}cc:{dev}C.IVAL";

long carIerr;          /* Error status input to the CAR record */
assign carIerr to "{top}cc:{dev}C.IERR";

string carImss;        /* Message input to the CAR record */
assign carImss to "{top}cc:{dev}C.IMSS";


/* ===================================================================== */

ss dta_ss
{

/*+
 *   Function name:
 *   State set "dta_ss"
 *
 *   Purpose:
 *   Manage CAR record associated with a GMOS assembly
 *
 *   Invocation:
 *   Invoked automatically when sequence program "dtaAssemblyCar" starts.
 *
 *   Parameters: (">" input, "!" modified, "<" output)
 *   None
 *
 *   Return value:
 *   N/A
 *
 *   External functions:
 *   EPICS sequencer functions used are
 *   pvGet      - Get a process variable
 *   pvPut      - Put a process variable
 *
 *   External variables:
 *   See definitions above
 *
 *   Requirements:
 *   Same as requirements for program "dtaAssemblyCar"
 *
 *   Limitations:
 *   Same as limitations for program "dtaAssemblyCar"
 *
 *-
 */

/* --------------------------------------------------------------------- */

  state init
  {

/*
 * state init - This is the state the dta_ss state set begins in
 *              when it first starts running.
 */
 
/* Wait until all the appropriate connections have been made. */

    when ( pvConnectCount( ) == pvChannelCount( ) )
    {
      pvGet( assemblyName );
      logMsg( "SNL for %s connected.\n", assemblyName, 0, 0, 0, 0, 0 );

      /* Carry out any initialisation here. */

      /* Jump to the "idle" state. */

    } state idle
  }
 
/* --------------------------------------------------------------------- */

  state idle
  {

/*
 * state idle - Remain in this state until the assembly record goes BUSY.
 *              When this happens set the CAR record to busy and jump to
 *              the BUSY state. If the assembly starts tracking, go to
 *              the tracking state until it has finished.
 */

    when ( assemblyBusy == CAR_BUSY )
    {

      carIval = CAR_BUSY;
      pvPut( carIval );

    } state busy

    when ( trackingFlag == 1 )
    {

      logMsg( "%s tracking.\n", assemblyName, 0, 0, 0, 0, 0 );

    } state tracking
  }

/* --------------------------------------------------------------------- */

  state tracking
  {

/*
 * state tracking - Remain in this state until the assembly stops tracking.
 *                  While in this state, no BUSY events will be transmitted to
 *                  the CAR record.
 */

    when ( trackingFlag == 0 )
    {
      logMsg( "%s not tracking.\n", assemblyName, 0, 0, 0, 0, 0 );

    } state idle
  }

/* --------------------------------------------------------------------- */

  state busy
  {

/*
 * state busy - Remain in this state until the assembly record goes IDLE or ERROR.
 */

    when ( assemblyBusy == CAR_IDLE )
    {

      /*
       * When the assembly record goes IDLE reflect that fact in the CAR record
       * and jump to the IDLE state.
       */

      carIval = CAR_IDLE;
      pvPut( carIval );

    } state idle

/*                               --  --  --                              */

    when ( assemblyBusy == CAR_ERROR )
    {

      /*
       * When an error occurs transfer the error information to the CAR record
       * and jump to the ERROR state.
       */

      pvGet( assemblyMess );
      strcpy( carImss, assemblyMess );
      pvPut( carImss );

      carIerr = -1;
      pvPut( carIerr );

      carIval = CAR_ERROR;
      pvPut( carIval );

    } state error
  }

/* --------------------------------------------------------------------- */

  state error
  {

/*
 * state error - Remain in this state until the assembly record goes BUSY again
 * or back to IDLE.
 */

    when ( assemblyBusy == CAR_IDLE )
    {
      /*
       * When the assembly record goes IDLE clear the CAR record
       * and jump to the IDLE state.
       */

      carIerr = 0;
      pvPut( carIerr );

      carIval = CAR_IDLE;
      pvPut( carIval );

    } state idle

/*                               --  --  --                              */

    when ( assemblyBusy == CAR_BUSY )
    {

      /*
       * When the assembly record goes BUSY clear the CAR record
       * and jump to the BUSY state.
       */

      carIerr = 0;
      pvPut( carIerr );

      carIval = CAR_BUSY;
      pvPut( carIval );

    } state busy
  }
}
