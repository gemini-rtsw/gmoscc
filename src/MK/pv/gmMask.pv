#
# GMOS mask assembly initialization
#
#

# Set default deviceControl configuration parameters:
#
#    ACCL  Acceleration (& deceleration) in EGUs/sec/sec 
#          Motors will execute a linear ramp from VBAS to VELO
#          and unless a move is aborted with finish with a linear ramp 
#          down from VELO to VBAS.  See also VBAS, VELO & FIVL.
#    BTMO  Brake status check timeout in 0.1 second units - set to 0 if no 
#          brake. Also used to delay motion after brakes are removed or  
#          delay power-off after brakes are applied (uses timeout instead 
#          status).  See UBSB.
#    EDBD  Encoder deadband (in counts). Encoder changes within range of 
#          EDBD is considered acceptable noise.  See ERES & UEIP.
#    EGU   Engineering units for target position
#    ERES  Encoder resolution, number of encoder counts per EGU 
#          There are no encoders in mask assembly
#    FIVL  Final indexing velocity in EGUs/sec., which is used for the final 
#          critical indexing sequence when home switches are used.
#          Must work out to less than 1024 steps per second when 
#          the OMS VME-8/44 cards are used and like VELO, must be greater
#          than VBAS. 
#    IALG  Indexing algorithm
#             0 - move without indexing
#             1 - go in the negative direction and index on the home switch 
#             2 - go in the positive direction and index on the home switch
#             3 - index on the centre home switch
#             4 - go negative and index on the lower soft limit switch
#             5 - go positive and index on the upper soft limit switch
#    MDBD  Motion deadband in EGUs, moves within the range of MDBD will 
#          show as completed without moving
#    MRES  Motor resolution, number of steps per EGU
#    PHLM  Target position high limit in EGUs
#    PLLM  Target position low limit in EGUs
#    PTMO  Power status check timeout in 0.1 second units, used as a delay
#          before checking power status bit after turning drive on/off
#          See also UPSB & UAPB.
#    UAPB  Use auxilliary power bit (0 | 1), 1 means the AUX power bit will 
#          be used to control the drive enable.  See PTMO & UPSB.
#    UBSB  Use brake status check (0 | 1), 1 means status is used to 
#          indicate when the brakes are applied.
#    UEIP  Use encoder if one is detected (0 | 1), 1 means an encoder will
#          be used to determine current position.  See ERES.
#    UPSB  Use power status check (0 | 1), 1 means that drive enable status
#          is monitored.
#    VBAS  Minimum velocity in EGUs/sec, defines the starting velocity for
#          ramping up to VELO and the ending velocity for ramping down.
#          The OMS VME 8/44 requires that VBAS is greater than zero and
#          less than the programmed velocity and must be set because the 
#          default is zero.  See VELO, FIVL & ACCL.
#    VELO  Target velocity in EGUs/sec, or at least the default at startup
#    VHLM  Velocity high limit in EGUs/sec.  Target velocity (VELO) must
#          be within VLLM & VHLM but not VBAS or FIVL.
#    VLLM  Velocity low limit in EGUs/sec
#
# Mask Assembly
#
group {
   long $(top)mskAssembly.D     =    1; # casette number for single update
   long $(top)mskAssembly.ADHL  =    3; # hi lim for cassette number
   long $(top)mskAssembly.ADLL  =    1; # lo lim for cassette number
   long $(top)mskAssembly.E     =    1; # slot number for single update
   long $(top)mskAssembly.AEHL  =    9; # hi lim for slot number
   long $(top)mskAssembly.AELL  =    1; # lo lim for slot number
   long $(top)mskAssembly.SIL   =    0; # makes barcodeID in SAD happy
   string $(top)ifuSelection.B = "10000004"; # default ifu mode
   long   $(top)mskAssembly.SIM   =       -1; # default to Single Update Mode
   long   $(top)mskAssembly.SIN   =       0; # barcode reader error ignore is FALSE
}
#
# Mask Cassette Device
#
group {
   double $(top)mskCasDevice.ACCL =   100.0;
   string $(top)mskCasDevice.EGU  =    "mm";
   double $(top)mskCasDevice.FIVL =     2.5;
   long   $(top)mskCasDevice.IALG =       1;
   double $(top)mskCasDevice.MDBD =  0.0025;
   double $(top)mskCasDevice.MRES =   400.0;
   double $(top)mskCasDevice.PHLM =   275.0;
   double $(top)mskCasDevice.PLLM =   -10.0;
   long   $(top)mskCasDevice.PREC =       4;
   long   $(top)mskCasDevice.UAPB =       1;
   long   $(top)mskCasDevice.UBSB =       0;
   long   $(top)mskCasDevice.UEIP =       0;
   long   $(top)mskCasDevice.UPSB =       1;
# DISABLE POWER STATUS CHECK UNTIL MASK ELECTRONICS PROBLEM FIXED
#   long   $(top)mskCasDevice.UPSB =       0;
   double $(top)mskCasDevice.VBAS =     0.5;
   double $(top)mskCasDevice.VELO =    20.0;
   double $(top)mskCasDevice.VHLM =    25.0;
   double $(top)mskCasDevice.VLLM =     5.0;
}
#
# Mask Extractor Device
#
group {
   double $(top)mskExtDevice.ACCL =   150.0;
   string $(top)mskExtDevice.EGU  =    "mm";
   double $(top)mskExtDevice.FIVL =     5.0;
   long   $(top)mskExtDevice.IALG =       2;
   double $(top)mskExtDevice.MDBD =   0.005;
   double $(top)mskExtDevice.MRES =   200.0;
   double $(top)mskExtDevice.PHLM =     4.0;
   double $(top)mskExtDevice.PLLM =  -447.5;
   long   $(top)mskExtDevice.PREC =       4;
   long   $(top)mskExtDevice.UAPB =       1;
   long   $(top)mskExtDevice.UBSB =       0;
   long   $(top)mskExtDevice.UEIP =       0;
   long   $(top)mskExtDevice.UPSB =       1;
# DISABLE POWER STATUS CHECK UNTIL MASK ELECTRONICS PROBLEM FIXED
#   long   $(top)mskExtDevice.UPSB =       0;
   double $(top)mskExtDevice.VBAS =     2.0;
   double $(top)mskExtDevice.VELO =    35.0;
   double $(top)mskExtDevice.VHLM =    40.0;
   double $(top)mskExtDevice.VLLM =     5.0;
}
#
# Mask Gripper Device
#
group {
   double $(top)mskGrpDevice.ACCL =   100.0;
   double $(top)mskGrpDevice.BTMO =     0.0;
   string $(top)mskGrpDevice.EGU  =   "EGU";
   long   $(top)mskGrpDevice.IALG =       5;
   double $(top)mskGrpDevice.MDBD =   0.005;
   double $(top)mskGrpDevice.MRES =   200.0;
   double $(top)mskGrpDevice.PHLM =    50.0;
   double $(top)mskGrpDevice.PLLM =   -50.0;
   long   $(top)mskGrpDevice.PREC =       4;
   long   $(top)mskGrpDevice.UAPB =       1;
   long   $(top)mskGrpDevice.UBSB =       0;
   long   $(top)mskGrpDevice.UEIP =       0;
   long   $(top)mskGrpDevice.UPSB =       1;
# DISABLE POWER STATUS CHECK UNTIL MASK ELECTRONICS PROBLEM FIXED
#   long   $(top)mskGrpDevice.UPSB =       0;
   double $(top)mskGrpDevice.VBAS =     0.1;
   double $(top)mskGrpDevice.VELO =    10.0;
   double $(top)mskGrpDevice.VHLM =    15.0;
   double $(top)mskGrpDevice.VLLM =     5.0;
}
#
# Mask Release Device
#
group {
   double $(top)mskRelDevice.ACCL =   100.0;
   double $(top)mskRelDevice.BTMO =     0.0;
   string $(top)mskRelDevice.EGU  =   "EGU";
   long   $(top)mskRelDevice.IALG =       5;
   double $(top)mskRelDevice.MDBD =   0.005;
   double $(top)mskRelDevice.MRES =   200.0;
   double $(top)mskRelDevice.PHLM =    60.0;
   double $(top)mskRelDevice.PLLM =   -60.0;
   long   $(top)mskRelDevice.PREC =       4;
   long   $(top)mskRelDevice.UAPB =       1;
   long   $(top)mskRelDevice.UBSB =       0;
   long   $(top)mskRelDevice.UEIP =       0;
   long   $(top)mskRelDevice.UPSB =       1;
# DISABLE POWER STATUS CHECK UNTIL MASK ELECTRONICS PROBLEM FIXED
#   long   $(top)mskRelDevice.UPSB =       0;
   double $(top)mskRelDevice.VBAS =     0.1;
   double $(top)mskRelDevice.VELO =     5.0;
   double $(top)mskRelDevice.VHLM =    15.0;
   double $(top)mskRelDevice.VLLM =     5.0;
}


# Load hi and lo limits for verifying extractor position with LVDT
#
group {
   double $(top)mskExtAtLvdtLo  =   -2.50; # Extractor in lvdt when > limit
#
#     grip position is 3.15 adjust for +-0.15
#     15/12/01 grip position changed to 3.20 +-0.15 after maintenance
#     values changed after tuning due to gripper problem 2/27/2004
#
   double $(top)mskExtAtGrpLo   =    2.85; # Extractor at Grip position lo limit
# AWE 12/21/06 temporarily change the ExtAtGrpHi limit from 3.20 to 3.25 because Grip position is at this limit
   double $(top)mskExtAtGrpHi   =    3.25; # Extractor at Grip position hi limit
#
#     release position is 3.80 adjust for +-0.15
#     15/12/01 release position changed to 3.85 +-0.15 after maintenance
#     09/04/21 release low limit changed to 3.83 (FR-71800)
   double $(top)mskExtAtRelLo   =    3.83; # Extractor at Release position lo limit
   double $(top)mskExtAtRelHi   =    4.15; # Extractor at Release position hi limit
}

#
#     This is a workaround.  For some reason this bit does not represent
#     its Xycom240 input immediately after a reboot.  If ANY of the bits
#     in the same port change before this bit is read then it can be read
#     correctly, otherwise the following must be sent to process the record
#     and cause the bit to read.
#
long   $(top)mskNotAligned.PROC =    1; 
