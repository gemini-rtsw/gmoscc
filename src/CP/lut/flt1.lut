#
# Lookup table for filter wheel 1
# Translates position names into motor positions
#
# Recalibrated on 4 December 2000 after first refurbishment.
# Unchanged on 31 January 2001.
#

# name         target   index

index           0.0     3     # index with standard index mode
park            0.01    0     # go to default park position
pos0          -12.55    0
pos1          -10.45    0
pos2           -8.35    0
pos3           -6.25    0
pos4           -4.17    0
pos5           -2.06    0
pos6            0.03    0
pos7            2.12    0
pos8            4.22    0
pos9            6.32    0
pos10           8.43    0
pos11          10.50    0
pos0Rotated    12.61    0    # pos0 rotated round one revolution
pos0Barcode     0.03    0    # barcode reading position for pos0
pos1Barcode     2.12    0
pos2Barcode     4.22    0
pos3Barcode     6.32    0
pos4Barcode     8.43    0    # Modified by SJ to make barcode readable
pos5Barcode    10.50    0
pos6Barcode   -12.55    0
pos7Barcode   -10.45    0
pos8Barcode    -8.35    0
pos9Barcode    -6.25    0
pos10Barcode   -4.17    0
pos11Barcode   -2.06    0
pos0Load       10.50    0
pos1Load     -12.55    0
pos2Load     -10.45    0
pos3Load       -8.35    0    # loading position for filter in pos0
pos4Load       -6.25    0
pos5Load       -4.17    0
pos6Load       -2.06    0
pos7Load        0.03    0
pos8Load        2.12    0
pos9Load        4.22    0
pos10Load        6.32    0
