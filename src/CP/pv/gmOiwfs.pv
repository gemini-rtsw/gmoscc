#
# Gmos OIWFS setup
#

#
# Set name in SAD (this should be moved into the startup script)
#
string $(top)name = "GMOS-S OIWFS CC";

# Set default deviceControl configuration parameters:
#
#    ACCL  Acceleration (& deceleration) in EGUs/sec/sec 
#          Motors will execute a linear ramp from VBAS to VELO
#          and unless a move is aborted with finish with a linear ramp 
#          down from VELO to VBAS.  See also VBAS, VELO & FIVL.
#    BLCO  Backlash compensation
#    BTMO  Brake status check timeout in 0.1 second units - set to 0 if no 
#          brake. Also used to delay motion after brakes are removed or  
#          delay power-off after brakes are applied (uses timeout instead 
#          status).  See UBSB. 
#    EDBD  Encoder deadband (in counts). Encoder changes within range of 
#          EDBD is considered acceptable noise.  See ERES & UEIP.
#    EGU   Engineering units for target position
#    ERES  Encoder resolution, number of encoder counts per EGU 
#          See also UEIP & EDBD
#    FIVL  Final indexing velocity in EGUs/sec., which is used for the final 
#          critical indexing sequence when home switches are used.
#          Must work out to less than 1024 steps per second when 
#          the OMS VME-8/44 cards are used
#    IALG  Indexing algorithm
#             0 - move without indexing
#             1 - go in the negative direction and index on the home switch 
#             2 - go in the positive direction and index on the home switch
#             3 - index on the centre home switch
#             4 - go negative and index on the lower soft limit switch
#             5 - go positive and index on the upper soft limit switch
#    MDBD  Motion deadband in EGUs, moves within the range of MDBD will 
#          show as completed without moving
#    MRES  Motor resolution, number of steps per EGU
#    MRND  Rounding
#    PHLM  Target position high limit in EGUs
#    PLLM  Target position low limit in EGUs
#    PTMO  Power status check timeout in 0.1 second units, used as a delay
#          before checking power status bit after turning drive on/off
#          See also UPSB & UAPB.
#    UAPB  Use auxilliary power bit (0 | 1), 1 means the AUX power bit will 
#          be used to control the drive enable.  See PTMO & UPSB.
#    UBSB  Use brake status check (0 | 1), 1 means status is used to 
#          indicate when the brakes are applied.
#    UEIP  Use encoder if one is detected (0 | 1), 1 means an encoder will
#          be used to determine current position.  See ERES.
#    UPSB  Use power status check (0 | 1), 1 means that drive enable status
#          is monitored.
#    VBAS  Minimum velocity in EGUs/sec, defines the starting velocity for
#          ramping up to VELO and the ending velocity for ramping down.
#          The OMS VME 8/44 requires that VBAS is greater than zero and
#          less than the programmed velocity and must be set because the 
#          default is zero.  See VELO, FIVL & ACCL.
#    VELO  Target velocity in EGUs/sec, or at least the default at startup
#    VHLM  Velocity high limit in EGUs/sec.  Target velocity (VELO) must
#          be within VLLM & VHLM but not VBAS or FIVL.
#    VLLM  Velocity low limit in EGUs/sec
#
# deviceControl configuration
#
#   Base device
#
group {
   double $(top)probeBasDevice.ACCL =   10.0; # Acceleration
   double $(top)probeBasDevice.BLCO =    0.1; # Backlash compensation
   double $(top)probeBasDevice.EDBD =   20.0; # Encoder deadband
   string $(top)probeBasDevice.EGU  = "Deg."; # Engineering units
   double $(top)probeBasDevice.ERES = 5000.0; #
   double $(top)probeBasDevice.FIVL =    0.5; # final indexing velocity
   long   $(top)probeBasDevice.IALG =      2; # Indexing algorithm
   double $(top)probeBasDevice.MDBD =  0.001; # Motion deadband
   double $(top)probeBasDevice.MRES = 2000.0; # motor steps per EGU
   double $(top)probeBasDevice.PHLM =  180.0; # device level high limit
   double $(top)probeBasDevice.PLLM = -180.0; # device level low limit
   long   $(top)probeBasDevice.UEIP =      1; # use encoder if present
   long   $(top)probeBasDevice.UPSB =      1; # use power status
   double $(top)probeBasDevice.VBAS =    0.1; # base velocity
   double $(top)probeBasDevice.VELO =    1.0; # velocity at startup
   double $(top)probeBasDevice.VHLM =    7.0; # maximum target velocity
   double $(top)probeBasDevice.VLLM =    0.0; # minimum target velocity 
}
#
#   Pickoff device
#
group {
   double $(top)probePkoDevice.ACCL =   10.0; # Acceleration
   double $(top)probePkoDevice.BLCO =   -0.2; # Backlash compensation
   double $(top)probePkoDevice.EDBD =   20.0; # Encoder deadband
   string $(top)probePkoDevice.EGU  =  "Deg.";# Engineering units
   double $(top)probePkoDevice.ERES = 2500.0; # encoder resolution
   double $(top)probePkoDevice.FIVL =    1.0; # final indexing velocity
   long   $(top)probePkoDevice.IALG =      2; # Indexing algorithm
   double $(top)probePkoDevice.MDBD =  0.001; # Motion deadband
   double $(top)probePkoDevice.MRES = 1000.0; # motor steps per EGU
   double $(top)probePkoDevice.PHLM =  180.0; # device level high limit
   double $(top)probePkoDevice.PLLM = -180.0; # device level low limit
   long   $(top)probePkoDevice.UEIP =      1; # use encoder if present
   long   $(top)probePkoDevice.UPSB =      1; # use power status
   double $(top)probePkoDevice.VBAS =    0.1; # base velocity
   double $(top)probePkoDevice.VELO =    1.0; # velocity at startup
   double $(top)probePkoDevice.VHLM =    7.0; # maximum target velocity
   double $(top)probePkoDevice.VLLM =    0.0; # minimum target velocity 
}

# Load patrol area X/Y limits
#
group {
   double $(top)probePatrolXHiLim   =  125.0; # X upper limit
   double $(top)probePatrolXLoLim   =   -7.1; # X lower limit
   double $(top)probePatrolYHiLim   =  133.3; # Y upper limit
   double $(top)probePatrolYLoLim   =  -21.7; # Y lower limit
}

# Buffer between limit and patrol area (mm). This is the tolerance used to
# decide when to activate the software limits. A big number is equivalent
# to disabling the software limits.
#
double $(top)probeLimitCheck.O      = 100.0;

# Load offsets for converting X/Y to angles and vice versa
#
group {

   #
   # Base and pickoff angles
   #
   #double $(top)probeBasOffset     = 175.175659; # Base offset angle
   #double $(top)probePkoOffset     = -13.080748; # Pickoff offset angle
   # New values added 30/Dec/04 PG
   #double $(top)probeBasOffset     = 176.157; # Base offset angle
   # New base angle value 17/Aug/06 PG
   #double $(top)probeBasOffset     = 176.157; # Base offset angle
   #double $(top)probePkoOffset     = -13.481; # Pickoff offset angle
   # New angles 19/Feb/07 PG
   #double $(top)probeBasOffset      = 175.313; # Base offset angle
   #double $(top)probePkoOffset      = -13.251; # Pickoff offset angle
   # New angles 03/Aug/07 PG (CR 1180)
   #double $(top)probeBasOffset      = 176.687; # Base offset angle
   #double $(top)probePkoOffset      = -13.200; # Pickoff offset angle
   # New angles 05/Oct/07 PG (CR 1212) 
   double $(top)probeBasOffset      = 177.655; # Base offset angle
   double $(top)probePkoOffset      = -13.026; # Pickoff offset angle
   # New angles 17/Oct/07 (not in use yet)
   #double $(top)probeBasOffset      = 177.038; # Base offset angle
   #double $(top)probePkoOffset      = -12.071; # Pickoff offset angle


   #
   # X,Y offsets
   #
   #double $(top)probeXOffset       =  -2.025; # X offset
   #double $(top)probeYOffset       =   3.578; # Y offset
   #double $(top)probeXOffset       =  -1.192702; # X offset
   #double $(top)probeYOffset       =   1.298186; # Y offset
   #double $(top)probeXOffset       =  -2.025; # X offset
   #double $(top)probeYOffset       =   3.578; # Y offset
   # New offsets 09/Feb/07 PG
   #double $(top)probeXOffset       =  -1.9; # X offset
   #double $(top)probeYOffset       =   0.2; # Y offset
   #double $(top)probeXOffset       =  -3.26; # X offset
   #double $(top)probeYOffset       =   8.65; # Y offset
   # New offsets 19/Feb/07 PG
   #double $(top)probeXOffset        =  -2.036; # X offset
   #double $(top)probeYOffset        =   6.574; # Y offset
   # New offsets 03/Aug/07 PG (CR 1180)
   #double $(top)probeXOffset        =  -0.229; # X offset
   #double $(top)probeYOffset        =   2.305; # Y offset
   # New offsets 05/Oct/07 PG (CR 1212)
   double $(top)probeXOffset        =  -0.505; # X offset
   double $(top)probeYOffset        =   2.066; # Y offset
   # New offsets 17/Oct/07 (not in use yet)
   #double $(top)probeXOffset        =  -1.593; # X offset
   #double $(top)probeYOffset        =   2.688; # Y offset

   # Ideal Focal Surface
   #
   # On-axis distance between slit plane and probe tip
   #
   double $(top)probeZOffset        =  75.0;  # Z-offset
}

# Load offsets for zeroing absolute encoders to be similar to 
# incremental encoder index points.  Absolute encoder angles displayed are
# calculated by offsetting the actual angles (zero when horizontal) by the 
# following values:
#
group {
   #double $(top)probeBaseZero       =  -5.8;
   #double $(top)probePickoffZero    = -13.6;
   # New offsets 03/Aug/07 PG (CR 1180)
   double $(top)probeBaseZero       =  -4.0;
   double $(top)probePickoffZero    = -16.3;
}

# Sin/cos output corrections.  EGUL and EGUF determine the high and low 
# scales of the input conversion.  If EGUL and EGUF are -1 and 1 respectively
# the range read from the record will be +/- 1 EGUs in spite of the fact that
# the output of the analog card is +/- 5 volts.  In this case these values are
# used to correct for full scale sin and cos values.
#
group {
   double $(top)probeCosBas.EGUL    = -1.0;
   double $(top)probeCosBas.EGUF    =  1.0;
   double $(top)probeSinBas.EGUL    = -1.0;
   double $(top)probeSinBas.EGUF    =  1.0;
   double $(top)probeCosPko.EGUL    = -1.0;
   double $(top)probeCosPko.EGUF    =  1.0;
   double $(top)probeSinPko.EGUL    = -1.0;
   double $(top)probeSinPko.EGUF    =  1.0;
}

# Probe Map Correction Coefficients

group {
    double $(top)probeMap.A	=  0.00000;	# A0
    double $(top)probeMap.B	=  1.00000;	# A1
    double $(top)probeMap.C	=  0.00000;	# A2
    double $(top)probeMap.D	=  0.00000;	# A3
    double $(top)probeMap.E	=  0.00000;	# A4
    double $(top)probeMap.F	=  0.00000;	# A5
    double $(top)probeMap.G	=  0.00000;	# B0
    double $(top)probeMap.H	=  0.00000;	# B1
    double $(top)probeMap.I	=  0.00000;	# B2
    double $(top)probeMap.J	=  1.00000;	# B3
    double $(top)probeMap.K	=  0.00000;	# B4
    double $(top)probeMap.L	=  0.00000;	# B5
}

# Pre-load engineering targets
#
group {
   double $(top)probeMoveX1Target    = 125.0;
   double $(top)probeMoveY1Target    = 133.3;
}
group {
   double $(top)probeMoveX2Target    = 125.0;
   double $(top)probeMoveY2Target    = -21.7;
}
group {
   double $(top)probeMoveX3Target    =  -7.1;
   double $(top)probeMoveY3Target    = -21.7;
}

# assemblyControl attribute limits, which may or may not be the
# same as the "probePatrol*Lim" X/Y limit settings
#
#   X limits
#
group {
   double $(top)probeAssembly.AALL   =  -7.1;  # X low
   double $(top)probeAssembly.AAHL   = 125.0;  # X high
#
#   Y limits
#
   double $(top)probeAssembly.ABLL   = -21.7;  # Y low
   double $(top)probeAssembly.ABHL   = 133.3;  # Y high
#
#   Base & Pickoff velocity limits
#   (code does not actually check or enforce these limits)
#
   double $(top)probeAssembly.ADLL   =   0.5;  # bas/pko low max velocity 
   double $(top)probeAssembly.ADHL   =   5.0;  # bas/pko high max velocity

#
#   Base & Pickoff velocity
#
   double $(top)probeAssembly.D      =   2.0;  # bas/pko max velocity
}

#
# Set TCS interface defaults
#
#  preload debug CAD
#
long   $(top)debugMode.VAL        =       1;  # Debug level of NONE
string $(top)debug.A              =  "NONE";  # Debug level of NONE
long   $(top)debug.DIR            =       0;  # MARK directive
long   $(top)debug.DIR            =       3;  # START directive - set debugging mode now
#
#  preload move CAD
#
double $(top)move.A               =   0.0;  # default X position
double $(top)move.B               =   0.0;  # default Y position
long   $(top)move.DIR             =     0;  # MARK directive
#
#  preload tolerance CAD
#
string $(top)tolerance.A          =  "1.25" ;  # default X/Y tolerance
string $(top)tolerance.B          =  "0" ;  # default Z tolerance
string $(top)tolerance.C          =  "0.05" ;  # X/Y tolerance low limit
string $(top)tolerance.D          = "10" ;  # X/Y tolerance high limit
long   $(top)tolerance.DIR        =   0  ;  # MARK directive
double $(top)followA.I            =  1.25;  # preload tolerance followA 
long   $(top)followA.K            =   0  ;  # electronic offsets disabled
#
#  preload followState
# 
long   $(top)followState          =     0;  # STOP following
#
# preload TCS Simulator defaults
#
group {
   double $(top)tcsSimulator.A       =  50.0;  # X origin
   double $(top)tcsSimulator.B       =  50.0;  # Y origin
   double $(top)tcsSimulator.C       = 500.0;  # period in seconds
   double $(top)tcsSimulator.D       =  25.0;  # radius
}
#
# Disable the TCS simulator. It needs to be switched on for testing
# without the TCS.
#
long $(top)tcsSimulator.DISA       =  1;
