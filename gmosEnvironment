#
#+
#  Name:
#     gmosEnvironment

#  Purpose:
#     Define the environment variables needed for running the GMOS software

#  Language:
#     csh

#  Type of Module:
#     Resource file.

#  Invocation:
#     source gmosEnvironment

#  Arguments:
#     None.

#  Description:
#     This C shell script is executed from .login and defines all the
#     GMOS-specific environment variables.


#  Authors:
#     SMB: Steven Beard      (smb@roe.ac.uk)

#  History:
#     11-May-1999 (SMB):
#        Original version extracted from GMOS .login script.
#     01-Mar-2001: (SMB):
#        Moved to GMOS software release. UKATC specific things removed.
#     11-Apr-1901: (SMB)
#        Modified for use at Gemini Northern Operations Centre, Hilo.
#        echo commands removed - it upset applSetup.
#-


#
# ------------------------------------------------------------------------
#      LOCATION OF DIRECTORIES AND LATEST VERSIONS OF SOFTWARE
# ------------------------------------------------------------------------
#

# Define the location of the GMOS_EPICS, GMOS_DEV, GMOS_OP, GMOS_EXP,
# GMOS_DC and GMOS_HOME directories

setenv GMOS_EPICS   /home/smb/gmos/source
setenv GMOS_DEV     ${GMOS_EPICS}
setenv GMOS_OP      ${GMOS_EPICS}
setenv GMOS_EXP     ${GMOS_EPICS}
setenv GMOS_HOME    /home/smb/gmos
#setenv GMOS_TCS     /net/alba/sw3/gemini/tcs/cjm/tcs

# Current versions of GMOS software and detector controller software

setenv GMOS_DC      /gemini/gmosdc/gmosdc
setenv GMOS_VERSION gmos022

# Add the most up to date version of the GMOS software to the PATH
# It is assumed that the "gmos" soft link points to ${GMOS_VERSION}

setenv PATH ${GMOS_OP}/gmos:${GMOS_OP}/gmos/bin/solaris:${PATH}

# Set up environment variables for location of Gemini libraries if they 
# exist.
#

if ( -e /gemini ) then

    setenv GEMINI_LIB		/gemini
    setenv GEMINI_SLALIB	${GEMINI_LIB}/slalib
    setenv GEMINI_TIMELIB	${GEMINI_LIB}/timelib
    setenv GEMINI_ASTLIB	${GEMINI_LIB}/astlib
    setenv GEMINI_CFITSIO	${GEMINI_LIB}/cfitsio
    setenv GEMINI_DHS		${GEMINI_LIB}/dhs
else

    echo "*** Gemini library directories not found."
endif

#
# ------------------------------------------------------------------------
#      DEFINITIONS NEEDED BY THE dhsTestCmdr TEST SCRIPTS
# ------------------------------------------------------------------------
#

# Add the "." and "./scripts" directories to the PATH so that dhsTestCmdr can
# pick up its test scripts.

setenv PATH .:./scripts:${PATH}

# Define the default configuration directory for the dhsTestCmdr

setenv DEFAULT_CONFIG_DIR ./configFiles

# Define the version of Tcl required by the dhsTestCmdr
# and add it to the PATH and LD_LIBRARY_PATH

#setenv TCL_LIBRARY /net/alba/sw3/seg/tcl-7.6.2/lib/tcl7.6
setenv TCL_LIBRARY /usr/local/lib/tcl7.6

#setenv TK_LIBRARY  /net/alba/sw3/seg/tcl-7.6.2/lib/tk4.2
setenv TK_LIBRARY  /usr/local/lib/tk4.2

#setenv PATH /net/alba/sw3/seg/tcl-7.6.2/bin:${PATH}

if ( ${?LD_LIBRARY_PATH} ) then
      setenv LD_LIBRARY_PATH /usr/local/lib:${LD_LIBRARY_PATH}
else
      setenv LD_LIBRARY_PATH /usr/local/lib
endif

#
# ------------------------------------------------------------------------
#      DEFINITIONS FOR CAPFAST AND EPICS
# ------------------------------------------------------------------------
#

#
# Set up default display path for edd and dm.
#
if ( ${?EPICS_DISPLAY_PATH} ) then
      setenv EPICS_DISPLAY_PATH .:./data:${EPICS_DISPLAY_PATH}
else
      setenv EPICS_DISPLAY_PATH .:./data
endif

#
# ------------------------------------------------------------------------
#      MISCELLANEOUS DEFINITIONS AND WELCOME MESSAGE
# ------------------------------------------------------------------------
#

# Define the default editor for the gmos account (useful editors are ones
# which run in their own window - emacs and textedit are good, pico and vi
# are not recommended).

setenv GMOS_EDITOR textedit

#echo ""
#echo "Type 'gmosStartMK' to start the ${GMOS_VERSION} software."
#echo ""
