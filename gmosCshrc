#
# ------------------------------------------------------------------------
#      LOCATION OF DIRECTORIES AND LATEST VERSIONS OF GMOS SOFTWARE
# ------------------------------------------------------------------------
#

# Define the location of the operational and development directories
# and the location of the GMOS detector controller software.

setenv GMOS_OP      /gemini/gmos/gmos
setenv GMOS_DEV     /home/gemvx/gmos/gmos
setenv GMOS_DC      /gemini/gmosdc/gmosdc

# Add the GMOS solaris binary directories to the PATH

setenv PATH ${PATH}:${GMOS_OP}/bin/solaris:${GMOS_DC}/bin/solaris

# Add the GMOS data directories to the search path for edd and dm.

if ( ${?EPICS_DISPLAY_PATH} ) then
      setenv EPICS_DISPLAY_PATH ${EPICS_DISPLAY_PATH}:${GMOS_OP}/data:${GMOS_DC}/data
else
      setenv EPICS_DISPLAY_PATH .:./data:${GMOS_OP}/data:${GMOS_DC}/data
endif

#
# ------------------------------------------------------------------------
#      DEFINITIONS NEEDED BY THE dhsTestCmdr TEST SCRIPTS
# ------------------------------------------------------------------------
#

# Add the "./scripts" directories to the PATH so that dhsTestCmdr can
# pick up its test scripts. (It is assumed that "." is already in the PATH).

setenv PATH ${PATH}:./scripts

# Define the default configuration directory for the dhsTestCmdr

setenv DEFAULT_CONFIG_DIR ./configFiles

# Define the version of Tcl required by the dhsTestCmdr
# and add it to the PATH and LD_LIBRARY_PATH

setenv TCL_LIBRARY /usr/local/lib/tcl7.6
setenv TK_LIBRARY  /usr/local/lib/tk4.2

if ( ${?LD_LIBRARY_PATH} ) then
      setenv LD_LIBRARY_PATH /usr/local/lib:${LD_LIBRARY_PATH}
else
      setenv LD_LIBRARY_PATH /usr/local/lib
endif

# Define device initialisation command aliases

if ( -e ${GMOS_OP}/bin/solaris/gmosSetResetAliases ) then
   source ${GMOS_OP}/bin/solaris/gmosSetResetAliases
endif

#
# ------------------------------------------------------------------------
#      MISCELLANEOUS DEFINITIONS
# ------------------------------------------------------------------------
#

# Define the default editor for the gmos account (useful editors are ones
# which run in their own window - emacs and textedit are good, pico and vi
# are not recommended).

setenv GMOS_EDITOR textedit

#
# ------------------------------------------------------------------------
#      ALIASES FOR ACCESS CONTROL AND SAFETY COMMANDS
# ------------------------------------------------------------------------
#

# Define the commands to make access to the GMOS MK and CP hardware explicit
# rather than accidental.

alias gmosMK   'setenv   GMOS_MK_ACCESS && set prompt = "`uname -n` (GMOS MK)% " && echo "You are now set up for control of GMOS MK hardware"'
alias gmosNoMK 'unsetenv GMOS_MK_ACCESS && set prompt = "`uname -n`% " && echo "You are no longer set up for control of GMOS MK hardware"'
alias gmosCP   'setenv   GMOS_CP_ACCESS && set prompt = "`uname -n` (GMOS CP)% " && echo "You are now set up for control of GMOS CP hardware"'
alias gmosNoCP 'unsetenv GMOS_CP_ACCESS && set prompt = "`uname -n`% " && echo "You are no longer set up for control of GMOS CP hardware"'

