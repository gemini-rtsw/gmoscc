# FILENAME
# --------
# local.vws
#
# DESCRIPTION
# -----------
# VxWorks script containing site-specific information for ROE - GMOS VERSION
#
# DEPENDENCIES
# ------------
# Assumes that the VxWorks boot script executes this file first.
#
# INVOCATION
# ----------
# Invoked from the VxWorks boot script with "<$(version)/bin/$(arch)/local"
#
# AUTHORS
# -------
# Andy Foster   (ajf@ast.cam.ac.uk)
# Steven Beard  (smb@roe.ac.uk)
#-

# Change default network router to the ROE firewall
routeAdd ("0", "195.194.120.254")
#routeShow

# Add useful hosts to network address table
hostAdd ("alba", "195.194.120.7")
hostAdd ("cava", "195.194.120.24")
hostAdd ("rona", "195.194.120.120")
hostAdd ("pebbles", "195.194.120.125")
hostAdd ("scalpay", "195.194.120.121")
#hostAdd ("fetlar", "195.194.120.27")
#hostShow

# Login stuff: Add the GMOS username for vxWorks security
loginUserAdd "gmos", "cQS9ySy9R"

# Mount the /sw2, /sw3, /gemini and /sw4 directories exported from alba
# (Commented out for now, since problems can arise if these commands
# are accidentally executed twice with conflicting parameters).
nfsAuthUnixSet ("alba", 821, 100, 0, 0)
nfsMount ("alba", "/sw2", "/sw2")
nfsMount ("alba", "/sw3", "/sw3")
nfsMount ("alba", "/sw3/gemini", "/gemini")
#nfsMount ("alba", "/sw4", "/sw4")
#nfsDevShow
#nfsAuthUnixShow

cd "$(iocpath)"
