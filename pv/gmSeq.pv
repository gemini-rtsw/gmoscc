#
# gmSeq.pv
#
# pvload parameter definition file for GMOS instrument sequencer
#
# This file sets up the permanent parameters for the instrument
# sequencer. It should not need to be edited.
#
# Set the initial debugging mode to NONE
# and clear the "IS only" flag.
#
group {
   string $(top)debug.A       = "NONE" ;
   string $(top)debug.B       = "0" ;
}
long   $(top)debugMenu.VAL = 1;
string $(top)debug.DIR     = "CLEAR" ;
#
# Initialise the default grating selection parameters.
#
string $(top)grSelect.A = "WLEN" ;
string $(top)grSelect.D = "1" ;
string $(top)grSelect.DIR = "CLEAR" ;
#
# Initialise names of mask, filter and grating lookup tables
#
string $(top)dirLUT.VAL          = "/home/smb/gmos/lut" ;
group {
   string $(top)mskNamesLUT.VAL  = "masks.lut" ;
   string $(top)mskLUT.VAL       = "msk.lut" ;
}
group {
   string $(top)fltNamesLUT.VAL  = "filters.lut" ;
   string $(top)fltLUT.VAL       = "flt.lut" ;
}
group {
   string $(top)grNamesLUT.VAL   = "gratings.lut" ;
   string $(top)grLUT.VAL        = "gr.lut" ;
}
#
#  Initialise filter and grating names in SAD:
#  The fields set here are output to the SIR records
#
   string $(top)fltPos.VALG   = "unknown" ;
   string $(top)fltPos.VALH   = "unknown" ;
   string $(top)grSelect.VALD = "unknown" ;





