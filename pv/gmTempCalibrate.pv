#
# GMOS temperature sensor calibration coefficients
#
#
# The GMOS temperature sensors generate a voltage which is translated
# by the analogue to digital convertors into a raw digital signal,
# RVAL, in the range RMIN=0 to RMAX=2048. The signal is converted to
# temperature with the aid of four coefficients:
#
# ASLO - Multiplication factor used to scale raw digital signal
# AOFF - Offset added to scaled raw digital signal
# EGUL - Temperature corresponding to RMIN
# EGUF - Temperature corresponding to RMAX
#
# The temperature, VAL, is calculated using
#
#    VAL = (RVAL*ASLO + AOFF)*ESLO + EGUL
#
# where
#
#    ESLO = (EGUF-EGUL)/(RMAX-RMIN)
#
# Normally, AOFF and ASLO are left at their default values of 0.0 and
# 1.0 and the temperatures are calibrated by setting EGUL and EGUF.
#
# SMOO defines a smoothing factor to reduce the noise in the readings.
# SMOO ranges from 0.0 (no smoothing) to 1.0 (constant value).
#
# Alarms are generated as follows:
# Temperature or temperature change below LOLO - MAJOR ALARM
# Temperature or temperature change between LOLO and LOW - MINOR ALARM
# Temperature or temperature change between LOW and HIGH - NO ALARM
# Temperature or temperature change between HIGH and HIHI - MINOR ALARM
# Temperature or temperature change above HIHI - MAJOR ALARM

#
# Temperature sensor 0 (FOSS/ISS)
#
group {
   double $(top)temp0.EGUL =  40.0;
   double $(top)temp0.EGUF = -60.0;
   double $(top)temp0.LOLO = -10.0;
   double $(top)temp0.LOW  =  -8.0;
   double $(top)temp0.HIGH =  25.0;
   double $(top)temp0.HIHI =  35.0;
   double $(top)temp0.SMOO =   0.5;
}
group {
   double $(top)tempChange0.LOLO = -1.0;
   double $(top)tempChange0.LOW  = -0.25;
   double $(top)tempChange0.HIGH =  0.25;
   double $(top)tempChange0.HIHI =  1.0;
}
#
# Use this field to disable a faulty temperature sensor
# (0=enable, 1=disable).
#
long $(top)temp0disable.VAL = 1;

#
# Temperature sensor 1 (WFS CCD controller case)
#
group {
   double $(top)temp1.EGUL =  40.0;
   double $(top)temp1.EGUF = -60.0;
   double $(top)temp1.LOLO = -10.0;
   double $(top)temp1.LOW  =  -8.0;
   double $(top)temp1.HIGH =  25.0;
   double $(top)temp1.HIHI =  35.0;
   double $(top)temp1.SMOO =   0.5;
}
group {
   double $(top)tempChange1.LOLO = -2.0;
   double $(top)tempChange1.LOW  = -0.5;
   double $(top)tempChange1.HIGH =  0.5;
   double $(top)tempChange1.HIHI =  2.0;
}
#
# Use this field to disable a faulty temperature sensor
# (0=enable, 1=disable).
#
long $(top)temp1disable.VAL = 0;

