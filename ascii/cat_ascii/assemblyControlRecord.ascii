"Out Attr B"               VALB    SPC_DBADDR  ASL0    DBF_NOACCESS    NO  1   4   void *valb;
"Out Attr C"               VALC    SPC_DBADDR  ASL0    DBF_NOACCESS    NO  1   4   void *valc;
"Out Attr D"               VALD    SPC_DBADDR  ASL0    DBF_NOACCESS    NO  1   4   void *vald;
"Out Attr E"               VALE    SPC_DBADDR  ASL0    DBF_NOACCESS    NO  1   4   void *vale;
!
