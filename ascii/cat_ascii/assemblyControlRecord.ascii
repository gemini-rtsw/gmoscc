#include <dbDefs.h>
#include <dbRecDes.h>
#include <dbFldTypes.h>
#include <special.h>
#include <choiceGbl.h>
#include <choiceAssemblyControl.h>
#define INCdbAssRecDesh
!
RECTYP "assemblyControl"
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! Prompt:     string for db config tools
! name    :     field name
! special :    if specific then special processing is required for this field at run time.
! access :     Acc. Security Level, ASO=operator normally change, all others AS1
! field_type
! pp    :     Should a passive record be processed when Channel Access write to this field? Default NO
! interest :     Only used by the dbpr shellcommand
! init    :     Initial Value
! size    :     Must be specificed for DBF_STRING fields
! pmt    :     Guessing that its prompt group
!
! special is one of {NULL, SPC_NOMOD, SPC_DBADDR, SPC_SCAN, SPC_MOD, SPC_RESET, SPC_LINCONV, SPC_CALC}
! Where SPC_MOD means execute special() if it changes, and SPC_NOMOD means noone can modify it except
! record or support code.
! DBF_int    means any of {DBF_UCHAR, DBF_SHORT, DBF_LONG, DBF_ULONG}
! DBF_float    means any of {DBF_FLOAT, DBF_DOUBLE}
! DBF_link    means any of {DBF_INLINK, DBF_OUTLINK, DBF_FWDLINK}
!
! Prompt                   name    special     access  DBF_STRING      pp  int siz                         pmt
! Prompt                   name    special     access  DBF_int         pp  int ini                         pmt range1      range2      cvt_type
! Prompt                   name    special     access  DBF_float       pp  int ini                         pmt range1      range2
! Prompt                   name    special     access  DBF_ENUM        pp  int ini                         pmt range1      range2
! Prompt                   name    special     access  DBF_GBLCHOICE   pp  int ini choice_set              pmt
! Prompt                   name    special     access  DBF_RECCHOICE   pp  int ini choice_set              pmt
! Prompt                   name    special     access  DBF_CVTCHOICE   pp  int ini                         pmt
! Prompt                   name    special     access  DBF_link        pp  int                             pmt range1      range2      conversion
! Prompt                   name    special     access  DBF_NOACCESS    pp  int siz code
!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! MAIN CONTROL FIELDS
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
"Directive"                DIR     NULL        ASL1    DBF_RECCHOICE   YES 1   0   DAR_ASSCONTROL_DIR      0
"Operating Mode"           MODE    SPC_MOD     ASL1    DBF_RECCHOICE   NO  1   0   DAR_ASSCONTROL_MODE     1
"Directive Response"       VAL     NULL        ASL1    DBF_LONG        NO  1   0                           0   CON 0       CON 1e30    CT_DECIMAL
"Interlock"                ILCK    SPC_MOD     ASL1    DBF_SHORT       NO  1   0                           0   CON 0       CON 20      CT_DECIMAL
!
! COMMAND STATUS INFORMATION
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
"Device Action State"      BUSY    NULL        ASL1    DBF_RECCHOICE   NO  0   0   DAR_ASSCONTROL_BUSY     0   CON 0       CON 1e30    CT_DECIMAL
"Assembly Rec State"       ASTA    NULL        ASL1    DBF_RECCHOICE   NO  0   0   DAR_ASSCONTROL_STATE    0   CON 0       CON 1e30    CT_DECIMAL
"Error Message"            MESS    NULL        ASL1    DBF_STRING      NO  0   40                          0
"Health"                   HLTH    NULL        ASL1    DBF_RECCHOICE   NO  1   0   DAR_ASSCONTROL_HLTH     1
"Is it Indexed"            INDX    NULL        ASL1    DBF_SHORT       NO  1   0                           1   CON 0       CON 20      CT_DECIMAL
"Is it Initialized"        INIT    NULL        ASL1    DBF_SHORT       NO  1   0                           1   CON 0       CON 20      CT_DECIMAL
"Is it Parked"             PARK    NULL        ASL1    DBF_SHORT       NO  1   0                           1   CON 0       CON 20      CT_DECIMAL
"Is Record Preset?"        MARK    0           ASL1    DBF_SHORT       NO  1   0                           0   0
!
! OPERATING MODE FIELDS
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
"Simulation Mode"          SIMM    NULL        ASL1    DBF_RECCHOICE   NO  1   0   DAR_ASSCONTROL_SIM      1
"Debug Mode"               DBUG    NULL        ASL1    DBF_RECCHOICE   NO  1   0   DAR_ASSCONTROL_DBUG     1
"Translation Directory"    TDIR    NULL        ASL1    DBF_STRING      NO  1   40                          1
"Translation File"         TFIL    NULL        ASL1    DBF_STRING      NO  1   40                          1
!
! LINK SUPPORT
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
"Error Message Link"       MSGL    SPC_NOMOD   ASL1    DBF_OUTLINK     NO  1                               1
"Simulation Mode Link"     SIML    SPC_NOMOD   ASL1    DBF_OUTLINK     NO  1                               1
"Debug Mode Link"          DBGL    SPC_NOMOD   ASL1    DBF_OUTLINK     NO  1                               1
"Busy Link"                BSYL    SPC_NOMOD   ASL1    DBF_OUTLINK     NO  1                               1
!
! INTERNAL STATUS INFORMATION
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
"Display Precision"        PREC    NULL        ASL1    DBF_SHORT       NO  1   0                           1   CON 0       CON 20      CT_DECIMAL
"Engineering Units"        EGU     NULL        ASL1    DBF_STRING      NO  1   16                          1
"Code Version"             VERS    NULL        ASL1    DBF_STRING      NO  1   16                          1
"Post process command"     PP      NULL        ASL1    DBF_SHORT       NO  2   0                           0   CON 0       CON 1e9     CT_DECIMAL
"Lookup Table Head Ptr"    LTHP    SPC_NOMOD   ASL1    DBF_NOACCESS    NO  1   4   void *lthp;
"Total devices attached"   NMDV    NULL        ASL1    DBF_SHORT       NO  2   0                           0   CON 0       CON 1e9     CT_DECIMAL
!
! INTERNAL DEADBAND DEFINITIONS
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
"Monitor Deadband"         MDEL    NULL        ASL1    DBF_FLOAT       NO  3   0                           1   CON -1e30   CON 1e30 
"Archive Deadband"         ADEL    NULL        ASL1    DBF_FLOAT       NO  3   0                           1   CON -1e30   CON 1e30 
"Monitor Mask"             MMAP    NULL        ASL1    DBF_ULONG       NO  3   0                           0   CON 0       CON 1e9     CT_DECIMAL
"Link Trigger Mask"        LMAP    NULL        ASL1    DBF_ULONG       NO  3   0                           0   CON 0       CON 1e9     CT_DECIMAL
!
! ALARM STUFF
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
"Hihi Alarm Limit"         HIHI    NULL        ASL1    DBF_FLOAT       YES 2   0                           1   VAR HIGH    CON 1e30 
"Lolo Alarm Limit"         LOLO    NULL        ASL1    DBF_FLOAT       YES 2   0                           1   CON -1e30   VAR LOW
"High Alarm Limit"         HIGH    NULL        ASL1    DBF_FLOAT       YES 2   0                           1   VAR LOW     VAR HIHI
"Low Alarm Limit"          LOW     NULL        ASL1    DBF_FLOAT       YES 2   0                           1   VAR LOLO    VAR HIGH
"Hihi Severity"            HHSV    NULL        ASL1    DBF_GBLCHOICE   YES 2   0   GBL_ALARM_SEV           1   VAR HSV     CON 4
"Lolo Severity"            LLSV    NULL        ASL1    DBF_GBLCHOICE   YES 2   0   GBL_ALARM_SEV           1   VAR LSV     CON 4
"High Severity"            HSV     NULL        ASL1    DBF_GBLCHOICE   YES 2   0   GBL_ALARM_SEV           1   CON 0       VAR HHSV
"Low Severity"             LSV     NULL        ASL1    DBF_GBLCHOICE   YES 2   0   GBL_ALARM_SEV           1   CON 0       VAR LLSV
"HW Limit Violation Svr"   HLSV    NULL        ASL1    DBF_GBLCHOICE   YES 2   0   GBL_ALARM_SEV           1   CON 0       CON 4
!
!! New ones I added
!
