!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
"Attribute A"              A       SPC_DBADDR  ASL0    DBF_NOACCESS    NO  1   4   void *a;
"Attribute B"              B       SPC_DBADDR  ASL0    DBF_NOACCESS    NO  1   4   void *b;
