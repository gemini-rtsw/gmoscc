#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:
#
# DESCRIPTION:  Loads the GMOS Components Controller database.
#
#

# Make delete key work for backspace
tyBackspaceSet 0177

# Set the shell prompt
shellPromptSet "GMOS-N - sim > "
loginStringSet "MVME167 vxWorks (GMOS-N - sim)\n\nlogin: "

# cd to application install directory (beware automounter problems)
cd "/gemini/GEM8.6/gmos/gmos"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
# (Commented out, since already done in startup_MINIMAL)
# < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/local

# Load EPICS core and record stuff
ld < /gemini/external/GEM8.6/base/bin/$(arch)/iocCore

# Add this for pvload
ld < /gemini/external/GEM8.6/extensions/bin/$(arch)/pvload

# If using state programs, load the sequencer
ld < /gemini/external/GEM8.6/base/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records. It is assumed that Gemini
# libraries are available in the standard /gemini directory).

ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gemini.Support

ld < /gemini/GEM8.6/slalib/slalib/bin/$(arch)/slalib
ld < /gemini/GEM8.6/timelib/timelib/bin/$(arch)/timelib
ld < /gemini/GEM8.6/astlib/astlib/bin/$(arch)/astlib
ld < /gemini/GEM8.6/timelib/timelib/bin/$(arch)/timeSeq

ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/deviceControlLib.a
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmosLib.a
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/assemblyControlLib.a
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmSeqLib.a

# Load sequences here
ld </gemini/GEM8.6/timelib/timelib/bin/$(arch)/timeSeq 

ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/assemblyCar
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/dtaAssemblyCar
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/systemCar
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/commandCar
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/lifterSim


# Initialise the Gemini Time System (1=master, 1=simulate, intPerSecond, intPerTick, timeOffset)
timeClockInit 0, 1, 60, 1, 0

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

# Put the barcode reading software into simulation mode
devBarcodeSimulate = 3


# Load one or more ASCII databases
dbLoadDatabase "/gemini/GEM8.6/gmos/gmos/dbd/gemini.dbd"
dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/gmosCcTopSS.db"
dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/gmosCcSadTopSS.db"
dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/gmSeqTopSS.db"
dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/gmSeqSadTopSS.db"

# This turns off logging
# iocLogDisable=1

iocInit "/gemini/GEM8.6/gmos/gmos/data/resource.def"

#Wait for 5 seconds
taskDelay(300)

# Ensure master enable is disabled while startup script executes
dbpf "g7:cc:msEnableEnable","0"

dbpf "g7:sad:cc:historyLog","Booting..."

#Define the database name
dbpf "g7:sad:name.VAL","GMOS-N (simulated) (@VERSION@)"
dbpf "g7:sad:cc:name.VAL","GMOS-N (@VERSION@) - simulated"

# Load initialization files
pvload "/gemini/GEM8.6/gmos/gmos/data/gmosCcSim.pv","top=g7:, sadtop=g7:sad:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmOiwfsSim.pv","top=g7:wfs:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmMaskSim.pv","top=g7:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmFilterSim.pv","top=g7:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmGratingSim.pv","top=g7:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmTranslationSim.pv","top=g7:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmTempCalibrate.pv","top=g7:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmSeqSim.pv","top=g7:, sadtop=g7:sad:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmSeqTracking.pv","top=g7:, sadtop=g7:sad:"

# Start sequences
seq &timeSeq, "sys=g7:cc:"

seq &assemblyCar, "top=g7:cc:, dev=msk, priority=75"
seq &assemblyCar, "top=g7:, dev=wfs:probe, priority=75"
seq &commandCar, "top=g7:, dev=wfs:, priority=75"
seq &assemblyCar, "top=g7:cc:, dev=flt, priority=75"
seq &assemblyCar, "top=g7:cc:, dev=gr, priority=75"


seq &lifterSim,   "top=g7:cc:, dev=gr, priority=75"
seq &dtaAssemblyCar, "top=g7:, dev=dta, priority=75"
seq &systemCar,   "top=g7:cc:, cad=init, priority=75"
seq &systemCar,   "top=g7:cc:, cad=test, priority=75"
seq &systemCar,   "top=g7:cc:, cad=datum, priority=75"
seq &systemCar,   "top=g7:cc:, cad=update, priority=75"
seq &systemCar,   "top=g7:cc:, cad=park, priority=75"

# Wait while the database initialises and sequences start.
taskDelay(300)

# Trigger the initialisation of the instrument sequencer and components
# controller, disabling initdcCadMark and avoiding the use of the top level
# apply record to prevent the detector controller being initialised.
dbpf "g7:initdcCadMark.DISA", "1"
dbpf "g7:init.DIR", "0"
dbpf "g7:init.DIR", "3"
# An extra components controller start is needed.
dbpf "g7:cc:init.DIR", "0"
dbpf "g7:cc:apply.DIR", "3"

# Wait while the filter, grating and mask data are read, cc inits.
taskDelay(300)

dbpf "g7:initdcCadMark.DISA", "0"

dbpf "g7:sad:cc:historyLog","Master enable switched on"

# Enable master enable on completion of startup script
dbpf "g7:cc:msEnableEnable","1"

# Finally, display the startup time in UTC.
timePrint "UTC"
