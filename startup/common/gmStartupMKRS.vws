#
# VxWorks startup script to load and execute system (iocCore) software.
#
# DESCRIPTION:  Loads the GMOS Components Controller and Instrument Sequencer
# databases.
#
#

# Make delete key work for backspace
tyBackspaceSet 0177

# Set the shell prompt
shellPromptSet "GMOS - sim post f/p > "
loginStringSet "MVME167 vxWorks (GMOS - sim post f/p)\n\nlogin: "

# cd to application install directory (beware automounter problems)
cd "/gemini/GEM8.6/gmos/gmos"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
# (Commented out, since already done in startup_MINIMAL)
# < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/local

# Load EPICS core and record stuff
ld < $(base)/bin/$(arch)/iocCore
ld < $(base)/bin/$(arch)/drvSup
ld < $(base)/bin/$(arch)/recSup
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/recApply.o
ld < $(base)/bin/$(arch)/devSup
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devApplyLocal.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devApplyRemote.o

# Add this for pvload
ld < $(base)/../extensions/bin/$(arch)/pvload

# If using state programs, load the sequencer
ld < $(base)/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records. It is assumed that Gemini
# libraries are available in the standard /gemini directory).

ld < /gemini/slalib/bin/$(arch)/slalib
ld < /gemini/timelib/bin/$(arch)/timelib
ld < /gemini/astlib/bin/$(arch)/astlib

ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/drvOmsVme.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devDeviceControl.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devBarcode.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/recAssControl.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/recDeviceControl.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmosGensubLib.o

ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmMaskGenSubs.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devMaskControl.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmOiwfsCalc.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmOiwfsGenSubs.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmOiwfsCadSupport.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/tcs_simulator.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devOiwfsControl.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devAtmdcControl.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devFilterAss.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmosLutLib.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devGratingAss.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/lifter.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/devTranslationAss.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmosCcCadLib.o

ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gmSeqAppl

# Load sequences here
ld < /gemini/timelib/bin/mv167/timeSeq

ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/assemblyCar.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/dtaAssemblyCar.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/systemCar.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/commandCar.o
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/lifterSim.o

# Initialise the Gemini Time System (1=master, 1=simulate, intPerSecond, intPerTick, timeOffset)
timeClockInit 0, 1, 60, 1, 0

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

# Load one or more ASCII databases here
dbLoad "/gemini/GEM8.6/gmos/gmos/data/default.dctsdr"
dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/gmosCcTopMKRS.db"
dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/gmosCcSadTopMKRS.db"
dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/gmSeqTopMKRS.db"
dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/gmSeqSadTopMKRS.db"

# This turns off logging
# iocLogDisable=1

iocInit "/gemini/GEM8.6/gmos/gmos/data/resource.def"

# Ensure master enable is disabled while startup script executes
dbpf "g6:cc:msEnableEnable","0"

dbpf "g6:sad:cc:historyLog","Booting..."

#Define the database name
dbpf "g6:sad:name.VAL","GMOS-N (@VERSION@)"
dbpf "g6:sad:cc:name.VAL","GMOS-N (@VERSION@) - sim post fp"

# Load initialization files
pvload "/gemini/GEM8.6/gmos/gmos/data/gmosCc.pv","top=g6:, sadtop=g6:sad:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmOiwfs.pv","top=g6:wfs:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmMask.pv","top=g6:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmFilterSim.pv","top=g6:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmGratingSim.pv","top=g6:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmTranslationSim.pv","top=g6:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmTempCalibrate.pv","top=g6:cc:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmSeq.pv","top=g6:, sadtop=g6:sad:"
pvload "/gemini/GEM8.6/gmos/gmos/data/gmSeqTracking.pv","top=g6:, sadtop=g6:sad:"

# Start sequences
seq &timeSeq, "sys=g6:cc:"

seq &assemblyCar, "top=g6:cc:, dev=msk, priority=75"
seq &assemblyCar, "top=g6:, dev=wfs:probe, priority=75"
seq &commandCar, "top=g6:, dev=wfs:, priority=75"
seq &assemblyCar, "top=g6:cc:, dev=flt, priority=75"
seq &assemblyCar, "top=g6:cc:, dev=gr, priority=75"
seq &lifterSim,   "top=g6:cc:, dev=gr, priority=75"
seq &dtaAssemblyCar, "top=g6:, dev=dta, priority=75"
seq &systemCar,   "top=g6:cc:, cad=init, priority=75"
seq &systemCar,   "top=g6:cc:, cad=test, priority=75"
seq &systemCar,   "top=g6:cc:, cad=datum, priority=75"
seq &systemCar,   "top=g6:cc:, cad=update, priority=75"
seq &systemCar,   "top=g6:cc:, cad=park, priority=75"

# Wait while the database initialises and sequences start.
taskDelay(210)

# Trigger the initialisation of the instrument sequencer and components
# controller, disabling initdcCadMark and avoiding the use of the top level
# apply record to prevent the detector controller being initialised.
dbpf "g6:initdcCadMark.DISA", "1"
dbpf "g6:init.DIR", "0"
dbpf "g6:init.DIR", "3"
# An extra components controller start is needed.
dbpf "g6:cc:init.DIR", "0"
dbpf "g6:cc:apply.DIR", "3"

# Wait while the filter, grating and mask data are read, cc inits.
taskDelay(210)

dbpf "g6:initdcCadMark.DISA", "0"

dbpf "g6:sad:cc:historyLog.VAL","Master enable switched on"

# Enable master enable on completion of startup script
dbpf "g6:cc:msEnableEnable","1"

# Finally, display the startup time in UTC.
#timeClockReport
timePrint "UTC"
