#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:
#
# DESCRIPTION:  Loads the GMOS Components Controller database.
#
#

# Make delete key work for backspace
tyBackspaceSet 0177

# Set the shell prompt
shellPromptSet "GMOS CC - sim > "

# cd to application install directory (beware automounter problems)
cd "$(iocpath)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
# (Commented out, since already done in startup_MINIMAL)
# < $(iocpath)/bin/$(arch)/local

# Load EPICS core and record stuff
ld < $(base)/bin/$(arch)/iocCore
ld < $(base)/bin/$(arch)/drvSup
ld < $(base)/bin/$(arch)/recSup
ld < $(iocpath)/bin/$(arch)/recApply.o
ld < $(base)/bin/$(arch)/devSup
ld < $(iocpath)/bin/$(arch)/devApplyLocal.o
ld < $(iocpath)/bin/$(arch)/devApplyRemote.o

# Add this for pvload
ld < $(base)/../extensions/bin/$(arch)/pvload

# If using state programs, load the sequencer
ld < $(base)/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records. It is assumed that Gemini
# libraries are available in the standard /gemini directory).

ld < /gemini/slalib/bin/$(arch)/slalib
ld < /gemini/timelib/bin/$(arch)/timelib

ld < $(iocpath)/bin/$(arch)/drvOmsVme.o
ld < $(iocpath)/bin/$(arch)/devDeviceControl.o
ld < $(iocpath)/bin/$(arch)/devBarcode.o
ld < $(iocpath)/bin/$(arch)/recAssControl.o
ld < $(iocpath)/bin/$(arch)/recDeviceControl.o
ld < $(iocpath)/bin/$(arch)/gmosGensubLib.o

ld < $(iocpath)/bin/$(arch)/gmMaskGenSubs.o
ld < $(iocpath)/bin/$(arch)/devMaskControl.o
ld < $(iocpath)/bin/$(arch)/gmOiwfsCalc.o
ld < $(iocpath)/bin/$(arch)/gmOiwfsGenSubs.o
ld < $(iocpath)/bin/$(arch)/gmOiwfsCadSupport.o
ld < $(iocpath)/bin/$(arch)/tcs_simulator.o
ld < $(iocpath)/bin/$(arch)/devOiwfsControl.o
ld < $(iocpath)/bin/$(arch)/devAtmdcControl.o
ld < $(iocpath)/bin/$(arch)/devFilterAss.o
ld < $(iocpath)/bin/$(arch)/gmosLutLib.o
ld < $(iocpath)/bin/$(arch)/devGratingAss.o
ld < $(iocpath)/bin/$(arch)/lifter.o
ld < $(iocpath)/bin/$(arch)/devTranslationAss.o

ld < $(iocpath)/bin/$(arch)/gmosCcCadLib.o

# Load sequences here
ld < /gemini/timelib/bin/mv167/timeSeq

ld < $(iocpath)/bin/$(arch)/assemblyCar.o
ld < $(iocpath)/bin/$(arch)/systemCar.o
ld < $(iocpath)/bin/$(arch)/commandCar.o
ld < $(iocpath)/bin/$(arch)/lifterSim.o

# Initialise the Gemini Time System (1=master, 1=simulate, intPerSecond, intPerTick, timeOffset)
timeClockInit 0, 1, 60, 1, 0

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

# Put the barcode reading software into simulation mode
devBarcodeSimulate = 3

# Load one or more ASCII databases here
dbLoad "$(iocpath)/data/default.dctsdr"
dbLoadRecords "$(iocpath)/data/gmosCcTopMKSS.db"
dbLoadRecords "$(iocpath)/data/gmosCcSadTopMKSS.db"

# This turns off logging
# iocLogDisable=1

iocInit "$(iocpath)/data/resource.def"

# Ensure master enable is disabled while startup script executes
dbpf "g7:cc:msEnableEnable","0"

dbpf "g7:sad:cc:historyLog","Booting..."

#Define the database name
dbpf "g7:sad:cc:name.VAL","GMOS CC Mauna Kea (V4-4) - simulated"

# Load initialization files
pvload "$(iocpath)/data/gmosCcSim.pv","top=g7:, sadtop=g7:sad:"
pvload "$(iocpath)/data/gmOiwfsSim.pv","top=g7:wfs:"
pvload "$(iocpath)/data/gmMaskSim.pv","top=g7:cc:"
pvload "$(iocpath)/data/gmFilterSim.pv","top=g7:cc:"
pvload "$(iocpath)/data/gmGratingSim.pv","top=g7:cc:"
pvload "$(iocpath)/data/gmTranslationSim.pv","top=g7:cc:"
pvload "$(iocpath)/data/gmTempCalibrate.pv","top=g7:cc:"

# Start sequences
seq &timeSeq, "sys=g7:cc:"

seq &assemblyCar, "top=g7:cc:, dev=msk, priority=75"
seq &assemblyCar, "top=g7:, dev=wfs:probe, priority=75"
seq &commandCar, "top=g7:, dev=wfs:, priority=75"
seq &assemblyCar, "top=g7:cc:, dev=flt, priority=75"
seq &assemblyCar, "top=g7:cc:, dev=gr, priority=75"
seq &lifterSim,   "top=g7:cc:, dev=gr, priority=75"
seq &assemblyCar, "top=g7:cc:, dev=dta, priority=75"
seq &systemCar,   "top=g7:cc:, cad=init, priority=75"
seq &systemCar,   "top=g7:cc:, cad=test, priority=75"
seq &systemCar,   "top=g7:cc:, cad=datum, priority=75"
seq &systemCar,   "top=g7:cc:, cad=update, priority=75"
seq &systemCar,   "top=g7:cc:, cad=park, priority=75"

# Trigger the initialisation of the components controller
dbpf "g7:cc:init.DIR","0"
dbpf "g7:cc:apply.DIR","3"

# Wait while the initialisation completes
taskDelay(180)

dbpf "g7:sad:cc:historyLog","Master enable switched on"

# Enable master enable on completion of startup script
dbpf "g7:cc:msEnableEnable","1"

# Finally, display the startup time in UTC.
#timeClockReport
timePrint "UTC"
