# $Id$
#
# VxWorks startup script to load and execute system (iocCore) software.
#
# FULL STARTUP SCRIPT. This script starts the GMOS software automatically.
#

# Make delete key work for backspace
tyBackspaceSet 0177

# Set the shell prompt
shellPromptSet "GMOS MK - sim2 > "

# cd to application install startup directory (beware automounter problems)
cd "$(install)/bin/$(arch)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
< local

# Execute the GMOS simulation mode startup script
< gmStartupMKSS2
