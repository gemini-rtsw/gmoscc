#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:
#
# DESCRIPTION:  Loads the GMOS Instrument Sequencer database.
#
#

# Make delete key work for backspace
tyBackspaceSet 0177

# Set the shell prompt
shellPromptSet "GMOS IS >"

# cd to application install directory (beware automounter problems)
cd "$(iocpath)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
# (Commented out, since already done in startup_MINIMAL)
#< $(iocpath)/bin/$(arch)/local

# Load EPICS core and record stuff
ld < $(epics)/base/bin/$(arch)/iocCore
ld < $(epics)/base/bin/$(arch)/drvSup
ld < $(epics)/base/bin/$(arch)/recSup
ld < $(epics)/base/bin/$(arch)/devSup

# Add this for pvload
ld < $(epics)/extensions/bin/$(arch)/pvload

# If using state programs, load the sequencer
ld < $(epics)/base/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records. (It is assume the GMOS libraries
# are contained in a top level "rel" directory. It is also assumed
# that Gemini libraries are available in the standard /gemini directory).

ld < /data/cjm/gemini/slalib/gmoscc/bin/$(arch)/slalib
ld < /data/cjm/gemini/timelib/gmoscc/bin/$(arch)/timelib
ld < /data/cjm/gemini/astlib/gmoscc/bin/$(arch)/astlib

ld < $(iocpath)/../gmoscc/bin/$(arch)/recAssControl.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/recDeviceControl.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/drvOmsVme.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devDeviceControl.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devBarcode.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/gmosGensubLib.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/assemblyCar.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/softCar.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/systemCar.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devAssControl.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devSeqControl.o

ld < $(iocpath)/../gmoscc/bin/$(arch)/devMaskControl.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/gmMskMisc.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devFilterAss.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devFilterWheel.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devGratingAss.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devGratingTilt.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devGratingTurret.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/gmosLutLib.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/gratingTilt.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/lifter.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/lifterSim.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devTranslationAss.o
ld < $(iocpath)/../gmoscc/bin/$(arch)/devTranslationStage.o

ld < $(iocpath)/../gmoscc/bin/$(arch)/gmosCcCadLib.o

ld < $(iocpath)/bin/$(arch)/gmSeqAppl

# Load sequences here
# ld < $(iocpath)/bin/$(arch)/testseq.o

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

# Load one or more ASCII databases here
dbLoad "$(iocpath)/data/default.dctsdr"
dbLoadRecords "$(iocpath)/../rel/data/gmMiscSim.db"
dbLoadRecords "$(iocpath)/../gmoscc/data/gmosCcTop2.db"
dbLoadRecords "$(iocpath)/../gmoscc/data/gmosCcSadTop2.db"
dbLoadRecords "$(iocpath)/data/gmSeqTop.db"
dbLoadRecords "$(iocpath)/data/gmSeqSadTop.db"
dbLoadRecords "$(iocpath)/data/gmosDcSimTop.db"
dbLoadRecords "$(iocpath)/data/gmosCcSadSimTop.db"

# This turns off logging
# iocLogDisable=1

iocInit "$(iocpath)/data/resource.def"

# Disable master enable
dbpf "g2:c2:masterEnable","0"

# Load initialization files
# pvload "$(iocpath)/../gmoscc/data/gmMaskSim.pv","top=g2:c1:"
pvload "$(iocpath)/data/gmSeq.pv","top=g2:, sadtop=g2:"
pvload "$(iocpath)/data/gmSeqTracking.pv","top=g2:, sadtop=g2:"

# Initialise grating records

dbpf "g2:c2:grATiltTran.D","./data"
dbpf "g2:c2:grBTiltTran.D","./data"
dbpf "g2:c2:grCTiltTran.D","./data"
dbpf "g2:c2:grDTiltTran.D","./data"

dbpf "g2:c2:grATiltTran.E","grAtrans.lut"
dbpf "g2:c2:grBTiltTran.E","grBtrans.lut"
dbpf "g2:c2:grCTiltTran.E","grCtrans.lut"
dbpf "g2:c2:grDTiltTran.E","grDtrans.lut"

# Start sequences
#seq &assemblyCar, "top=g2:c1:, dev=msk, priority=55"
seq &assemblyCar, "top=g2:c2:, dev=flt, priority=55"
seq &assemblyCar, "top=g2:c2:, dev=gr, priority=55"
seq &lifterSim,   "top=g2:c2:, dev=gr, priority=55"
seq &assemblyCar, "top=g2:c2:, dev=dta, priority=55"
seq &softCar,     "top=g2:cc:, cad=debug, priority=55"
seq &softCar,     "top=g2:cc:, cad=simulate, priority=55"
seq &systemCar,   "top=g2:cc:, cad=init, priority=55"
seq &systemCar,   "top=g2:cc:, cad=test, priority=55"
seq &systemCar,   "top=g2:cc:, cad=datum, priority=55"
seq &systemCar,   "top=g2:cc:, cad=update, priority=55"
seq &systemCar,   "top=g2:cc:, cad=park, priority=55"
