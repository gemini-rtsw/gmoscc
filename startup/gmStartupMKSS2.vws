#
# VxWorks startup script to load and execute system (iocCore) software.
#
# DESCRIPTION:  Loads the GMOS Components Controller database.
#
#

# Make delete key work for backspace
tyBackspaceSet 0177

# Set the shell prompt
shellPromptSet "GMOS MK - sim2 > "
loginStringSet "MVME167 vxWorks (GMOS MK - sim2)\n\nlogin: "

# cd to application install directory (beware automounter problems)
cd "$(install)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
# (Commented out, since already done in startup_MINIMAL)
# < $(install)/bin/$(arch)/local

# Load EPICS core and record stuff
ld < $(epics)/base/bin/$(arch)/iocCore
ld < $(epics)/base/bin/$(arch)/drvSup
ld < $(epics)/base/bin/$(arch)/recSup
ld < $(install)/bin/$(arch)/recApply.o
ld < $(epics)/base/bin/$(arch)/devSup
ld < $(install)/bin/$(arch)/devApplyLocal.o
ld < $(install)/bin/$(arch)/devApplyRemote.o

# Add this for pvload
ld < epics/extensions/bin/$(arch)/pvload

# If using state programs, load the sequencer
ld < $(epics)/base/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records. It is assumed that Gemini
# libraries are available in the standard /gemini directory).

ld < /gemini/slalib/bin/$(arch)/slalib
ld < /gemini/timelib/bin/$(arch)/timelib
ld < /gemini/astlib/bin/$(arch)/astlib

ld < $(install)/bin/$(arch)/drvOmsVme.o
ld < $(install)/bin/$(arch)/devDeviceControl.o
ld < $(install)/bin/$(arch)/devBarcode.o
ld < $(install)/bin/$(arch)/recAssControl.o
ld < $(install)/bin/$(arch)/recDeviceControl.o
ld < $(install)/bin/$(arch)/gmosGensubLib.o

ld < $(install)/bin/$(arch)/gmMaskGenSubs.o
ld < $(install)/bin/$(arch)/devMaskControl.o
ld < $(install)/bin/$(arch)/gmOiwfsCalc.o
ld < $(install)/bin/$(arch)/gmOiwfsGenSubs.o
ld < $(install)/bin/$(arch)/gmOiwfsCadSupport.o
ld < $(install)/bin/$(arch)/tcs_simulator.o
ld < $(install)/bin/$(arch)/devOiwfsControl.o
ld < $(install)/bin/$(arch)/devAtmdcControl.o
ld < $(install)/bin/$(arch)/devFilterAss.o
ld < $(install)/bin/$(arch)/gmosLutLib.o
ld < $(install)/bin/$(arch)/devGratingAss.o
ld < $(install)/bin/$(arch)/lifter.o
ld < $(install)/bin/$(arch)/devTranslationAss.o
ld < $(install)/bin/$(arch)/gmosCcCadLib.o

ld < $(version)/bin/$(arch)/gmSeqAppl

# Load sequences here
ld < /gemini/timelib/bin/mv167/timeSeq

ld < $(install)/bin/$(arch)/assemblyCar.o
ld < $(install)/bin/$(arch)/dtaAssemblyCar.o
ld < $(install)/bin/$(arch)/systemCar.o
ld < $(install)/bin/$(arch)/commandCar.o
ld < $(install)/bin/$(arch)/lifterSim.o

# Initialise the Gemini Time System (1=master, 1=simulate, intPerSecond, intPerTick, timeOffset)
timeClockInit 0, 1, 60, 1, 0

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

# Put the barcode reading software into simulation mode
devBarcodeSimulate = 3

# Load one or more ASCII databases here
dbLoad "$(install)/data/default.dctsdr"
dbLoadRecords "$(install)/data/gmosCcTopMKSS2.db"
dbLoadRecords "$(install)/data/gmosCcSadTopMKSS2.db"
dbLoadRecords "$(install)/data/gmSeqTopMKSS2.db"
dbLoadRecords "$(install)/data/gmSeqSadTopMKSS2.db"

# This turns off logging
# iocLogDisable=1

iocInit "$(install)/data/resource.def"

# Ensure master enable is disabled while startup script executes
dbpf "g8:cc:msEnableEnable","0"

dbpf "g8:sad:cc:historyLog","Booting..."

#Define the database name
dbpf "g8:sad:name.VAL","GMOS MK (simulated) (V22)"
dbpf "g8:sad:cc:name.VAL","GMOS Mauna Kea (V22) - simulated2"

# Load initialization files
pvload "$(version)/data/gmosCcSim.pv","top=g8:, sadtop=g8:sad:"
pvload "$(version)/data/gmOiwfsSim.pv","top=g8:wfs:"
pvload "$(version)/data/gmMaskSim.pv","top=g8:cc:"
pvload "$(version)/data/gmFilterSim.pv","top=g8:cc:"
pvload "$(version)/data/gmGratingSim.pv","top=g8:cc:"
pvload "$(version)/data/gmTranslationSim.pv","top=g8:cc:"
pvload "$(version)/data/gmTempCalibrate.pv","top=g8:cc:"
pvload "$(version)/data/gmSeqSim.pv","top=g8:, sadtop=g8:sad:"
pvload "$(version)/data/gmSeqTracking.pv","top=g8:, sadtop=g8:sad:"

# Start sequences
seq &timeSeq, "sys=g8:cc:"

seq &assemblyCar, "top=g8:cc:, dev=msk, priority=75"
seq &assemblyCar, "top=g8:, dev=wfs:probe, priority=75"
seq &commandCar, "top=g8:, dev=wfs:, priority=75"
seq &assemblyCar, "top=g8:cc:, dev=flt, priority=75"
seq &assemblyCar, "top=g8:cc:, dev=gr, priority=75"
seq &lifterSim,   "top=g8:cc:, dev=gr, priority=75"
seq &dtaAssemblyCar, "top=g8:, dev=dta, priority=75"
seq &systemCar,   "top=g8:cc:, cad=init, priority=75"
seq &systemCar,   "top=g8:cc:, cad=test, priority=75"
seq &systemCar,   "top=g8:cc:, cad=datum, priority=75"
seq &systemCar,   "top=g8:cc:, cad=update, priority=75"
seq &systemCar,   "top=g8:cc:, cad=park, priority=75"

# Wait while the database initialises and sequences start.
taskDelay(210)

# Trigger the initialisation of the instrument sequencer and components controller
# disabling initdcCadMark to prevent the detector controller being initialised
dbpf "g8:initdcCadMark.DISA", "1"
dbpf "g8:init.DIR", "0"
dbpf "g8:apply.DIR", "3"
# For some reason an extra components controller start is needed
dbpf "g8:cc:init.DIR", "0"
dbpf "g8:cc:apply.DIR", "3"

# Wait while the filter, grating and mask data are read, cc inits.
taskDelay(210)

dbpf "g8:initdcCadMark.DISA", "0"

dbpf "g8:sad:cc:historyLog","Master enable switched on"

# Enable master enable on completion of startup script
dbpf "g8:cc:msEnableEnable","1"

# Finally, display the startup time in UTC.
#timeClockReport
timePrint "UTC"
