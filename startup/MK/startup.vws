#
# VxWorks startup script to load and execute system (iocCore) software.
#
# First, vxWorks startup issues:

# Make delete key work for backspace
tyBackspaceSet 0177

# cd to application install directory (beware automounter problems)
cd "/gemini/GEM8.6/gmos/gmos"
pwd

# The local file contains site-specific information
< /gemini/GEM8.6/gmos/gmos/bin/$(arch)/local

# Load EPICS core, sequencer and pvload
ld < $(base)/bin/$(arch)/iocCore
ld < $(base)/bin/$(arch)/seq
ld < $(extensions)/bin/$(arch)/pvload

# Records, device and driver support for a Gemini base system
ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/gemini$(dbname).Support

# Load any application records, device support or drivers here,
# or code for subroutine records
# ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/testsub.o

# Load sequences here
# ld < /gemini/GEM8.6/gmos/gmos/bin/$(arch)/testseq.o

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

# Load one or more ASCII databases here
dbLoadDatabase "/gemini/GEM8.6/gmos/gmos/dbd/gemini$(dbname).dbd"
# dbLoadRecords "/gemini/GEM8.6/gmos/gmos/data/test.db"

# This turns off logging
# iocLogDisable=1

# Set the environment variables
< /gemini/GEM8.6/gmos/gmos/data/resource.def

iocInit

# Start sequences
# seq &testseq
