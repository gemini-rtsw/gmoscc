#
# VxWorks startup script to load and execute system (iocCore) software.
#
# DESCRIPTION:  Loads the GMOS Components Controller and Instrument Sequencer
# databases.
#

# Make delete key work for backspace
tyBackspaceSet 0177

# Set the shell prompt
shellPromptSet "GMOS-CP > "
loginStringSet "PPC604 vxWorks (GMOS-CP)\n\nlogin: "

# cd to application install directory (beware automounter problems)
cd "$(iocpath)"
pwd

# The local file contains site-specific information
# such as the default router and the vxWorks password file.
# (Commented out, since already done in startup_MINIMAL)
< $(version)/bin/$(arch)/local

# Load EPICS core, pvload and sequencer
ld < /gemini/external/GEM8.6/base/bin/$(arch)/iocCore
ld < /gemini/external/GEM8.6/extensions/bin/$(arch)/pvload
ld < /gemini/external/GEM8.6/base/bin/$(arch)/seq

# Load any application records, device support or drivers here,
# or code for subroutine records. It is assumed that Gemini
# libraries are available in the standard /gemini directory).
ld < $(version)/bin/$(arch)/gemini.Support

ld < /gemini/GEM8.6/slalib/slalib/bin/$(arch)/slalib
ld < /gemini/GEM8.6/timelib/timelib/bin/$(arch)/timelib
ld < /gemini/GEM8.6/astlib/astlib/bin/$(arch)/astlib
ld < /gemini/GEM8.6/timelib/timelib/bin/$(arch)/timeSeq

ld < $(version)/bin/$(arch)/deviceControlLib.a
ld < $(version)/bin/$(arch)/gmosLib.a
ld < $(version)/bin/$(arch)/assemblyControlLib.a
ld < $(version)/bin/$(arch)/gmSeqLib.a

# Load sequences here

ld < $(version)/bin/$(arch)/assemblyCar
ld < $(version)/bin/$(arch)/dtaAssemblyCar
ld < $(version)/bin/$(arch)/systemCar
ld < $(version)/bin/$(arch)/commandCar

# Initialise the Gemini Time System (1=master, 1=simulate, intPerSecond, intPerTick, timeOffset)
timeClockInit 0, 0, 60, 1, 0

# Configure the Timestamp system, 1=Master IOC
TSconfigure 1, 0, 0, 0, 0, 0

# Load one or more ASCII databases here
dbLoadDatabase "$(version)/dbd/gemini.dbd"
dbLoadRecords "$(version)/data/gmosCcTop.db"
dbLoadRecords "$(version)/data/gmosCcSadTop.db"
dbLoadRecords "$(version)/data/gmSeqTop.db"
dbLoadRecords "$(version)/data/gmSeqSadTop.db"

# This turns off logging
# iocLogDisable=1

iocInit "$(version)/data/resource.def"

# Ensure master enable is disabled while startup script executes
dbpf "gm:cc:msEnableEnable","0"

dbpf "gm:sad:cc:historyLog","Booting..."

#Define the database name
dbpf "gm:sad:name.VAL","GMOS-CP (V6-9)"
dbpf "gm:sad:cc:name.VAL","GMOS-CP (V6-9)"

# Load initialization files
pvload "$(version)/data/gmosCc.pv","top=gm:, sadtop=gm:sad:"
pvload "$(version)/data/gmOiwfs.pv","top=gm:wfs:"
pvload "$(version)/data/gmMask.pv","top=gm:cc:"
pvload "$(version)/data/gmFilter.pv","top=gm:cc:"
pvload "$(version)/data/gmGrating.pv","top=gm:cc:"
pvload "$(version)/data/gmTranslation.pv","top=gm:cc:"
pvload "$(version)/data/gmAtm.pv","top=gm:cc:"
pvload "$(version)/data/gmTempCalibrate.pv","top=gm:cc:"
pvload "$(version)/data/gmSeq.pv","top=gm:, sadtop=gm:sad:"
pvload "$(version)/data/gmSeqTracking.pv","top=gm:, sadtop=gm:sad:"
# Start sequences
seq &timeSeq, "sys=gm:cc:"

seq &assemblyCar, "top=gm:cc:, dev=msk, priority=75"
seq &assemblyCar, "top=gm:, dev=wfs:probe, priority=75"
seq &commandCar, "top=gm:, dev=wfs:, priority=75"
seq &assemblyCar, "top=gm:cc:, dev=flt, priority=75"
seq &assemblyCar, "top=gm:cc:, dev=gr, priority=75"
seq &dtaAssemblyCar, "top=gm:, dev=dta, priority=75"
seq &systemCar,   "top=gm:cc:, cad=init, priority=75"
seq &systemCar,   "top=gm:cc:, cad=test, priority=75"
seq &systemCar,   "top=gm:cc:, cad=datum, priority=75"
seq &systemCar,   "top=gm:cc:, cad=update, priority=75"
seq &systemCar,   "top=gm:cc:, cad=park, priority=75"

# Wait while the database initialises and sequences start.
taskDelay(210)

# Trigger the initialisation of the instrument sequencer and components
# controller, disabling initdcCadMark and avoiding the use of the top level
# apply record to prevent the detector controller being initialised.
dbpf "gm:initdcCadMark.DISA", "1"
dbpf "gm:init.DIR", "0"
dbpf "gm:init.DIR", "3"

# An extra components controller start is needed.
dbpf "gm:cc:init.DIR", "0"
dbpf "gm:cc:apply.DIR", "3"

# Wait while the filter, grating and mask data are read, cc inits.
taskDelay(210)

dbpf "gm:initdcCadMark.DISA", "0"

dbpf "gm:sad:cc:historyLog","Master enable switched on"

# Enable master enable on completion of startup script
dbpf "gm:cc:msEnableEnable","1"

#default issPort (moved to gmAtm.pv)
#dbpf "gm:atmTrack:issPort","1"
#dbpf "gm:atmTrack:issPort.PROC","1"

# Finally, display the startup time in UTC.
timePrint "UTC"
