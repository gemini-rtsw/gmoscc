# monitor_update.cau
#
# cau macro which monitors CAD/CAR records associated with update.
# Invoked using cau "source" command.
#
monitor gm:update.DIR
monitor gm:update.VAL
monitor gm:cc:update.DIR
monitor gm:cc:update.VAL

monitor gm:cc:updateC.VAL
monitor gm:updateC.VAL

# Type dataOut cau_update.log
