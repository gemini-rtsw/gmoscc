# monitor_simulate.cau
#
# cau macro which monitors CAD/CAR records associated with simulate.
# Invoked using cau "source" command.
#
monitor gm:cc:simulate.DIR
monitor gm:cc:simulate.VAL
monitor gm:cc:simulate.A
monitor gm:cc:simulate.OMSS

monitor gm:cc:simulateC.VAL
monitor gm:cc:simulateC.OMSS

# Type dataOut cau_simulate.log
