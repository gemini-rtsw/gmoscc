# monitor_init.cau
#
# cau macro which monitors CAD/CAR records associated with init.
# Invoked using cau "source" command.
#
monitor gm:init.DIR
monitor gm:init.VAL
monitor gm:init.A
monitor gm:cc:init.DIR
monitor gm:cc:init.VAL
monitor gm:cc:init.A
monitor gm:dc:init.DIR
monitor gm:dc:init.VAL
monitor gm:dc:init.A

monitor gm:cc:initC.VAL
monitor gm:dc:initC.VAL
monitor gm:initC.VAL

# Type dataOut cau_init.log
