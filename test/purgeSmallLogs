#!/bin/csh
#
# purgeSmallLogs
#
# Description:
#   Purge small log files generated by previous script runs, which tend
#   to be the ones where the script has failed to get past the intial
#   conditions check.
#
# Invocation:
#   purgeLogs
#
# Remove small log files (up to size=9), specifying -i so the user is
# prompted for each one.
#
echo "Size=0 files"
rm -i `find ./logfiles -name "*.log.*" -size 0 -print`
echo "Size=1 files"
rm -i `find ./logfiles -name "*.log.*" -size 1 -print`
echo "Size=2 files"
rm -i `find ./logfiles -name "*.log.*" -size 2 -print`
echo "Size=3 files"
rm -i `find ./logfiles -name "*.log.*" -size 3 -print`
echo "Size=4 files"
rm -i `find ./logfiles -name "*.log.*" -size 4 -print`
echo "Size=5 files"
rm -i `find ./logfiles -name "*.log.*" -size 5 -print`
echo "Size=6 files"
rm -i `find ./logfiles -name "*.log.*" -size 6 -print`
echo "Size=7 files"
rm -i `find ./logfiles -name "*.log.*" -size 7 -print`
echo "Size=8 files"
rm -i `find ./logfiles -name "*.log.*" -size 8 -print`
echo "Size=9 files"
rm -i `find ./logfiles -name "*.log.*" -size 9 -print`
