# monitor_apply.cau
#
# cau macro which monitors all subsystem apply records.
# Invoked using cau "source" command.
#
monitor gm:apply.DIR
monitor gm:apply.VAL
monitor gm:apply.CLID
monitor gm:apply.OMSS

monitor gm:cc:apply.DIR
monitor gm:cc:apply.VAL
monitor gm:cc:apply.CLID
monitor gm:cc:apply.OMSS

monitor gm:dc:apply.DIR
monitor gm:dc:apply.VAL
monitor gm:dc:apply.CLID
monitor gm:dc:apply.OMSS

monitor gm:cc:applyC.VAL
monitor gm:cc:applyC.CLID
monitor gm:cc:applyC.OMSS

monitor gm:dc:applyC.VAL
monitor gm:dc:applyC.CLID
monitor gm:dc:applyC.OMSS

monitor gm:applyC.VAL
monitor gm:applyC.CLID
monitor gm:applyC.OMSS

# Type dataOut cau_apply.log
