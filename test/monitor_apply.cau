# monitor_apply.cau
#
# cau macro which monitors all subsystem apply records.
# Invoked using cau "source" command.
#
monitor g8:apply.DIR
monitor g8:apply.VAL
monitor g8:apply.CLID
monitor g8:apply.OMSS

monitor g8:cc:apply.DIR
monitor g8:cc:apply.VAL
monitor g8:cc:apply.CLID
monitor g8:cc:apply.OMSS

monitor g8:dc:apply.DIR
monitor g8:dc:apply.VAL
monitor g8:dc:apply.CLID
monitor g8:dc:apply.OMSS

monitor g8:cc:applyC.VAL
monitor g8:cc:applyC.CLID
monitor g8:cc:applyC.OMSS

monitor g8:dc:applyC.VAL
monitor g8:dc:applyC.CLID
monitor g8:dc:applyC.OMSS

monitor g8:applyC.VAL
monitor g8:applyC.CLID
monitor g8:applyC.OMSS

# Type dataOut cau_apply.log
