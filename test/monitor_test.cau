# monitor_test.cau
#
# cau macro which monitors CAD/CAR records associated with test.
# Invoked using cau "source" command.
#
monitor gm:test.DIR
monitor gm:test.VAL
monitor gm:cc:test.DIR
monitor gm:cc:test.VAL
monitor gm:dc:test.DIR
monitor gm:dc:test.VAL

monitor gm:cc:testC.VAL
monitor gm:dc:testC.VAL
monitor gm:testC.VAL

# Type dataOut cau_test.log
