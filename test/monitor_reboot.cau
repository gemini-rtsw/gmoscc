# monitor_reboot.cau
#
# cau macro which monitors CAD/CAR records associated with reboot.
# Invoked using cau "source" command.
#
monitor gm:reboot.DIR
monitor gm:reboot.VAL
monitor gm:dc:reboot.DIR
monitor gm:dc:reboot.VAL

monitor gm:dc:genSysC.VAL
monitor gm:rebootC.VAL

# Type dataOut cau_reboot.log
