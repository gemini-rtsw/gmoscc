# monitor_debug.cau
#
# cau macro which monitors CAD/CAR records associated with debug.
# Invoked using cau "source" command.
#
monitor gm:debug.DIR
monitor gm:debug.VAL
monitor gm:debug.A
monitor gm:cc:debug.DIR
monitor gm:cc:debug.VAL
monitor gm:cc:debug.A
monitor gm:dc:debug.DIR
monitor gm:dc:debug.VAL
monitor gm:dc:debug.A

monitor gm:cc:debugC.VAL
monitor gm:dc:genSysC.VAL
monitor gm:debugC.VAL

# Type dataOut cau_debug.log
