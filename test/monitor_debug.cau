# monitor_debug.cau
#
# cau macro which monitors CAD/CAR records associated with debug.
# Invoked using cau "source" command.
#
monitor g8:debug.DIR
monitor g8:debug.VAL
monitor g8:debug.A
monitor g8:cc:debug.DIR
monitor g8:cc:debug.VAL
monitor g8:cc:debug.A
monitor g8:dc:debug.DIR
monitor g8:dc:debug.VAL
monitor g8:dc:debug.A

monitor g8:cc:debugC.VAL
monitor g8:dc:genSysC.VAL
monitor g8:debugC.VAL

# Type dataOut cau_debug.log
