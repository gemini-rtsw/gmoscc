# monitor_observe.cau
#
# cau macro which monitors CAD/CAR records associated with observe.
# Invoked using cau "source" command.
#
monitor g8:observe.DIR
monitor g8:observe.VAL
monitor g8:observe.A
monitor g8:pause.DIR
monitor g8:pause.VAL
monitor g8:continue.DIR
monitor g8:continue.VAL
monitor g8:stop.DIR
monitor g8:stop.VAL
monitor g8:abort.DIR
monitor g8:abort.VAL
monitor g8:endObserve.DIR
monitor g8:endObserve.VAL

monitor g8:dc:observe.DIR
monitor g8:dc:observe.VAL
monitor g8:dc:observe.A
monitor g8:dc:pause.DIR
monitor g8:dc:pause.VAL
monitor g8:dc:continue.DIR
monitor g8:dc:continue.VAL
monitor g8:dc:stop.DIR
monitor g8:dc:stop.VAL
monitor g8:dc:abort.DIR
monitor g8:dc:abort.VAL
monitor g8:dc:endObserve.DIR
monitor g8:dc:endObserve.VAL

monitor g8:dc:observeC.VAL
monitor g8:dc:endObserveC.VAL
monitor g8:observeC.VAL
monitor g8:endObserveC.VAL

# Type dataOut cau_observe.log
