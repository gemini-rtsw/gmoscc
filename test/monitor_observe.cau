# monitor_observe.cau
#
# cau macro which monitors CAD/CAR records associated with observe.
# Invoked using cau "source" command.
#
monitor gm:observe.DIR
monitor gm:observe.VAL
monitor gm:observe.A
monitor gm:pause.DIR
monitor gm:pause.VAL
monitor gm:continue.DIR
monitor gm:continue.VAL
monitor gm:stop.DIR
monitor gm:stop.VAL
monitor gm:abort.DIR
monitor gm:abort.VAL
monitor gm:endObserve.DIR
monitor gm:endObserve.VAL

monitor gm:dc:observe.DIR
monitor gm:dc:observe.VAL
monitor gm:dc:observe.A
monitor gm:dc:pause.DIR
monitor gm:dc:pause.VAL
monitor gm:dc:continue.DIR
monitor gm:dc:continue.VAL
monitor gm:dc:stop.DIR
monitor gm:dc:stop.VAL
monitor gm:dc:abort.DIR
monitor gm:dc:abort.VAL
monitor gm:dc:endObserve.DIR
monitor gm:dc:endObserve.VAL

monitor gm:dc:observeC.VAL
monitor gm:dc:endObserveC.VAL
monitor gm:observeC.VAL
monitor gm:endObserveC.VAL

# Type dataOut cau_observe.log
