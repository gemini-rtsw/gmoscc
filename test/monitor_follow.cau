# monitor_follow.cau
#
# cau macro which monitors CAD/CAR records
# associated with OIWFS following mode.
# Invoked using cau "source" command.
#

monitor gm:wfs:follow.DIR
monitor gm:wfs:follow.VAL
monitor gm:wfs:follow.OMSS

monitor gm:wfs:stop.DIR
monitor gm:wfs:stop.VAL
monitor gm:wfs:stop.OMSS

monitor gm:wfs:probeC.VAL
monitor gm:wfs:probeC.OMSS

monitor gm:wfs:activeC.VAL
monitor gm:wfs:activeC.OMSS

monitor gm:wfs:inPosition.VAL
monitor gm:wfs:arrayS.VAL
monitor gm:wfs:followS.VAL

monitor gm:wfs:followA.H
# Commented out - changes at 20Hz
#monitor gm:wfs:followA.VALC
monitor gm:wfs:followA.VAL

monitor gm:wfs:probeOffset.VAL

# Type dataOut cau_follow.log
