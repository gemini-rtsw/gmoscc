# monitor_datum.cau
#
# cau macro which monitors CAD/CAR records associated with datum.
# Invoked using cau "source" command.
#
monitor g8:datum.DIR
monitor g8:datum.VAL
monitor g8:cc:datum.DIR
monitor g8:cc:datum.VAL
monitor g8:dc:datum.DIR
monitor g8:dc:datum.VAL

monitor g8:cc:datumC.VAL
monitor g8:dc:datumC.VAL
monitor g8:datumC.VAL

# Type dataOut cau_datum.log
