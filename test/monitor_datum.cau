# monitor_datum.cau
#
# cau macro which monitors CAD/CAR records associated with datum.
# Invoked using cau "source" command.
#
monitor gm:datum.DIR
monitor gm:datum.VAL
monitor gm:cc:datum.DIR
monitor gm:cc:datum.VAL
monitor gm:dc:datum.DIR
monitor gm:dc:datum.VAL

monitor gm:cc:datumC.VAL
monitor gm:dc:datumC.VAL
monitor gm:datumC.VAL

# Type dataOut cau_datum.log
