# monitor_simulate.cau
#
# cau macro which monitors CAD/CAR records associated with simulate.
# Invoked using cau "source" command.
#
monitor g8:simulate.DIR
monitor g8:simulate.VAL
monitor g8:simulate.A
monitor g8:cc:simulate.DIR
monitor g8:cc:simulate.VAL
monitor g8:cc:simulate.A
monitor g8:dc:simulate.DIR
monitor g8:dc:simulate.VAL
monitor g8:dc:simulate.A

monitor g8:cc:simulateC.VAL
monitor g8:dc:genSysC.VAL
monitor g8:simulateC.VAL

# Type dataOut cau_simulate.log
