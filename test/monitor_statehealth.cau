# monitor_statehealth.cau
#
# cau macro which monitors SIR records associated with state and health.
# Invoked using cau "source" command.
#
monitor gm:sad:cc:state.VAL
monitor gm:sad:dc:state.DIR
monitor gm:sad:state.VAL

monitor gm:sad:cc:health.VAL
monitor gm:sad:dc:health.VAL
monitor gm:sad:health.VAL
