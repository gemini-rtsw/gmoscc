# monitor_park.cau
#
# cau macro which monitors CAD/CAR records associated with park.
# Invoked using cau "source" command.
#
monitor gm:park.DIR
monitor gm:park.VAL
monitor gm:cc:park.DIR
monitor gm:cc:park.VAL
monitor gm:dc:park.DIR
monitor gm:dc:park.VAL

monitor gm:cc:parkC.VAL
monitor gm:dc:parkC.VAL
monitor gm:parkC.VAL

# Type dataOut cau_park.log
