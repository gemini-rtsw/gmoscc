# monitor_park.cau
#
# cau macro which monitors CAD/CAR records associated with park.
# Invoked using cau "source" command.
#
monitor g8:park.DIR
monitor g8:park.VAL
monitor g8:cc:park.DIR
monitor g8:cc:park.VAL
monitor g8:dc:park.DIR
monitor g8:dc:park.VAL

monitor g8:cc:parkC.VAL
monitor g8:dc:parkC.VAL
monitor g8:parkC.VAL

# Type dataOut cau_park.log
