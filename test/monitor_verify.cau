# monitor_verify.cau
#
# cau macro which monitors CAD/CAR records associated with verify/endVerify
# Invoked using cau "source" command.
#
monitor gm:verify.DIR
monitor gm:verify.VAL
monitor gm:endVerify.DIR
monitor gm:endVerify.VAL
monitor gm:dc:verify.DIR
monitor gm:dc:verify.VAL
monitor gm:dc:endVerify.DIR
monitor gm:dc:endVerify.VAL

monitor gm:dc:verifyC.VAL
monitor gm:dc:endVerifyC.VAL
monitor gm:verifyC.VAL
monitor gm:endVerifyC.VAL

# Type dataOut cau_verify.log
