# monitor_verify.cau
#
# cau macro which monitors CAD/CAR records associated with verify/endVerify
# Invoked using cau "source" command.
#
monitor g8:verify.DIR
monitor g8:verify.VAL
monitor g8:endVerify.DIR
monitor g8:endVerify.VAL
monitor g8:dc:verify.DIR
monitor g8:dc:verify.VAL
monitor g8:dc:endVerify.DIR
monitor g8:dc:endVerify.VAL

monitor g8:dc:verifyC.VAL
monitor g8:dc:endVerifyC.VAL
monitor g8:verifyC.VAL
monitor g8:endVerifyC.VAL

# Type dataOut cau_verify.log
