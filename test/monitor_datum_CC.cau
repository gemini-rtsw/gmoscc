# monitor_datum.cau
#
# cau macro which monitors CAD/CAR records associated with datum.
# Invoked using cau "source" command.
#
monitor g7:cc:datum.DIR
monitor g7:cc:datum.VAL
monitor g7:cc:datum.OMSS

monitor g7:cc:datumC.VAL
monitor g7:cc:datumC.OMSS

monitor g7:wfs:datum.DIR
monitor g7:wfs:datum.VAL
monitor g7:wfs:datum.OMSS

# Type dataOut cau_datum.log
