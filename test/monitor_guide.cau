# monitor_guide.cau
#
# cau macro which monitors CAD/CAR records associated with guide/endGuide.
# Invoked using cau "source" command.
#
monitor gm:guide.DIR
monitor gm:guide.VAL
monitor gm:endGuide.DIR
monitor gm:endGuide.VAL
monitor gm:dc:guide.DIR
monitor gm:dc:guide.VAL
monitor gm:dc:endGuide.DIR
monitor gm:dc:endGuide.VAL

monitor gm:dc:guideC.VAL
monitor gm:dc:endGuideC.VAL
monitor gm:guideC.VAL
monitor gm:endGuideC.VAL

# Type dataOut cau_guide.log
