# monitor_guide.cau
#
# cau macro which monitors CAD/CAR records associated with guide/endGuide.
# Invoked using cau "source" command.
#
monitor g8:guide.DIR
monitor g8:guide.VAL
monitor g8:endGuide.DIR
monitor g8:endGuide.VAL
monitor g8:dc:guide.DIR
monitor g8:dc:guide.VAL
monitor g8:dc:endGuide.DIR
monitor g8:dc:endGuide.VAL

monitor g8:dc:guideC.VAL
monitor g8:dc:endGuideC.VAL
monitor g8:guideC.VAL
monitor g8:endGuideC.VAL

# Type dataOut cau_guide.log
