#
# Do a series of short probe moves
#

TEST "Do a series of short probe moves"
FATAL

DESC "Moving to first corner"

PUTVAL wfsMXTarget "-1"
OUTPUT *

PUTVAL wfsMYTarget "-1"
OUTPUT *

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Moving to second corner"

PUTVAL wfsMYTarget "1"
OUTPUT *

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Moving to third corner"

PUTVAL wfsMXTarget "1"
OUTPUT *

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Moving to fourth corner"

PUTVAL wfsMYTarget "-1"
OUTPUT *

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Test receipt of new target while already moving
#

TEST "Test receipt of new target while already moving"
FATAL

DESC "Start in upper left corner"

DESC "Load X attribute with minimum value"
CMD "setField wfsMXTarget wfsXMin"
OUTPUT *Success*

DESC "Load Y attribute with maximum value"
CMD "setField wfsMYTarget wfsYMax"
OUTPUT *Success*

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Start move to upper right corner"

DESC "Load X attribute with maximum value"
CMD "setField wfsMXTarget wfsXMax"
OUTPUT *Success*

DESC "Load Y attribute with maximum value"
CMD "setField wfsMYTarget wfsYMax"
OUTPUT *Success*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Interrupt with move to optical centre"

PUTVAL wfsMXTarget "0.0"
OUTPUT *.A* 0.0*

PUTVAL wfsMYTarget "0.0"
OUTPUT *.B* 0.0*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

ENDTEST

