#
# And back to center
#

TEST "Put the wfs to the optical axis"
FATAL

DESC "Putting the wfs to center"

PUTVAL wfsMXTarget "0.0"
OUTPUT *0*

PUTVAL wfsMYTarget "0.0"
OUTPUT *0*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
