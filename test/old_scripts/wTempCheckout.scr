#
# Un-Park the wfs assembly
#

TEST "Move the OIWFS Probe and lose park flag"
FATAL

DESC "Moving wfs"

PUTVAL wfsMXTarget "0.0"
OUTPUT *0*

PUTVAL wfsMYTarget "0.0"
OUTPUT *0*

DESC "Set MODE to MOVE"
PUTVAL wfsMode "1"
OUTPUT *.MODE*.MODE*MOVE*

DESC "Start the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST

