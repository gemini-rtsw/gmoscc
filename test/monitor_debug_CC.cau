# monitor_debug.cau
#
# cau macro which monitors CAD/CAR records associated with debug.
# Invoked using cau "source" command.
#
monitor g7:cc:debug.DIR
monitor g7:cc:debug.VAL
monitor g7:cc:debug.A
monitor g7:cc:debug.OMSS

monitor g7:cc:debugC.VAL

monitor g7:wfs:debug.DIR
monitor g7:wfs:debug.VAL
monitor g7:wfs:debug.A
monitor g7:wfs:debug.OMSS

# Type dataOut cau_debug.log
