# monitor_init.cau
#
# cau macro which monitors CAD/CAR records associated with init.
# Invoked using cau "source" command.
#
monitor gm:cc:init.DIR
monitor gm:cc:init.VAL
monitor gm:cc:init.OMSS

monitor gm:cc:initC.VAL
monitor gm:cc:initC.OMSS

monitor gm:wfs:init.DIR
monitor gm:wfs:init.VAL
monitor gm:wfs:init.OMSS


# Type dataOut cau_init.log
