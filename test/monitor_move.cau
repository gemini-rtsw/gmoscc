# monitor_move.cau
#
# cau macro which monitors CAD/CAR records associated
# with OIWFS following mode.
# Invoked using cau "source" command.
#

monitor gm:wfs:move.DIR
monitor gm:wfs:move.VAL
monitor gm:wfs:move.A
monitor gm:wfs:move.B
monitor gm:wfs:move.OMSS

monitor gm:wfs:probeC.VAL
monitor gm:wfs:probeC.OMSS

monitor gm:wfs:inPosition.VAL

# Type dataOut cau_move.log
