# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Invalid park position'"
GETVAL cmdError
OUTPUT *Invalid park position*

ENDTEST

#
# Enter a valid park location attribute to restore
#

TEST "Enter a valid park location attribute to restore"
# FATAL

DESC "Restore park location attribute to 1"
PUTVAL mskParkingSpot "1"
OUTPUT *Assembly.C*Assembly.C* 1*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *accept*

DESC "Initialize mask assembly"

PUTVAL mskMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# Do an update to get current info
#

# Now is the best time to test the stop-during-update thing

TEST "Stopping UPDATE sequence in progress
FATAL

DESC "Test STOP during update sequence"

PUTVAL mskMode "6"
OUTPUT *MODE*MODE*UPDATE*

CMD "startCommand cmdDir cmdAck cmdAction"
OUTPUT *Started*
CMD "sleep 1"
OUTPUT *

CMD "checkState cmdState UPDATING"
OUTPUT *Success*

GETVAL cmdAction
OUTPUT *VAL*BUSY*

CMD "sleep 1"
OUTPUT *
CMD "compareField sadState cmdState"
OUTPUT *Equal*

CMD "stopCommand cmdDir cmdAck"
OUTPUT *Stopping*

CMD "finishCommand cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
#FATAL

DESC "Mask assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Mask assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC " Mask location in-cassette?"

GETVAL sadLocation
OUTPUT *VAL*

ENDTEST

#
# Do the UPDATE and don't stop it
#

TEST "Do an UPDATE and allow it to complete"
FATAL

DESC "Update sequence"

PUTVAL mskMode "6"
OUTPUT *MODE*UPDATE*MODE*UPDATE*

CMD "startCommand cmdDir cmdAck cmdAction"
OUTPUT *Started*
CMD "sleep 1"
OUTPUT *

CMD "checkState cmdState UPDATING"
OUTPUT *Success*

CMD "finishCommand cmdAction"
OUTPUT *Success*

ENDTEST

