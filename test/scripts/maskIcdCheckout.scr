#
# Mess up a re-load by moving the gripper first
#

TEST "Mess up a re-load by moving the gripper first"
FATAL

DESC "Move gripper between grip and release positions"

PUTVAL gripMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL gripTarget "-15.0"
OUTPUT *VAL*

CMD "deviceCommand gripDir gripAck gripBusy"
OUTPUT *Success*
CMD "sleep 1"
OUTPUT *

DESC "Verify grip position"
GETVAL sadGripper
OUTPUT *VAL* 0*

ENDTEST

