OUTPUT *VAL*GOOD*

DESC " Mask location in-cassette?"

GETVAL sadLocation
OUTPUT *VAL* 1*

ENDTEST

#
# Insert the first mask found (should be an IFU!)
#

TEST "Insert first mask from lookup table - an IFU"
FATAL

DESC "Loading first mask"

CMD "getFirstMaskId mskSelect /gemini/epics3.13.4/gmos/gmos/data/msk.lut"
OUTPUT *Success*

PUTVAL mskMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL mskLocation "0"
OUTPUT *B* 0*

CMD "startCommand cmdDir cmdAck cmdAction"
OUTPUT *Started*
CMD "sleep 1"
OUTPUT *

CMD "checkState cmdState MOVING"
OUTPUT *Success*

CMD "sleep 1"
OUTPUT *

CMD "compareField sadState cmdState"
OUTPUT *Equal*

CMD "finishCommand cmdAction"
OUTPUT *Success*

ENDTEST

