#
# DHS Test Commander
# Checkout script for:
#     ICD 1.9.d.4/1.9.d.5
# "Gmos Components Controller to GMOS Sequencer"
#
#    Mask Assembly ICD compliance checkout
#


#
# First get all those funky variables sorted out
#

VAR   preFpIcd     maskDirective           cmdDir               1

VAR   preFpIcd     maskMode                mskMode              1
VAR   preFpIcd     maskTarget              mskSelect            1
VAR   preFpIcd     maskLocation            mskLocation          1
VAR   preFpIcd     maskPark                mskParkingSpot       1

VAR   preFpIcd     maskAcknowledge         cmdAck               1
VAR   preFpIcd     maskBusy                cmdAction            1
VAR   preFpIcd     maskMessage             cmdError             1
VAR   preFpIcd     maskState               cmdState             1

VAR   preFpIcd     maskCarMess             mskCarMsg            1
VAR   preFpIcd     maskCarErr              mskCarErr            1

VAR   preFpIcd     sadMaskLoadId           sadSelect            1
VAR   preFpIcd     sadMaskLocation         sadLocation          1

VAR   preFpIcd     sadMaskInitialized      sadInit              1
VAR   preFpIcd     sadMaskIndexed          sadIndex             1
VAR   preFpIcd     sadMaskParked           sadPark              1
VAR   preFpIcd     sadMaskHealth           sadHealth            1
VAR   preFpIcd     sadMaskFP               sadInFp              1

VAR   preFpIcd     sadMaskState            sadState             1

VAR   preFpIcd     sadMaskGripper          sadGripper           1
VAR   preFpIcd     sadMaskRelease          sadRelease           1

VAR   preFpIcd     sadMaskDebug            sadDebug             1
VAR   preFpIcd     sadMaskSimulate         sadSimm              1

VAR   gripDevice   devDir                  gripDir              1
VAR   gripDevice   devMode                 gripMode             1
VAR   gripDevice   devTarget               gripTarget           1
VAR   gripDevice   devNamedTarget          gripNamedTarget      1
VAR   gripDevice   devAck                  gripAck              1
VAR   gripDevice   devBusy                 gripBusy             1 
VAR   gripDevice   devMess                 gripMess             1

VAR   extractorDevice   devPosition        extractorPosition    1

#
# Rock and roll
#



#
# Start with mask assembly setup functions
#

TEST "Test Initialization function"
FATAL

DESC "Initializing mask assembly"

PUTVAL mskMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

ENDTEST

#
# Test index function
#

TEST "Test Index Function"
FATAL

DESC "Indexing Mask Assembly"

PUTVAL mskMode "3"
OUTPUT *MODE*INIT*MODE*INDEX*

CMD "startCommand cmdDir cmdAck cmdAction"
OUTPUT *Started*

CMD "checkState cmdState INDEXING"
OUTPUT *Success*

GETVAL cmdAction
OUTPUT *VAL*BUSY*

CMD "sleep 1"
OUTPUT *

CMD "compareField sadState cmdState"
OUTPUT *Equal*

CMD "finishCommand cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Mask assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC "Gripper released?"

GETVAL sadGripper
OUTPUT *VAL* 1*

DESC "Release locked?"

GETVAL sadRelease
OUTPUT *VAL* -1*

DESC "Focal plane empty?"

GETVAL sadInFp
OUTPUT *VAL* 0*

ENDTEST

#
# Testing the Assembly
#

TEST "Execute the Test Function"
FATAL

DESC "Testing assembly"

PUTVAL mskMode "5"
OUTPUT *MODE*MODE*TEST*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# Check resulting status fields...
#
TEST "Verify status fields"
FATAL

DESC "Mask assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Mask assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

ENDTEST

#
# Try entering invalid mask ID attribute
#

TEST "Try entering invalid mask ID attribute"
FATAL

DESC "Initialize mask assembly"

PUTVAL mskMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

DESC "Set mask mode to MOVE"
PUTVAL mskMode "1"
OUTPUT *MODE*INIT*MODE*MOVE*

DESC "Ensure mask location is IN otherwise ID is ignored"
PUTVAL mskLocation "0"
OUTPUT *Assembly.B*Assembly.B*0*

DESC "Load mask ID attribute with -1"
PUTVAL mskSelect "-1"
OUTPUT *Assembly.A*Assembly.A*-1*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *reject*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Barcode invalid - out of range'"
GETVAL cmdError
OUTPUT *Barcode invalid - out of range*

ENDTEST

#
# Restore with valid mask ID attribute
#

TEST "Restore with valid mask ID attribute"
# FATAL

CMD "getFirstMaskId mskSelect /gemini/epics3.13.4/gmos/gmos/data/msk.lut"
OUTPUT *Success*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *accept*

ENDTEST

#
# Try entering another invalid mask ID attribute
#

TEST "Try entering another invalid mask ID attribute"
FATAL

DESC "Load mask ID attribute with 999999"
PUTVAL mskSelect "999999"
OUTPUT *Assembly.A*Assembly.A*999999*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *reject*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'This mask is not installed'"
GETVAL cmdError
OUTPUT *This mask is not installed*

ENDTEST

#
# Enter a valid mask ID attribute to restore
#

TEST "Enter a valid mask ID attribute to restore"
# FATAL

CMD "getFirstMaskId mskSelect /gemini/epics3.13.4/gmos/gmos/data/msk.lut"
OUTPUT *Success*
  
DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *accept*

ENDTEST

#
# Try entering an invalid mask location attribute
#

TEST "Try entering an invalid mask location attribute"
FATAL

DESC "Initialize mask assembly"

PUTVAL mskMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

DESC "Set mask mode to MOVE"
PUTVAL mskMode "1"
OUTPUT *MODE*INIT*MODE*MOVE*

DESC "Load mask location attribute with -1"
PUTVAL mskLocation "-1"
OUTPUT *Assembly.B*Assembly.B*-1*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *reject*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Invalid mask location'"
GETVAL cmdError
OUTPUT *Invalid mask location \[0 \| 1\]*

ENDTEST

