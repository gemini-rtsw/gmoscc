FATAL

DESC "Load mask location attribute with 2"
PUTVAL mskLocation "2"
OUTPUT *Assembly.B*Assembly.B* 2*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *reject*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Invalid mask location'"
GETVAL cmdError
OUTPUT *Invalid mask location \[0 \| 1\]*

ENDTEST

#
# Enter a valid mask location attribute to restore
#

TEST "Enter a valid mask location attribute to restore"
# FATAL

DESC "Restore mask location attribute to 0"
PUTVAL mskLocation "0"
OUTPUT *Assembly.B*Assembly.B* 0*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *accept*

ENDTEST

#
# Try entering an invalid park location attribute
#

TEST "Try entering an invalid park location attribute"
FATAL

DESC "Initialize mask assembly"

PUTVAL mskMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

DESC "Set mask mode to PARK"
PUTVAL mskMode "4"
OUTPUT *MODE*INIT*MODE*PARK*

DESC "Load park location attribute with -1"
PUTVAL mskParkingSpot "-1"
OUTPUT *Assembly.C*Assembly.C*-1*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *reject*

ENDTEST

