DESC "Restore park location attribute to 1"
PUTVAL mskParkingSpot "1"
OUTPUT *Assembly.C*Assembly.C* 1*

DESC "Check command with PRESET directive"
CMD "presetCommand cmdDir cmdAck"
OUTPUT *accept*

ENDTEST

#
# Try entering another invalid park location attribute
#

TEST "Try entering another invalid park location attribute"
FATAL

DESC "Load park location attribute with 4"
PUTVAL mskParkingSpot "4"
OUTPUT *Assembly.C*Assembly.C* 4*

DESC "Check command with PRESET directive"
