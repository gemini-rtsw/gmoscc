OUTPUT *VAL*GOOD*

DESC "Gripper gripped?"

GETVAL sadGripper
OUTPUT *VAL* -1*

DESC "Release released?"

GETVAL sadRelease
OUTPUT *VAL* 1*

DESC "Focal plane occupied with IFU?"

GETVAL sadInFp
OUTPUT *VAL* -1*

ENDTEST

