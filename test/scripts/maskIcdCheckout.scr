#

TEST "Start to load 1st mask then stop it"
FATAL

DESC "STOP issued during mask change"

CMD "getFirstMaskId mskSelect /gemini/epics3.13.4/gmos/gmos/data/msk.lut"
OUTPUT *Success*

PUTVAL mskMode "1"
OUTPUT *MODE*MOVE*MODE*MOVE*

