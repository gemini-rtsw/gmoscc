OUTPUT *

CMD "getGratingId gratId /gemini/epics3.13.4/gmos/gmos/data/gr.lut 4"
OUTPUT *Success*

PUTVAL gratTilt "81.4"
OUTPUT *

PUTVAL grMode "1"
OUTPUT *MODE*MOVE*MODE*MOVE*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# Wait for one second after the command finishes, then check the grating assembly 
