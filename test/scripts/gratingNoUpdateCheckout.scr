#
# Go back to grating 1 - select only this time.
#

TEST "Go back to first grating (1) - select only"
FATAL

DESC "Moving Grating Assembly"

PUTVAL grSelectOnly "1"
OUTPUT *

CMD "getGratingId gratId /gemini/epics3.13.4/gmos/gmos/data/gr.lut 1"
OUTPUT *Success*

PUTVAL grMode "1"
OUTPUT *MODE*MOVE*MODE*MOVE*

DESC "Start time"
CMD "date"
OUTPUT *

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

DESC "Finish time"
CMD "date"
OUTPUT *

ENDTEST

#
# Wait for one second after the command finishes, then check the grating assembly 
# status and SAD. The original angle tilt requested for grating 1 should be restored
# in the SAD.
#

TEST "Verify status fields"
FATAL

DESC "Grating assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Grating assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Grating assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Grating assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC "Grating assembly in position?"

GETVAL grInpos
OUTPUT *VAL*0001*

DESC "Correct grating and tilt in SAD?"

CMD "compareField sadId gratId
OUTPUT *Equal*

GETVAL sadInBeam
OUTPUT *VAL* 1*

GETVAL sadTilt
OUTPUT *VAL* 31.2*

ENDTEST

