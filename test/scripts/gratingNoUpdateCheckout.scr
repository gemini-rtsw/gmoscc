#
# Select a non-existent grating and check this fails.
#

TEST "Select a non-existent grating"
FATAL

DESC "Select a non-existent grating"

PUTVAL grSelectOnly "0"
OUTPUT *

PUTVAL gratId "39999999"
OUTPUT *

DESC "Verify command is rejected by a PRESET"

PUTVAL grMode "1"
OUTPUT *MODE*MOVE*MODE*MOVE*

CMD "presetCommand cmdDir cmdAck"
OUTPUT *reject*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Requested grating not installed'"
GETVAL cmdError
OUTPUT *Requested grating not installed*

ENDTEST

#
# Select an out of (high) range grating angle and check this fails.
#

TEST "Select an out of (high) range grating angle"
FATAL

DESC "Select an out of (high) range grating angle"

PUTVAL grSelectOnly "0"
OUTPUT *

CMD "getGratingId gratId /gemini/epics3.13.4/gmos/gmos/data/gr.lut 4"
OUTPUT *Success*

PUTVAL gratTilt "99.9"
OUTPUT *

DESC "Verify command is rejected by a PRESET"

PUTVAL grMode "1"
OUTPUT *MODE*MOVE*MODE*MOVE*

CMD "presetCommand cmdDir cmdAck"
OUTPUT *reject*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Grating tilt angle out of range'"
GETVAL cmdError
OUTPUT *Grating tilt angle out of range*

ENDTEST

#
# Select an out of (low) range grating angle and check this fails.
#

TEST "Select an out of (low) range grating angle"
FATAL

DESC "Select an out of (low) range grating angle"

PUTVAL gratTilt "-10.1"
OUTPUT *

DESC "Verify command is rejected by a PRESET"

PUTVAL grMode "1"
OUTPUT *MODE*MOVE*MODE*MOVE*

CMD "presetCommand cmdDir cmdAck"
OUTPUT *reject*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Grating tilt angle out of range'"
GETVAL cmdError
OUTPUT *Grating tilt angle out of range*

ENDTEST

#
# Reindex the grating assembly
#

TEST "Repeat Index Function"
FATAL

DESC "Restoring the grating tilt"

PUTVAL gratTilt "0.0"
OUTPUT *

DESC "Reindexing Grating Assembly"

PUTVAL grMode "3"
OUTPUT *MODE*MOVE*MODE*INDEX*

DESC "Start time"
CMD "date"
OUTPUT *

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

DESC "Finish time"
CMD "date"
OUTPUT *

ENDTEST

#
# Wait for one second after the command finishes, then check that the grating assembly 
# indexed flag has been set, the initialised flag is still set, the grating assembly
# and grating CAR records have both gone idle, and the health is still GOOD.
#

TEST "Verify status fields"
FATAL

DESC "Grating assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Grating assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Grating assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Grating assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC "No grating in the beam?"

GETVAL sadId
OUTPUT *VAL* -1*

GETVAL sadInBeam
OUTPUT *VAL* 0*

GETVAL sadTilt
OUTPUT *VAL* -0*

ENDTEST

#
# Test for failure of the grating assembly initialisation function
# when it is given a garbage file.
#

TEST "Test initialization function with garbage LUT file"
FATAL

DESC "Initializing grating assembly with garbage LUT file"

PUTVAL grLutFile "garbage.lut"
OUTPUT *TFIL *TFIL * garbage.lut*

PUTVAL grMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Command Failed*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Incorrect barcode file type'"
GETVAL cmdError
OUTPUT *Incorrect barcode file type*

ENDTEST

#
# Wait for one second after the command finishes, then check that the grating assembly 
# initialisation flag is still unset and the health is WARNING.
#

TEST "Verify status fields"
FATAL

DESC "Grating assembly initialized?"

CMD "sleep 1"
OUTPUT *
GETVAL sadInit
OUTPUT *VAL* 0*

DESC "Grating assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Grating assembly health WARNING?"

GETVAL sadHealth
OUTPUT *VAL*WARNING*

ENDTEST


#
# Change lookup table name back as it was
#

TEST "Change lookup table name back as it was"
FATAL

DESC "Reset the LUT filename"
PUTVAL grLutFile "gr.lut"
OUTPUT *TFIL *TFIL * gr.lut*

ENDTEST


#
# Restore the grating assembly by reinitialising
#

TEST "Initialize properly to restore grating assembly"
FATAL

DESC "Initializing grating assembly properly"

PUTVAL grMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# Wait for one second after the command finishes, then check that the grating assembly 
# initialisation flag has been set, the grating assembly and grating CAR records have
# both gone idle, and the health has changed to GOOD.
#

TEST "Verify status fields"
FATAL

DESC "Grating assembly initialized?"

CMD "sleep 1"
OUTPUT *
GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Grating assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Grating assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

ENDTEST

#
# Finally, park the Assembly
#

TEST "Test parking function"
FATAL

DESC "Parking assembly"

PUTVAL grMode "4"
OUTPUT *MODE*INIT*MODE*PARK*

CMD "startCommand cmdDir cmdAck cmdAction"
OUTPUT *Started*

CMD "sleep 1"
OUTPUT *
CMD "checkState cmdState MOVING"
OUTPUT *Success*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

CMD "finishCommand cmdAction"
OUTPUT *Success*

ENDTEST

