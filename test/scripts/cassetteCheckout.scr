#
# DHS Test Commander
# Cassette device functionality test script
#

#
# Do the variable substitution thing....
#

# Device INPUTS
VAR     cassetteDevice  devDir                  devDir	            1
VAR     cassetteDevice  devMode                 devMode             1
VAR     cassetteDevice  devTarget               devTarget           1
VAR     cassetteDevice  devNamedTarget          devNamedTarget      1
VAR     cassetteDevice  devIndexType            devIndexType        1
VAR     cassetteDevice  devDbug                 devDbug             1
VAR     cassetteDevice  devSimm                 devSimm             1
VAR     cassetteDevice  devMinPosition          devMinPosition      1
VAR     cassetteDevice  devMaxPosition          devMaxPosition      1
VAR     cassetteDevice  devVelocity             devVelocity         1
VAR     cassetteDevice  devMinVelocity          devMinVelocity      1
VAR     cassetteDevice  devMaxVelocity          devMaxVelocity      1
VAR     cassetteDevice  devAcceleration         devAcceleration     1
VAR     cassetteDevice  devLutFile              devLutFile          1
VAR     cassetteDevice  devLutDirectory         devLutDirectory     1
VAR     cassetteDevice  devDevType              devDevType          1
VAR     cassetteDevice  devEgu                  devEgu              1
VAR     cassetteDevice  devMotorRes             devMotorRes         1
VAR     cassetteDevice  devMotionDeadBand       devMotionDeadBand   1
VAR     cassetteDevice  devBaseVelo             devBaseVelo         1
VAR     cassetteDevice  devUsePwrStatus         devUsePwrStatus     1
VAR     cassetteDevice  devPwrStatusTimeout     devPwrStatusTimeout 1
VAR     cassetteDevice  devPower                devPower            1
VAR     cassetteDevice  devUseBrkStatus         devUseBrkStatus     1
VAR     cassetteDevice  devBrkStatusTimeout     devBrkStatusTimeout 1
VAR     cassetteDevice  devBrake                devBrake            1
VAR     cassetteDevice  devUseAuxPwr            devUseAuxPwr        1
VAR     cassetteDevice  devUseEncoder           devUseEncoder       1
VAR     cassetteDevice  devEncoderRes           devEncoderRes       1
VAR     cassetteDevice  devEncoderDeadBand      devEncoderDeadBand  1

# Device OUPUTS
VAR     cassetteDevice  devPosition             devPosition         1
VAR     cassetteDevice  devRawPosition          devRawPosition      1
VAR     cassetteDevice  devAck                  devAck              1
VAR     cassetteDevice  devBusy                 devBusy             1
VAR     cassetteDevice  devState                devState            1
VAR     cassetteDevice  devMess                 devMess             1
VAR     cassetteDevice  devIndexed              devIndexed          1
VAR     cassetteDevice  devLimited              devLimited          1

#
# Is it safe to proceed?
#

PROMPT "Read the assumptions.  Is it safe to move the cassette?"

#
# Verify startup state
#

TEST "Verify startup state"
FATAL

DESC "Verify startup state"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Log the current device record configuration
#
TEST "Log the current device record configuration"
FATAL

DESC "Get deviceControl record device layer type"
GETVAL devDevType
OUTPUT *.DTYP*DEV CTL OMS 8/44*

DESC "Get simulation level"
GETVAL devSimm
OUTPUT *.SIMM*NONE*

DESC "Get debug level"
GETVAL devDbug
OUTPUT *.DBUG*

DESC "Get enginering units"
GETVAL devEgu
OUTPUT *.EGU*mm*

DESC "Get motor resolution, in microsteps per EGU"
GETVAL devMotorRes
OUTPUT *.MRES*

DESC "Get motion deadband"
GETVAL devMotionDeadBand
OUTPUT *.MDBD*

DESC "Get upper target limit, max EGU target allowed"
GETVAL devMaxPosition
OUTPUT *.PHLM*

DESC "Get lower target limit, min EGU target allowed"
GETVAL devMinPosition
OUTPUT *.PLLM*

DESC "Get motion velocity"
GETVAL devVelocity
OUTPUT *.VELO*

DESC "Get upper velocity limit, max EGU velocity allowed"
GETVAL devMaxVelocity
OUTPUT *.VHLM*

DESC "Get lower velocity limit, min EGU velocity allowed"
GETVAL devMinVelocity
OUTPUT *.VLLM*

DESC "Get motion startup velocity"
GETVAL devBaseVelo
OUTPUT *.VBAS*

DESC "Get acceleration, VBAS to VELO in EGUs per second per second"
GETVAL devAcceleration
OUTPUT *.ACCL*

DESC "Get the indexing algorithm number"
GETVAL devIndexType
OUTPUT *.IALG* LOWHOME*

DESC "Using Power status?"
GETVAL devUsePwrStatus
OUTPUT *.UPSB* YES*
# Comment out check on UPSB until power status electronics problem fixed
#OUTPUT *.UPSB*

DESC "Get the power status timeout"
GETVAL devPwrStatusTimeout
OUTPUT *.PTMO*

DESC "Using Brake status?"
GETVAL devUseBrkStatus
OUTPUT *.UBSB* NO*

DESC "Get the brake status timeout"
GETVAL devBrkStatusTimeout
OUTPUT *.BTMO*

DESC "Using AUX to enable drives?"
GETVAL devUseAuxPwr
OUTPUT *.UAPB* YES*

DESC "Using Encoder?"
GETVAL devUseEncoder
OUTPUT *.UEIP* NO*

DESC "Get encoder resolution in counts per EGU"
GETVAL devEncoderRes
OUTPUT *.ERES*

DESC "Get encoder deadband"
GETVAL devEncoderDeadBand
OUTPUT *.EDBD*

DESC "Get lookup table name"
GETVAL devLutFile
OUTPUT *.TFIL* mskCas.lut*

DESC "Get lookup table directory name"
GETVAL devLutDirectory
OUTPUT *.TDIR*

ENDTEST

#
# First try to initialize the device control record
#

TEST "Test cassette device INIT mode"
FATAL

DESC "Initializing cassette"

PUTVAL devMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

ENDTEST

#
# Test cassette device TEST mode
#

TEST "Test cassette device TEST mode"
FATAL

DESC "Testing cassette"

PUTVAL devMode "5"
OUTPUT *MODE*MODE*TEST*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

ENDTEST

#
# Test limit switch by indexing on 
# lower soft limit switch
#

TEST "Testing lower limit switch"
FATAL

DESC "Testing lower limit switch"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devNamedTarget "i4"
OUTPUT *.VALS*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Test limit switch by indexing on 
# upper soft limit switch
#

TEST "Testing upper limit switch"
FATAL

DESC "Testing upper limit switch"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devNamedTarget "i5"
OUTPUT *

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Then try to index the device
#

TEST "Test indexing cassette"
FATAL

DESC "Indexing cassette"

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Try a named position move 
#

TEST "Try a named position move"
FATAL

DESC "Try a named position move" 

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devNamedTarget "c1s1"
OUTPUT *.VALS*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Verify current position
#

TEST "Verify current position"
FATAL

DESC "Verify current position"

GETVAL devTarget
OUTPUT *.VAL* 

CMD "compareField devTarget devPosition
OUTPUT *Equal* 

ENDTEST

#
# Try another named position move
#

TEST "Try another named position move"
FATAL

DESC "Try another named position move" 

PUTVAL devNamedTarget "c3s7"
OUTPUT *

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Verify current position
#

TEST "Verify current position"
FATAL

DESC "Verify current position"

GETVAL devTarget
OUTPUT *.VAL* 

CMD "compareField devTarget devPosition
OUTPUT *Equal* 

ENDTEST

#
# Adjust upper and lower target limits to allow moves beyond limits
#

TEST "Adjust upper and lower target limits"
FATAL

DESC "Adjust upper and lower target limits"

PUTVAL devMinPosition "-31"
OUTPUT *.PLLM*

PUTVAL devMaxPosition "301"
OUTPUT *.PHLM*

ENDTEST

#
# Check distance from home to upper limit position
#

TEST "Attempting to move cassette past upper limit"
FATAL

DESC "Moving cassette"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devTarget "300"
OUTPUT *VAL*VAL* 300*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Failed*

ENDTEST

#
# Verify error message and log current position
#

TEST "Verify error message and log current position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* ERROR* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

GETVAL devMess
OUTPUT *.MESS*Device hit a soft limit*

GETVAL devPosition
OUTPUT *.MPOS*

GETVAL devRawPosition
OUTPUT *.RRBV*

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Index the device to get back to normal
#

TEST "Indexing cassette"
FATAL

DESC "Indexing cassette"

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Check distance from home to lower limit position
#

TEST "Attempting to move cassette past lower limit"
FATAL

DESC "Moving cassette"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devTarget "-30"
OUTPUT *VAL*VAL* -30*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Failed*

ENDTEST

#
# Verify error message and log current position
#

TEST "Verify error message and log current position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* ERROR* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

GETVAL devMess
OUTPUT *.MESS*Device hit a soft limit*

GETVAL devPosition
OUTPUT *.MPOS*

GETVAL devRawPosition
OUTPUT *.RRBV*

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Index the device to get back to normal
#

TEST "Indexing cassette"
FATAL

DESC "Indexing cassette"

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Now park it
#

TEST "Testing park position"
FATAL

DESC "Move to the PARK position" 

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devNamedTarget "park"
OUTPUT *VALS*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Log current position
#

TEST "Verify current position"
FATAL

DESC "Verify current position"

GETVAL devTarget
OUTPUT *.VAL* 

CMD "compareField devTarget devPosition
OUTPUT *Equal* 

ENDTEST

#
#  All cassette functions check out OK!
#

COMMENT "Cassette checks out OK - please reboot when tests are complete"
 
