#
# DHS Test Commander
# Grating cell A device functionality test script
#

#
# Define the variables used in this script, and the configuration files
# which contain their translation into EPICS channel names.
#
#       Config file        Config file name        Named used here     Mystery number
#       -----------        ---------------------   -----------------   --------------

# Device INPUTS
VAR     gratingADevice      devDir                  devDir	        1
VAR     gratingADevice      devMode                 devMode             1
VAR     gratingADevice      devTarget               devTarget           1
VAR     gratingADevice      devNamedTarget          devNamedTarget      1
VAR     gratingADevice      devIndexType            devIndexType        1
VAR     gratingADevice      devDbug                 devDbug             1
VAR     gratingADevice      devSimm                 devSimm             1
VAR     gratingADevice      devMinPosition          devMinPosition      1
VAR     gratingADevice      devMaxPosition          devMaxPosition      1
VAR     gratingADevice      devBacklash             devBacklash         1
VAR     gratingADevice      devRounding             devRounding         1
VAR     gratingADevice      devVelocity             devVelocity         1
VAR     gratingADevice      devMinVelocity          devMinVelocity      1
VAR     gratingADevice      devMaxVelocity          devMaxVelocity      1
VAR     gratingADevice      devAcceleration         devAcceleration     1
VAR     gratingADevice      devLutFile              devLutFile          1
VAR     gratingADevice      devLutDirectory         devLutDirectory     1
VAR     gratingADevice      devDevType              devDevType          1
VAR     gratingADevice      devEgu                  devEgu              1
VAR     gratingADevice      devMotorRes             devMotorRes         1
VAR     gratingADevice      devMotionDeadBand       devMotionDeadBand   1
VAR     gratingADevice      devBaseVelo             devBaseVelo         1
VAR     gratingADevice      devFinalIndexVelo       devFinalIndexVelo   1
VAR     gratingADevice      devUsePwrStatus         devUsePwrStatus     1
VAR     gratingADevice      devPwrStatusTimeout     devPwrStatusTimeout 1
VAR     gratingADevice      devPower                devPower            1
VAR     gratingADevice      devUseBrkStatus         devUseBrkStatus     1
VAR     gratingADevice      devBrkStatusTimeout     devBrkStatusTimeout 1
VAR     gratingADevice      devBrake                devBrake            1
VAR     gratingADevice      devUseAuxPwr            devUseAuxPwr        1
VAR     gratingADevice      devUseEncoder           devUseEncoder       1
VAR     gratingADevice      devEncoderRes           devEncoderRes       1
VAR     gratingADevice      devEncoderDeadBand      devEncoderDeadBand  1

# Device OUTPUTS
VAR     gratingADevice      devPosition             devPosition         1
VAR     gratingADevice      devRawPosition          devRawPosition      1
VAR     gratingADevice      devAck                  devAck              1
VAR     gratingADevice      devBusy                 devBusy             1
VAR     gratingADevice      devState                devState            1
VAR     gratingADevice      devMess                 devMess             1
VAR     gratingADevice      devIndexed              devIndexed          1
VAR     gratingADevice      devLimited              devLimited          1

#
# Is it safe to proceed?
#

PROMPT "Read the assumptions.  Is it safe to move the grating cells?"

#
# Verify startup state. The device should be unindexed, stopped and unpowered.
#

TEST "Verify startup state"
FATAL

DESC "Verify startup state"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Log the current device record configuration
#
TEST "Log the current device record configuration"
FATAL

DESC "Get deviceControl record device layer type"
GETVAL devDevType
OUTPUT *.DTYP*DEV CTL OMS 8/44*

DESC "Get simulation level - script cannot work in simulation mode"
DESC "It relies on getting feedback from limit switches and power status"
GETVAL devSimm
OUTPUT *.SIMM*NONE*

DESC "Get debug level"
GETVAL devDbug
OUTPUT *.DBUG*

DESC "Get enginering units"
GETVAL devEgu
OUTPUT *.EGU*

DESC "Get motor resolution, in microsteps per EGU"
GETVAL devMotorRes
OUTPUT *.MRES*

DESC "Get motion deadband"
GETVAL devMotionDeadBand
OUTPUT *.MDBD*

DESC "Get upper target limit, max EGU target allowed"
GETVAL devMaxPosition
OUTPUT *.PHLM*

DESC "Get lower target limit, min EGU target allowed"
GETVAL devMinPosition
OUTPUT *.PLLM*

DESC "Get motion velocity"
GETVAL devVelocity
OUTPUT *.VELO*

DESC "Get upper velocity limit, max EGU velocity allowed"
GETVAL devMaxVelocity
OUTPUT *.VHLM*

DESC "Get lower velocity limit, min EGU velocity allowed"
GETVAL devMinVelocity
OUTPUT *.VLLM*

DESC "Get motion startup velocity"
GETVAL devBaseVelo
OUTPUT *.VBAS*

DESC "Get final indexing velocity"
GETVAL devFinalIndexVelo
OUTPUT *.FIVL*

DESC "Get acceleration, VBAS to VELO in EGUs per second per second"
GETVAL devAcceleration
OUTPUT *.ACCL*

DESC "Get backlash correction in motor steps"
GETVAL devBacklash
OUTPUT *.BLCO*

DESC "Get motor position rounding in motor steps"
GETVAL devRounding
OUTPUT *.MRND*

DESC "Get the indexing algorithm number - should be 4 for grating cells"
GETVAL devIndexType
OUTPUT *.IALG* 4*

DESC "Using Power status? Should be YES for grating cells"
GETVAL devUsePwrStatus
#OUTPUT *.UPSB* YES* - set to NO whilst power status problems examined
OUTPUT *.UPSB* NO*

DESC "Get the power status timeout"
GETVAL devPwrStatusTimeout
OUTPUT *.PTMO*

DESC "Using Brake status? Should be NO for grating cells"
GETVAL devUseBrkStatus
OUTPUT *.UBSB* NO*

DESC "Get the brake status timeout - should be zero for grating cells"
GETVAL devBrkStatusTimeout
OUTPUT *.BTMO* 0*

DESC "Using AUX to enable drives?"
GETVAL devUseAuxPwr
OUTPUT *.UAPB* YES*

DESC "Using Encoder? Should be NO for grating cells"
GETVAL devUseEncoder
OUTPUT *.UEIP* NO*

DESC "Get encoder resolution in counts per EGU"
GETVAL devEncoderRes
OUTPUT *.ERES*

DESC "Get encoder deadband"
GETVAL devEncoderDeadBand
OUTPUT *.EDBD*

DESC "Get lookup table name"
GETVAL devLutFile
OUTPUT *.TFIL* grA.lut*

DESC "Get lookup table directory name"
GETVAL devLutDirectory
OUTPUT *.TDIR*

ENDTEST

#
# First try to initialize the device control record
#

TEST "Test grating cell A device INIT mode"
FATAL

DESC "Initializing grating cell A"

PUTVAL devTarget "0"
OUTPUT *VAL*VAL* 0*

PUTVAL devMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

ENDTEST

#
# Test grating cell A device TEST mode
#

TEST "Test grating cell A device TEST mode"
FATAL

DESC "Testing grating cell A"

PUTVAL devMode "5"
OUTPUT *MODE*MODE*TEST*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

ENDTEST

#
# Test lower limit switch by indexing on lower soft limit
#

TEST "Testing lower limit switch"
FATAL

DESC "Testing lower limit switch"

PUTVAL devIndexType "4"
OUTPUT *

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Test full travel and upper limit switch by indexing on 
# upper soft limit switch
#

TEST "Testing upper limit switch"
FATAL

DESC "Testing upper limit switch"

PUTVAL devIndexType "5"
OUTPUT *

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

DESC "Start time"
CMD "date"
OUTPUT *

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

DESC "Finish time"
CMD "date"
OUTPUT *

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Change indexing mode back to lower limit switch
#

TEST "Restore original indexing mode"
FATAL

PUTVAL devIndexType "4"
OUTPUT *

ENDTEST

#
# Index the device to get back to normal
#

TEST "Indexing grating cell A"
FATAL

DESC "Indexing grating cell A"

PUTVAL devTarget "0"
OUTPUT *VAL*VAL* 0*

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command and check current position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

DESC "Check index position is zero"
GETVAL devPosition
OUTPUT *.MPOS* 0* 

GETVAL devRawPosition
OUTPUT *.RRBV* 0* 

ENDTEST

#
# Adjust upper and lower target limits to allow moves beyond limits
#

TEST "Adjust upper and lower target limits"
FATAL

DESC "Adjust upper and lower target limits"

PUTVAL devMinPosition "-100.0"
OUTPUT *.PLLM*

PUTVAL devMaxPosition "10000.0"
OUTPUT *.PHLM*

ENDTEST

#
# Check and record the motor position at the upper soft limit.
#

TEST "Deliberately move grating cell A into upper soft limit"
FATAL

DESC "Moving to upper soft limit"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devTarget "9800"
OUTPUT *VAL*VAL* 9800*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Failed*

ENDTEST

#
# Verify error message and log current position
#

TEST "Verify error message and log current position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* ERROR* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

GETVAL devMess
OUTPUT *.MESS*Device hit a soft limit*

GETVAL devPosition
OUTPUT *.MPOS*

GETVAL devRawPosition
OUTPUT *.RRBV*

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Index the device again to get back to normal
#

TEST "Indexing grating cell A"
FATAL

DESC "Indexing grating cell A"

PUTVAL devTarget "0"
OUTPUT *VAL*VAL* 0*

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command and check current position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST


#
# Check allowed position range - lower limit.
#

TEST "Request position well below lower software limit and check response"
FATAL

DESC "Requesting position well below lower limit for grating cell A"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devTarget "-500"
OUTPUT *VAL*VAL* -500*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Command rejected*

ENDTEST

#
# Verify device state and error message
#

TEST "Verify device state and error message"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

DESC "Look for error message 'Target position out of range'"
GETVAL devMess
OUTPUT *.MESS*Target position out of range*

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Check allowed position range - upper limit.
#

TEST "Request position well above upper software limit and check response"
FATAL

DESC "Requesting position well above upper limit for grating cell A"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devTarget "20000"
OUTPUT *VAL*VAL* 20000*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Command rejected*

ENDTEST

#
# Verify device state and error message
#

TEST "Verify device state and error message"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

DESC "Look for error message 'Target position out of range'"
GETVAL devMess
OUTPUT *.MESS*Target position out of range*

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Finally, verify that the grating cell can move to the barcode reading position
#

TEST "Move grating cell A to barcode reading position"
FATAL

DESC "Moving to barcode reading position"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

DESC "Put zero into target position to avoid device control bug"
PUTVAL devTarget "0"
OUTPUT *VAL*VAL* 0*

PUTVAL devNamedTarget "barcode"
OUTPUT *VALS*VALS* barcode*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify error message and log current position
#

TEST "Verify state and log barcode position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

GETVAL devPosition
OUTPUT *.MPOS*

GETVAL devRawPosition
OUTPUT *.RRBV*

ENDTEST

#
#  All grating A functions check out OK!
#

COMMENT "Grating cell A checks out OK - please reboot when tests are complete"


 
