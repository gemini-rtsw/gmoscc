#
# DHS Test Commander
# Checkout script for:
#     
#    Mask Assembly Opto Sensors
#
#  1.  Read assumptions - okay?
#  2.  Check starting point, should be freshly rebooted....
#  3.  Check State of Opto Switches folowing database initialization
#  4.  Enable opto switches and immediately check their states again
#  5.  Sleep then check state of opto switches - Unknown
#  6.  Does the mask sensor screen indicate that there is no cassette 
#      installed, the mask is not in the slot and not aligned?
#  7.  Install cassette #2.  Does the mask sensor screen now indicate 
#      that there is a cassette installed, mask in slot and mask aligned?
#  8.  Check state of opto switches - all affirmative
#  9.  Disable opto switches and immediately check opto switch states again
# 10.  Sleep then check state of opto switches - should be Unknown
# 11.  Enable then immediately check state of opto switches - affirmative
# 12.  Sleep then check state of opto switches - all affirmative
# 13.  Just for fun, initialize the mask assembly, which should disable 
#      the opto sensors to "Unknown" state.
# 14.  Check resulting status fields....
# 15.  Check state of opto switches - should be Unknown
# 16.  Remove the cassette #2 for safety before attempting index.  
#      Are all cassettes now removed?
# 17.  INDEX the mask assembly
# 18.  check resulting status fields....
# 19.  PARK in position two to allow cassette to be re-loaded
# 20.  check resulting status fields....
# 21.  Check state of opto switches - should be Unknown
# 22.  Install cassette #2.  Does the mask sensor screen now indicate 
#      that there is a cassette installed, mask in slot and mask aligned?
# 23.  MOVE the extractor into the "grip" position but don't move the gripper
# 24.  Enable, check state of opto switches - all affirmative - then disable
# 25.  You are about to index the mask.  It should index on the soft 
#      limit at the cassette end before indexing on the home switch at 
#      the other end.  Are you ready to watch the mask index?
# 26.  INDEX the mask assembly
# 27.  check resulting status fields....
# 28.  Did the extractor index on the soft limit at the cassette end 
#      before indexing on the home switch?
# 29.  Check state of opto switches - should be Unknown
# 30.  Loading a mask into the focal plane (last entry in table)
# 31.  check resulting status fields....
# 32.  Verify mask in focal plane
# 33.  Put the mask back into its cassette
# 34.  check resulting status fields....
#

#
# First get all those funky variables sorted out
#

VAR   preFpIcd     maskDirective           cmdDir               1

VAR   preFpIcd     maskMode                mskMode              1
VAR   preFpIcd     maskTarget              mskSelect            1
VAR   preFpIcd     maskLocation            mskLocation          1
VAR   preFpIcd     maskPark                mskParkingSpot       1
VAR   preFpIcd     maskExtFast             mskExtFast           1
VAR   preFpIcd     maskExtSlow             mskExtSlow           1

VAR   preFpIcd     maskAcknowledge         cmdAck               1
VAR   preFpIcd     maskBusy                cmdAction            1
VAR   preFpIcd     maskMessage             cmdError             1
VAR   preFpIcd     maskState               cmdState             1

VAR   preFpIcd     maskCarMess             mskCarMsg            1
VAR   preFpIcd     maskCarErr              mskCarErr            1

VAR   preFpIcd     sadMaskLoadId           sadSelect            1
VAR   preFpIcd     sadMaskLocation         sadLocation          1

VAR   preFpIcd     sadMaskInitialized      sadInit              1
VAR   preFpIcd     sadMaskIndexed          sadIndex             1
VAR   preFpIcd     sadMaskParked           sadPark              1
VAR   preFpIcd     sadMaskHealth           sadHealth            1
VAR   preFpIcd     sadMaskFP               sadInFp              1

VAR   preFpIcd     sadMaskState            sadState             1

VAR   preFpIcd     sadMaskGripper          sadGripper           1
VAR   preFpIcd     sadMaskRelease          sadRelease           1

VAR   preFpIcd     sadMaskDebug            sadDebug             1
VAR   preFpIcd     sadMaskSimulate         sadSimm              1

VAR   maskAssembly assemblyTranslationFile mskLutFile           1
VAR   maskAssembly assemblyTranslationDir  mskLutDir            1

VAR   gripDevice   devDir                  gripDir              1
VAR   gripDevice   devMode                 gripMode             1
VAR   gripDevice   devTarget               gripTarget           1
VAR   gripDevice   devNamedTarget          gripNamedTarget      1
VAR   gripDevice   devAck                  gripAck              1
VAR   gripDevice   devBusy                 gripBusy             1 
VAR   gripDevice   devMess                 gripMess             1

VAR   extractorDevice   devPosition        extPosition          1
VAR   extractorDevice   devDir             extDir               1
VAR   extractorDevice   devMode            extMode              1
VAR   extractorDevice   devTarget          extTarget            1
VAR   extractorDevice   devNamedTarget     extNamedTarget       1
VAR   extractorDevice   devVelocity        extVelocity          1
VAR   extractorDevice   devAck             extAck               1
VAR   extractorDevice   devBusy            extBusy              1
VAR   extractorDevice   devState           extState             1
VAR   extractorDevice   devMess            extMess              1

VAR   maskStatus        lvdtVal            lvdtVal              1
VAR   maskStatus        optSensorVal       optSensorVal         1
VAR   maskStatus        cassetteMissing    cassetteMissing      1
VAR   maskStatus        slotMisaligned     slotMisaligned       1
VAR   maskStatus        slotEmpty          slotEmpty            1

#
# Is it safe to proceed?
#

PROMPT "Read the assumptions.  Is it safe to load a cassette and move the extractor?"

#
# check starting point, should be freshly rebooted....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly not indexed?"
GETVAL sadIndex
OUTPUT *VAL* 0*

DESC "Mask assembly not initialized?"
GETVAL sadInit
OUTPUT *VAL* 0*

DESC "Mask assembly not parked?"
GETVAL sadPark
OUTPUT *VAL* 0*

DESC "Mask assembly WARNING HEALTH"
GETVAL sadHealth
OUTPUT *VAL* WARNING*

DESC "Mask Opto Sensors Disabled"
GETVAL optSensorVal
OUTPUT *VAL* OFF*


ENDTEST


#
# Check State of Opto Switches folowing database initialization
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  Should all be "Unknown" when they are disabled
#

TEST "Check state of the three opto switches - should be Unknown"
FATAL

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* Unknown*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* Unknown*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Unknown*

ENDTEST


#
# Enable opto switches and immediately check their states again
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  Should all still be "Unknown" when they are enabled
#

TEST "Enable then immediately check state of opto switches - still Unknown"
FATAL

DESC "Enable opto switches"
PUTVAL optSensorVal 0
OUTPUT *VAL* OFF* ON* 

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* Unknown*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* Unknown*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Unknown*

ENDTEST

#
# Sleep then check their states again
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  Should all be in the Unknown state by now
#

TEST "Sleep then check state of opto switches - Unknown"
FATAL

CMD "sleep 1"
OUTPUT *

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL*Unknown*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL*Unknown*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL*Unknown*

ENDTEST

#
# Verify on the sensor screen
#

PROMPT "Does the mask sensor screen indicate that there is no cassette installed, the mask is not in the slot and not aligned?"

#
# Install a cassette?
#

PROMPT "Install cassette #2.  Does the mask sensor screen now indicate that there is a cassette installed, mask in slot and mask aligned?"

#
# Check their states again
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  Should all be affirmative now.
#

TEST "Check state of opto switches - all affirmative"
FATAL

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* CassetteInstalled*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* InSlot*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Aligned*

ENDTEST

#
# Disable opto switches and immediately check opto switch states again
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  All will probably go to unknown, but may not if the machine 
#  running these tests is particularly fast.
#

TEST "Disable then immediately check state of opto switches"
FATAL

DESC "Disable opto switches"
PUTVAL optSensorVal 1
OUTPUT *VAL* ON* OFF* 

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* Unknown*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* Unknown*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Unknown*

ENDTEST

#
# Sleep then check opto switch states again
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  Definitely should all be "Unknown" by now.
# 

TEST "Sleep then check state of opto switches - should be Unknown"
FATAL

CMD "sleep 1"
OUTPUT *

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* Unknown*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* Unknown*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Unknown*

ENDTEST



#
# Enable opto switches and immediately check their states again
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  All will probably go to affirmative state, but may not if 
#  the machine running these tests is particularly fast.
#

TEST "Enable then immediately check state of opto switches - affirmative"
FATAL

DESC "Enable opto switches"
PUTVAL optSensorVal 0
OUTPUT *VAL* OFF* ON* 

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* CassetteInstalled*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* InSlot*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Aligned*

ENDTEST

#
# Sleep then check opto switch states again
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#    All should be affirmative.
#

TEST "Sleep then check state of opto switches - all affirmative"
FATAL

CMD "sleep 1"
OUTPUT *

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* CassetteInstalled*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* InSlot*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Aligned*

ENDTEST


#
# Just for fun, initialize the mask assembly
# This should disable the opto sensors to "Unknown" state.
#

TEST "Test Initialization function"
FATAL

DESC "Initializing mask assembly"

PUTVAL mskMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly initialized?"

CMD "sleep 1"
OUTPUT *
GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

ENDTEST

#
# Check opto switch states again
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  Should all be Unknown now.
#

TEST "Check state of opto switches - should be Unknown"
FATAL

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* Unknown*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* Unknown*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Unknown*

ENDTEST

#
#  Remove the cassette for safety before attempting index
#

PROMPT "Remove the cassette #2 for safety before attempting index.  Are all cassettes now removed?"

#
#  INDEX the mask assembly
#

TEST "INDEX the mask assembly"
FATAL

DESC "Indexing Mask Assembly"

PUTVAL mskMode "3"
OUTPUT *MODE*INIT*MODE*INDEX*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

ENDTEST

#
#  PARK in position two to allow cassette to be re-loaded
#

TEST "PARK in position two to allow cassette to be re-loaded"
FATAL

PUTVAL mskMode "4"
OUTPUT *MODE*MODE*PARK*

PUTVAL mskParkingSpot "2"
OUTPUT *C*C* 2*

DESC "Parking Mask Assembly at position two"
CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly parked?"
CMD "sleep 1"
OUTPUT *
GETVAL sadPark
OUTPUT *VAL* 1*
 
DESC "Mask assembly indexed?"

GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Mask assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

ENDTEST


#
# Check opto switch states
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  Should all be Unknown.
#

TEST "Enable then check state of opto switches - should be Unknown"
FATAL

DESC "Enable opto switches"
PUTVAL optSensorVal 0
OUTPUT *VAL* OFF* ON* 

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* Unknown*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* Unknown*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Unknown*

ENDTEST

#
#  Install cassette #2 (loaded full of masks)
#

PROMPT "Install cassette #2.  Does the mask sensor screen now indicate that there is a cassette installed, mask in slot and mask aligned?"

#
#  MOVE the extractor into the "grip" position
#  but don't move the gripper
#

TEST "MOVE the extractor into the "grip" position but don't move the gripper"
FATAL

DESC "Move extractor to grip position"
PUTVAL extNamedTarget "grip"
OUTPUT *VALS* grip*
PUTVAL extMode "1"
OUTPUT *MODE*MODE*MOVE*
CMD "deviceCommand extDir extAck extBusy"
OUTPUT *Success*

DESC "Log extractor position"
GETVAL extPosition
OUTPUT *.MPOS*
GETVAL lvdtVal
OUTPUT *VAL*

ENDTEST

#
# Enable, check opto switch states, then disable
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#
#  Should all be affirmative now.
#

TEST "Enable, check state of opto switches - all affirmative - then disable"
FATAL

DESC "Enable opto switches"
PUTVAL optSensorVal 0
OUTPUT *VAL* OFF* ON* 

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* CassetteInstalled*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* InSlot*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Aligned*

DESC "Disable opto switches"
PUTVAL optSensorVal 1
OUTPUT *VAL* ON* OFF* 

ENDTEST

#
#  Ready to watch Mask Assembly INDEX in operation?
#

PROMPT "You are about to index the mask.  It should index on the soft limit at the cassette end before indexing on the home switch at the other end.  Are you ready to watch the mask index?"

#
#  INDEX the mask assembly
#

TEST "INDEX the mask assembly"
FATAL

DESC "Indexing Mask Assembly"

PUTVAL mskMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

ENDTEST

#
#  Did the extractor index on the soft limit at the cassette end
#  before indexing on the home switch?
#

PROMPT "Did the extractor index on the soft limit at the cassette end before indexing on the home switch?"

#
# Check opto switch states
#
#    cassetteMissing == CassetteInstalled | Unknown
#    slotEmpty       == InSlot | Unknown
#    slotMisaligned  == Aligned | Unknown
#
#  Should all be Unknown immediately after indexing, since cassette #1
#  is not installed.
#

TEST "Check state of opto switches - should be Unknown"
FATAL

DESC "Enable opto switches"
PUTVAL optSensorVal 0
OUTPUT *VAL* OFF* ON* 

DESC "Cassette installed?"
GETVAL cassetteMissing
OUTPUT *VAL* Unknown*

DESC "Mask in slot?"
GETVAL slotEmpty
OUTPUT *VAL* Unknown*

DESC "Slot aligned?"
GETVAL slotMisaligned
OUTPUT *VAL* Unknown*

DESC "Disable opto switches"
PUTVAL optSensorVal 1
OUTPUT *VAL* ON* OFF* 

ENDTEST

#
#  Select the last item in the barcode list (should be a mask!) 
#  and load it into the focal plane
#

TEST "Loading a mask into the focal plane (last entry in table)"
FATAL

DESC "Loading mask (last entry in table)"

CMD "getLastMaskId mskSelect/gemini/data/msk.lut"
OUTPUT *Success*

PUTVAL mskMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL mskLocation "0"
OUTPUT *B*B* 0*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Mask assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC "Gripper gripped?"

GETVAL sadGripper
OUTPUT *VAL* -1*

DESC "Release released?"

GETVAL sadRelease
OUTPUT *VAL* 1*

DESC "Focal plane occupied?"

GETVAL sadInFp
OUTPUT *VAL* 1*

ENDTEST

#
# Verify mask in focal plane
#

TEST "Verify mask in focal plane"
FATAL

DESC "Correct mask in Focal Plane?"

CMD "compareField sadSelect mskSelect
OUTPUT *Equal*

DESC " Mask location in-beam?"

GETVAL sadLocation
OUTPUT *VAL* 0*

ENDTEST

#
#  Put the mask back into its cassette
#

TEST "Put the mask back into its cassette"
FATAL

DESC "Set mask location to out-of-beam"

PUTVAL mskLocation "1"
OUTPUT *B*B* 1*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly still indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Mask assembly still initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health still GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC "Focal plane empty?"

GETVAL sadInFp
OUTPUT *VAL* 0*

DESC "Mask location out-of-beam?"

GETVAL sadLocation
OUTPUT *VAL* 1*

ENDTEST

#
#  Mask Assembly opto sensor functions are OK
#

COMMENT "Mask assembly opto sensors OK"
