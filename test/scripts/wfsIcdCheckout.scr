
#
# DHS Test Commander
# wfs ICD functionality test script
#

#
# Do the variable substitution thing....
#

VAR     wfsAssembly      assemblyDirective       wfsDir              1
VAR     wfsAssembly      assemblyMode            wfsMode             1
VAR     wfsAssembly      assemblyAAttribute      wfsMXTarget         1
VAR     wfsAssembly      assemblyBAttribute      wfsMYTarget         1
VAR     wfsAssembly      assemblyCAttribute      wfsSol              1
VAR     wfsAssembly      assemblyAttributeAMin   wfsAttributeAMin    1
VAR     wfsAssembly      assemblyAttributeAMax   wfsAttributeAMax    1
VAR     wfsAssembly      assemblyAttributeBMin   wfsAttributeBMin    1
VAR     wfsAssembly      assemblyAttributeBMax   wfsAttributeBMax    1

VAR     wfsAssembly      assemblyAcknowledge     wfsAck              1
VAR     wfsAssembly      assemblyBusy            wfsBusy             1
VAR     wfsAssembly      assemblyMessage         wfsMess             1

VAR     wfsAssembly      assemblyDebug           wfsDebug            1
VAR     wfsAssembly      assemblySimulation      wfsSimulation       1
VAR     wfsAssembly      assemblyLutFile         wfsLutFile          1
VAR     wfsAssembly      assemblyLutDir          wfsLutDir           1
VAR     wfsAssembly      assemblyNumberOfDevices wfsNumDev           1
VAR     wfsAssembly      assemblyDevType         wfsDevType          1

VAR     wfsAssembly      assemblyState           wfsState            1
VAR     wfsAssembly      assemblyIndexed         wfsIndexed          1
VAR     wfsAssembly      assemblyInitialized     wfsInitialized      1
VAR     wfsAssembly      assemblyHealth          wfsHealth           1
VAR     wfsAssembly      assemblyParked          wfsParked           1

VAR     wfsCommands      wfsMXPos                wfsMXPos            1
VAR     wfsCommands      wfsMYPos                wfsMYPos            1
VAR     wfsCommands      wfsXMax                 wfsXMax             1
VAR     wfsCommands      wfsYMax                 wfsYMax             1
VAR     wfsCommands      wfsXMin                 wfsXMin             1
VAR     wfsCommands      wfsYMin                 wfsYMin             1
VAR     wfsCommands      wfsBasAbs               wfsBasAbs           1
VAR     wfsCommands      wfsPkoAbs               wfsPkoAbs           1
VAR     wfsCommands      wfsAbsBaseZero          wfsAbsBaseZero      1
VAR     wfsCommands      wfsAbsPickoffZero       wfsAbsPickoffZero   1

VAR     baseDevice       devicePosition          basePos             1
VAR     baseDevice       deviceDirective         baseDir             1
VAR     baseDevice       deviceMode              baseMode            1
VAR     baseDevice       deviceTarget            baseTarget          1
VAR     baseDevice       deviceAcknowledge       baseAck             1
VAR     baseDevice       deviceBusy              baseBusy            1
VAR     baseDevice       deviceMessage           baseMess            1
VAR     pickoffDevice    devicePosition          pickoffPos          1
VAR     pickoffDevice    deviceDirective         pickoffDir          1
VAR     pickoffDevice    deviceMode              pickoffMode         1
VAR     pickoffDevice    deviceTarget            pickoffTarget       1
VAR     pickoffDevice    deviceAcknowledge       pickoffAck          1
VAR     pickoffDevice    deviceBusy              pickoffBusy         1
VAR     pickoffDevice    deviceMessage           pickoffMess         1

#***********************************************************

#
# Is it safe to proceed?
#

PROMPT "Is it safe to move the wavefront sensor"

#
# Verify startup state
#

TEST "Verify startup state"
FATAL

DESC "Verify startup state"

DESC "Initial state must be IDLE"
GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

DESC "Log whether initialized"
GETVAL wfsInitialized
OUTPUT *

DESC "WFS assembly not indexed?"
GETVAL wfsIndexed
OUTPUT *.INDX* 0* 

DESC "WFS assembly not parked?"
GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *

ENDTEST

#
# Verify assembly configuration
#

TEST "Verify assembly configuration"
FATAL

DESC "Get assembly device layer type"
GETVAL wfsDevType
OUTPUT *.DTYP* Oiwfs*

DESC "Get assembly debug level"
GETVAL wfsDebug
OUTPUT *.DBUG* 

DESC "Get assembly simulation level"
GETVAL wfsSimulation
OUTPUT *.SIMM* NONE*

DESC "Get lookup table directory"
GETVAL wfsLutDir
OUTPUT *.TDIR* 

DESC "Get lookup table filename"
GETVAL wfsLutFile
OUTPUT *.TFIL* 

DESC "Get number of devices connected to assembly"
GETVAL wfsNumDev
OUTPUT *.NMDV* 2*

DESC "Get minimum X value"

GETVAL wfsAttributeAMin
OUTPUT *.AALL* 

DESC "Get maximum X value"

GETVAL wfsAttributeAMax
OUTPUT *.AAHL* 

DESC "Get minimum Y value"

GETVAL wfsAttributeBMin
OUTPUT *.ABLL* 

DESC "Get maximum Y value"

GETVAL wfsAttributeBMax
OUTPUT *.ABHL* 


ENDTEST

#
# Initialize the wfs assembly
#

TEST "Test OIWFS assembly INIT mode"
FATAL

DESC "Initializing wfs assembly"

DESC "Set MODE to INIT"
PUTVAL wfsMode "0"
OUTPUT *.MODE*.MODE*INIT*

DESC "Start the command and wait for car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
#FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 0* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# Testing the wfs assembly
#

TEST "Test OIWFS assembly TEST mode"
FATAL

DESC "Testing wfs assembly"

DESC "Set MODE to TEST"
PUTVAL wfsMode "5"
OUTPUT *.MODE*.MODE*TEST*

DESC "Start the command and wait for car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
#FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 0* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# Then index the wfs assembly
#

TEST "Test OIWFS assembly INDEX mode"
FATAL

DESC "Indexing wfs"

DESC "Set MODE to INDEX"
PUTVAL wfsMode "3"
OUTPUT *.MODE*.MODE*INDEX*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState INDEXING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*


ENDTEST

#
# Log the actual XY coordinates
#
TEST "Log the actual XY coordinates"
FATAL

DESC "Log the current X position"
GETVAL wfsMXPos
OUTPUT *VALA*

DESC "Log the current Y position"
GETVAL wfsMYPos
OUTPUT *VALB*

ENDTEST

#
# Log the base/pickoff angles calculated from sin/cos pots
#
TEST "Log the base/pickoff angles calculated from sin/cos pots"
FATAL

DESC "Log the absolute base angle"
GETVAL wfsBasAbs
OUTPUT *VALA*

DESC "Log the absolute pickoff angle"
GETVAL wfsPkoAbs
OUTPUT *VALB*

DESC "Log the angle used to zero the absolute base to incremental base"
GETVAL wfsAbsBaseZero
OUTPUT *VAL*

DESC "Log the angle used to zero the absolute pickoff to incremental pickoff"
GETVAL wfsAbsPickoffZero
OUTPUT *VAL*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# Try entering invalid Mask X Target attributes
#
TEST "Try entering invalid Mask X Target attributes"
FATAL

DESC "Load Mask X attribute with -7.2"
PUTVAL wfsMXTarget "-7.2"
OUTPUT *.A*.A*-7.2*

DESC "Set MODE to MOVE"
PUTVAL wfsMode "1"
OUTPUT *.MODE*.MODE*MOVE*

DESC "Check command with PRESET directive"
CMD "presetCommand wfsDir wfsAck"
OUTPUT *reject*

DESC "Look for error message 'X target range'"
GETVAL wfsMess
OUTPUT *X target range*

DESC "Restore Mask X attribute to 0"
PUTVAL wfsMXTarget "0.0"
OUTPUT *.A*.A*0.0*

DESC "Check command with PRESET directive"
CMD "presetCommand wfsDir wfsAck"
OUTPUT *accept*

DESC "Load Mask X attribute with 133.4"
PUTVAL wfsMXTarget "133.4"
OUTPUT *.A*.A*133.4*

DESC "Check command with PRESET directive"
CMD "presetCommand wfsDir wfsAck"
OUTPUT *reject*

DESC "Look for error message 'X target range'"
GETVAL wfsMess
OUTPUT *X target range*

DESC "Restore Mask X attribute to 0"
PUTVAL wfsMXTarget "0.0"
OUTPUT *.A*.A*0.0*

DESC "Check command with PRESET directive"
CMD "presetCommand wfsDir wfsAck"
OUTPUT *accept*

ENDTEST

#
# Try entering invalid Mask Y Target attributes
#
TEST "Try entering invalid Mask Y Target attributes"
FATAL

DESC "Load Mask Y attribute with -21.8"
PUTVAL wfsMYTarget "-21.8"
OUTPUT *.B*.B*-21.8*

DESC "Check command with PRESET directive"
CMD "presetCommand wfsDir wfsAck"
OUTPUT *reject*

DESC "Look for error message 'Y target range'"
GETVAL wfsMess
OUTPUT *Y target range*

DESC "Restore Mask Y attribute to 0"
PUTVAL wfsMYTarget "0.0"
OUTPUT *.B*.B*0.0*

DESC "Check command with PRESET directive"
CMD "presetCommand wfsDir wfsAck"
OUTPUT *accept*

DESC "Load Mask Y attribute with 133.4"
PUTVAL wfsMYTarget "133.4"
OUTPUT *.B*.B*133.4*

DESC "Check command with PRESET directive"
CMD "presetCommand wfsDir wfsAck"
OUTPUT *reject*

DESC "Look for error message 'Y target range'"
GETVAL wfsMess
OUTPUT *Y target range*

DESC "Restore Mask Y attribute to 0"
PUTVAL wfsMYTarget "0.0"
OUTPUT *.B*.B*0.0*

DESC "Check command with PRESET directive"
CMD "presetCommand wfsDir wfsAck"
OUTPUT *accept*

ENDTEST

#
# Move the probe to lower left corner
#

TEST "Checking field coverage - lower left"
FATAL

DESC "Moving to first corner"

DESC "Load X attribute with minimum value"
CMD "setField wfsMXTarget wfsXMin"
OUTPUT *Success*

DESC "Load Y attribute with minimum value"
CMD "setField wfsMYTarget wfsYMin"
OUTPUT *Success*

DESC "Set MODE to MOVE"
PUTVAL wfsMode "1"
OUTPUT *.MODE*.MODE*MOVE*

DESC "Set solution type to 1"
PUTVAL wfsSol "1"
OUTPUT *.C*.C* 1*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Log the actual XY coordinates
#
TEST "Log the actual XY coordinates"
FATAL

DESC "Log the current X position"
GETVAL wfsMXPos
OUTPUT *VALA*

DESC "Log the current Y position"
GETVAL wfsMYPos
OUTPUT *VALB*

ENDTEST

#
# Log the base/pickoff angles calculated from sin/cos pots
#
TEST "Log the base/pickoff angles calculated from sin/cos pots"
FATAL

DESC "Log the absolute base angle"
GETVAL wfsBasAbs
OUTPUT *VALA*

DESC "Log the absolute pickoff angle"
GETVAL wfsPkoAbs
OUTPUT *VALB*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# Move the probe to upper left corner
#

TEST "Checking field coverage - upper left"
FATAL

DESC "Moving to second corner"

DESC "Load Telescope Y attribute with maximum value"
CMD "setField wfsMYTarget wfsYMax"
OUTPUT *Success*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Log the actual XY coordinates
#
TEST "Log the actual XY coordinates"
FATAL

DESC "Log the current X position"
GETVAL wfsMXPos
OUTPUT *VALA*

DESC "Log the current Y position"
GETVAL wfsMYPos
OUTPUT *VALB*

ENDTEST

#
# Log the base/pickoff angles calculated from sin/cos pots
#
TEST "Log the base/pickoff angles calculated from sin/cos pots"
FATAL

DESC "Log the absolute base angle"
GETVAL wfsBasAbs
OUTPUT *VALA*

DESC "Log the absolute pickoff angle"
GETVAL wfsPkoAbs
OUTPUT *VALB*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# Move the probe to upper right corner
#

TEST "Checking field coverage - upper right"
FATAL

DESC "Moving to third corner"

DESC "Load X attribute with maximum value"
CMD "setField wfsMXTarget wfsXMax"
OUTPUT *Success*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Log the actual XY coordinates
#
TEST "Log the actual XY coordinates"
FATAL

DESC "Log the current X position"
GETVAL wfsMXPos
OUTPUT *VALA*

DESC "Log the current Y position"
GETVAL wfsMYPos
OUTPUT *VALB*

ENDTEST

#
# Log the base/pickoff angles calculated from sin/cos pots
#
TEST "Log the base/pickoff angles calculated from sin/cos pots"
FATAL

DESC "Log the absolute base angle"
GETVAL wfsBasAbs
OUTPUT *VALA*

DESC "Log the absolute pickoff angle"
GETVAL wfsPkoAbs
OUTPUT *VALB*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# Move the probe to lower right corner
#

TEST "Checking field coverage - lower right"
FATAL

DESC "Moving to fourth corner"

DESC "Load Y attribute with minimum value"
CMD "setField wfsMYTarget wfsYMin"
OUTPUT *Success*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Log the actual XY coordinates
#
TEST "Log the actual XY coordinates"
FATAL

DESC "Log the current X position"
GETVAL wfsMXPos
OUTPUT *VALA*

DESC "Log the current Y position"
GETVAL wfsMYPos
OUTPUT *VALB*

ENDTEST

#
# Log the base/pickoff angles calculated from sin/cos pots
#
TEST "Log the base/pickoff angles calculated from sin/cos pots"
FATAL

DESC "Log the absolute base angle"
GETVAL wfsBasAbs
OUTPUT *VALA*

DESC "Log the absolute pickoff angle"
GETVAL wfsPkoAbs
OUTPUT *VALB*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# And back to center
#

TEST "Put the wfs to the optical axis"
FATAL

DESC "Putting the wfs to center"

PUTVAL wfsMXTarget "0.0"
OUTPUT *0*

PUTVAL wfsMYTarget "0.0"
OUTPUT *0*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Log the actual XY coordinates
#
TEST "Log the actual XY coordinates"
FATAL

DESC "Log the current X position"
GETVAL wfsMXPos
OUTPUT *VALA*

DESC "Log the current Y position"
GETVAL wfsMYPos
OUTPUT *VALB*

ENDTEST

#
# Log the base/pickoff angles calculated from sin/cos pots
#
TEST "Log the base/pickoff angles calculated from sin/cos pots"
FATAL

DESC "Log the absolute base angle"
GETVAL wfsBasAbs
OUTPUT *VALA*

DESC "Log the absolute pickoff angle"
GETVAL wfsPkoAbs
OUTPUT *VALB*

ENDTEST

#
# Test receipt of new target while already moving
#

TEST "Test receipt of new target while already moving"
FATAL

DESC "Start in upper left corner"

DESC "Load X attribute with minimum value"
CMD "setField wfsMXTarget wfsXMin"
OUTPUT *Success*

DESC "Load Y attribute with maximum value"
CMD "setField wfsMYTarget wfsYMax"
OUTPUT *Success*

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Start move to upper right corner"

DESC "Load X attribute with maximum value"
CMD "setField wfsMXTarget wfsXMax"
OUTPUT *Success*

DESC "Load Y attribute with maximum value"
CMD "setField wfsMYTarget wfsYMax"
OUTPUT *Success*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Interrupt with move to optical centre"

PUTVAL wfsMXTarget "0.0"
OUTPUT *.A* 0.0*

PUTVAL wfsMYTarget "0.0"
OUTPUT *.B* 0.0*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# Park the wfs assembly
#

TEST "Test OIWFS PARK command"
FATAL

DESC "Parking wfs"

DESC "Set MODE to PARK"
PUTVAL wfsMode "4"
OUTPUT *.MODE*.MODE*PARK*

DESC "Start the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Log the actual XY coordinates
#
TEST "Log the actual XY coordinates"
FATAL

DESC "Log the current X position"
GETVAL wfsMXPos
OUTPUT *VALA*

DESC "Log the current Y position"
GETVAL wfsMYPos
OUTPUT *VALB*

ENDTEST

#
# Log the base/pickoff angles calculated from sin/cos pots
#
TEST "Log the base/pickoff angles calculated from sin/cos pots"
FATAL

DESC "Log the absolute base angle"
GETVAL wfsBasAbs
OUTPUT *VALA*

DESC "Log the absolute pickoff angle"
GETVAL wfsPkoAbs
OUTPUT *VALB*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 1* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

#
# Un-Park the wfs assembly
#

TEST "Move the OIWFS Probe and lose park flag"
FATAL

DESC "Moving wfs"

PUTVAL wfsMXTarget "0.0"
OUTPUT *0*

PUTVAL wfsMYTarget "0.0"
OUTPUT *0*

DESC "Set MODE to MOVE"
PUTVAL wfsMode "1"
OUTPUT *.MODE*.MODE*MOVE*

DESC "Start the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

ENDTEST

COMMENT "wfs checks out OK"

 
