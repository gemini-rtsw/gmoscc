ENDTEST

#
# Check the status fields after loading all the masks
#

TEST "Verify status fields to catch any fatal errors during mask loading"
FATAL

DESC "Mask assembly still indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"
GETVAL sadState
OUTPUT *VAL*IDLE*
CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health still GOOD?"
GETVAL sadHealth
OUTPUT *VAL*GOOD*

ENDTEST

#
# Parking the Assembly
#

TEST "Parking function test"
FATAL

DESC "Parking assembly"

PUTVAL mskMode "4"
OUTPUT *MODE*MOVE*MODE*PARK*

PUTVAL mskParkingSpot "2"
OUTPUT *C*C* 2*

CMD "startCommand cmdDir cmdAck cmdAction"
OUTPUT *Started*

CMD "sleep 1"
OUTPUT *
CMD "checkState cmdState MOVING"
OUTPUT *Success*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

CMD "finishCommand cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Mask assembly parked?"
CMD "sleep 1"
OUTPUT *
GETVAL sadPark
OUTPUT *VAL* 1*
 
DESC "Mask assembly indexed?"

GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Mask assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Mask assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Mask assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC "Gripper gripped?"

GETVAL sadGripper
OUTPUT *VAL* 1*

DESC "Release released?"

GETVAL sadRelease
OUTPUT *VAL* -1*

DESC "Focal plane not occupied?"

GETVAL sadInFp
OUTPUT *VAL* 0*

DESC " Mask location in-cassette?"

GETVAL sadLocation
OUTPUT *VAL* 1*

ENDTEST

#
#  Mask Assembly Update functions are OK
#

COMMENT "Mask assembly update OK"
