#
# Reindex the translation assembly
#

TEST "Repeat Index Function"
FATAL

DESC "Restore targets"

PUTVAL dtaTargetX "0.0"
OUTPUT *

PUTVAL dtaTargetY "0.0"
OUTPUT *

PUTVAL dtaTargetZ "0.0"
OUTPUT *

PUTVAL dtaUseLut "0"
OUTPUT *

DESC "Reindexing Translation Assembly"

PUTVAL dtaMode "3"
OUTPUT *MODE*MOVE*MODE*INDEX*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# Wait for one second after the command finishes, then check that the translation assembly 
# indexed flag has been set, the initialised flag is still set, the translation assembly
# and translation CAR records have both gone idle, and the health is still GOOD.
#

TEST "Verify status fields"
FATAL

DESC "Translation assembly indexed?"
CMD "sleep 1"
OUTPUT *
GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Translation assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Translation assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Translation assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

#
# Test for failure of the translation assembly initialisation function
# when it is given a non-existent file.
#

TEST "Test initialization function with non-existent LUT file"
FATAL

DESC "Initializing translation assembly with non-existent LUT file"

PUTVAL dtaLutFile "nosuchfile.lut"
OUTPUT *TFIL*TFIL* nosuchfile.lut*

PUTVAL dtaMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Command Failed*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Failed to open LUT file'"
GETVAL cmdError
OUTPUT *Failed to open LUT file*

ENDTEST

#
# Wait for one second after the command finishes, then check that the translation assembly 
# initialisation flag has been unset and the health has changed to WARNING.
#

TEST "Verify status fields"
FATAL

DESC "Translation assembly initialized?"

CMD "sleep 1"
OUTPUT *
GETVAL sadInit
OUTPUT *VAL* 0*

DESC "Translation assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Translation assembly health WARNING?"

GETVAL sadHealth
OUTPUT *VAL*WARNING*

ENDTEST

#
# Test for failure of the translation assembly initialisation function
# when it is given a garbage file.
#

TEST "Test initialization function with garbage LUT file"
FATAL

DESC "Initializing translation assembly with garbage LUT file"

PUTVAL dtaLutFile "garbage.lut"
OUTPUT *TFIL *TFIL * garbage.lut*

PUTVAL dtaMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Command Failed*

ENDTEST

#
# Verify Error message
#

TEST "Verify error message"
FATAL

DESC "Look for error message 'Incorrect LUT file type'"
GETVAL cmdError
OUTPUT *Incorrect LUT file type*

ENDTEST

#
# Wait for one second after the command finishes, then check that the translation assembly 
# initialisation flag is still unset and the health is still WARNING.
#

TEST "Verify status fields"
FATAL

DESC "Translation assembly initialized?"

CMD "sleep 1"
OUTPUT *
GETVAL sadInit
OUTPUT *VAL* 0*

DESC "Translation assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Translation assembly health WARNING?"

GETVAL sadHealth
OUTPUT *VAL*WARNING*

ENDTEST


#
# Change the lookup table name back as it was
#

TEST "Change lookup table name back as it was"
FATAL

DESC "Reset the LUT filename"
PUTVAL dtaLutFile "dta.lut"
OUTPUT *TFIL *TFIL * dta.lut*

ENDTEST


#
# Restore the translation assembly by reinitialising
#

TEST "Initialize properly to restore translation assembly"
FATAL

DESC "Initializing translation assembly properly"

PUTVAL dtaMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "executeCommand cmdDir cmdAck cmdAction"
OUTPUT *Success*

ENDTEST

#
# Wait for one second after the command finishes, then check that the translation assembly 
# initialisation flag has been set, the translation assembly and translation CAR records have
# both gone idle, and the health has changed to GOOD.
#

TEST "Verify status fields"
FATAL

DESC "Translation assembly initialized?"

CMD "sleep 1"
OUTPUT *
GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Translation assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Transltion assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

ENDTEST



#
# Finally, park the Assembly
#

TEST "Test parking function"
FATAL

DESC "Parking assembly"

PUTVAL dtaMode "4"
OUTPUT *MODE*INIT*MODE*PARK*

CMD "startCommand cmdDir cmdAck cmdAction"
OUTPUT *Started*

CMD "sleep 1"
OUTPUT *
CMD "checkState cmdState MOVING"
OUTPUT *Success*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

CMD "finishCommand cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Translation assembly parked?"
CMD "sleep 1"
OUTPUT *
GETVAL sadPark
OUTPUT *VAL* 1*
 
DESC "Translation assembly indexed?"

GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Translation assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Translation assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Translation assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC "Record the actual XYZ parking position"

GETVAL dta1Pos
OUTPUT *

GETVAL dta2Pos
OUTPUT *

GETVAL dta3Pos
OUTPUT *

DESC "Verify XYZ records in SAD are correct"

GETVAL sadXposition
OUTPUT *
CMD "compareField sadXposition dta1Pos"
OUTPUT *Equal*

GETVAL sadZposition
OUTPUT *
CMD "compareField sadYposition dta2Pos"
OUTPUT *Equal*

GETVAL sadZposition
OUTPUT *
CMD "compareField sadZposition dta3Pos"
OUTPUT *Equal*

ENDTEST


#
#  Translation Assembly functions are OK
#

COMMENT "Translation assembly OK"
