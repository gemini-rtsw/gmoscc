#
# -------------------------------------------------------------------------------------
# Go back to position 0 and time how long one whole revolution takes
#

TEST "Move filter wheel 2 a whole revolution back to pos0"
FATAL

DESC "Move back to for pos0" 

PUTVAL devNamedTarget "pos0"
OUTPUT *.VALS*

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

DESC "Start time"
CMD "date"
OUTPUT *

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

DESC "Finish time"
CMD "date"
OUTPUT *

ENDTEST

