#
# DHS Test Commander
# Filter wheel 2 device functionality test script
#

#
# Define the variables used in this script, and the configuration files
# which contain their translation into EPICS channel names.
#
#       Config file        Config file name        Named used here     Mystery number
#       -----------        ---------------------   -----------------   --------------

# Device INPUTS
VAR     filter2Device      devDir                  devDir	       1
VAR     filter2Device      devMode                 devMode             1
VAR     filter2Device      devTarget               devTarget           1
VAR     filter2Device      devNamedTarget          devNamedTarget      1
VAR     filter2Device      devIndexType            devIndexType        1
VAR     filter2Device      devDbug                 devDbug             1
VAR     filter2Device      devSimm                 devSimm             1
VAR     filter2Device      devMinPosition          devMinPosition      1
VAR     filter2Device      devMaxPosition          devMaxPosition      1
VAR     filter2Device      devBacklash             devBacklash         1
VAR     filter2Device      devRounding             devRounding         1
VAR     filter2Device      devVelocity             devVelocity         1
VAR     filter2Device      devMinVelocity          devMinVelocity      1
VAR     filter2Device      devMaxVelocity          devMaxVelocity      1
VAR     filter2Device      devAcceleration         devAcceleration     1
VAR     filter2Device      devLutFile              devLutFile          1
VAR     filter2Device      devLutDirectory         devLutDirectory     1
VAR     filter2Device      devDevType              devDevType          1
VAR     filter2Device      devEgu                  devEgu              1
VAR     filter2Device      devMotorRes             devMotorRes         1
VAR     filter2Device      devMotionDeadBand       devMotionDeadBand   1
VAR     filter2Device      devBaseVelo             devBaseVelo         1
VAR     filter2Device      devFinalIndexVelo       devFinalIndexVelo   1
VAR     filter2Device      devUsePwrStatus         devUsePwrStatus     1
VAR     filter2Device      devPwrStatusTimeout     devPwrStatusTimeout 1
VAR     filter2Device      devPower                devPower            1
VAR     filter2Device      devUseBrkStatus         devUseBrkStatus     1
VAR     filter2Device      devBrkStatusTimeout     devBrkStatusTimeout 1
VAR     filter2Device      devBrake                devBrake            1
VAR     filter2Device      devUseAuxPwr            devUseAuxPwr        1
VAR     filter2Device      devUseEncoder           devUseEncoder       1
VAR     filter2Device      devEncoderRes           devEncoderRes       1
VAR     filter2Device      devEncoderDeadBand      devEncoderDeadBand  1

# Device OUTPUTS
VAR     filter2Device      devPosition             devPosition         1
VAR     filter2Device      devRawPosition          devRawPosition      1
VAR     filter2Device      devAck                  devAck              1
VAR     filter2Device      devBusy                 devBusy             1
VAR     filter2Device      devState                devState            1
VAR     filter2Device      devMess                 devMess             1
VAR     filter2Device      devIndexed              devIndexed          1
VAR     filter2Device      devLimited              devLimited          1

# other status
VAR     filterStatus       filter2InPosition      flt2InPosition       1

#
# Is it safe to proceed?
#

PROMPT "Read the assumptions.  Is it safe to move the filter wheels?"

#
# Verify startup state. The device should be unindexed, stopped and unpowered.
#

TEST "Verify startup state"
FATAL

DESC "Verify startup state"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Log the current device record configuration
#
TEST "Log the current device record configuration"
FATAL

DESC "Get deviceControl record device layer type"
GETVAL devDevType
OUTPUT *.DTYP*DEV CTL OMS 8/44*

#
# The in position switches will not work in simulation mode
#

DESC "Get simulation level"
GETVAL devSimm
OUTPUT *.SIMM* NONE*

DESC "Get debug level"
GETVAL devDbug
OUTPUT *.DBUG*

DESC "Get enginering units"
GETVAL devEgu
OUTPUT *.EGU*

DESC "Get motor resolution, in microsteps per EGU"
GETVAL devMotorRes
OUTPUT *.MRES*

DESC "Get motion deadband"
GETVAL devMotionDeadBand
OUTPUT *.MDBD*

DESC "Get upper target limit, max EGU target allowed"
GETVAL devMaxPosition
OUTPUT *.PHLM*

DESC "Get lower target limit, min EGU target allowed"
GETVAL devMinPosition
OUTPUT *.PLLM*

DESC "Get motion velocity"
GETVAL devVelocity
OUTPUT *.VELO*

DESC "Get upper velocity limit, max EGU velocity allowed"
GETVAL devMaxVelocity
OUTPUT *.VHLM*

DESC "Get lower velocity limit, min EGU velocity allowed"
GETVAL devMinVelocity
OUTPUT *.VLLM*

DESC "Get motion startup velocity"
GETVAL devBaseVelo
OUTPUT *.VBAS*

DESC "Get final indexing velocity"
GETVAL devFinalIndexVelo
OUTPUT *.FIVL*

DESC "Get acceleration, VBAS to VELO in EGUs per second per second"
GETVAL devAcceleration
OUTPUT *.ACCL*

DESC "Get backlash correction in motor steps"
GETVAL devBacklash
OUTPUT *.BLCO*

DESC "Get motor position rounding in motor steps"
GETVAL devRounding
OUTPUT *.MRND*

DESC "Get the indexing algorithm number - should be 3 for filter wheels"
GETVAL devIndexType
OUTPUT *.IALG* 3*

DESC "Using Power status? Should be YES for filter wheels"
GETVAL devUsePwrStatus
#OUTPUT *.UPSB* YES*
# Allow the device not to use power status while in simulation mode for testing the script
OUTPUT *.UPSB*

DESC "Get the power status timeout"
GETVAL devPwrStatusTimeout
OUTPUT *.PTMO*

DESC "Using Brake status? Should be NO for filter wheels"
GETVAL devUseBrkStatus
OUTPUT *.UBSB* NO*

DESC "Get the brake status timeout - should be zero for filter wheels"
GETVAL devBrkStatusTimeout
OUTPUT *.BTMO* 0*

DESC "Using AUX to enable drives?"
GETVAL devUseAuxPwr
OUTPUT *.UAPB* YES*

DESC "Using Encoder? Should be NO for filter wheels"
GETVAL devUseEncoder
OUTPUT *.UEIP* NO*

DESC "Get encoder resolution in counts per EGU"
GETVAL devEncoderRes
OUTPUT *.ERES*

DESC "Get encoder deadband"
GETVAL devEncoderDeadBand
OUTPUT *.EDBD*

DESC "Get lookup table name"
GETVAL devLutFile
OUTPUT *.TFIL* flt2.lut*

DESC "Get lookup table directory name"
GETVAL devLutDirectory
OUTPUT *.TDIR*

ENDTEST

#
# First try to initialize the device control record
#

TEST "Test filter wheel 2 device INIT mode"
FATAL

DESC "Initializing filter wheel 2"

PUTVAL devMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

ENDTEST

#
# Test filter wheel 2 device TEST mode
#

TEST "Test filter wheel 2 device TEST mode"
FATAL

DESC "Testing filter wheel 2"

PUTVAL devMode "5"
OUTPUT *MODE*MODE*TEST*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

ENDTEST

#
# Then try to index the device
#

TEST "Test indexing filter wheel 2"
FATAL

DESC "Indexing filter wheel 2"

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

DESC "Check index position is zero"
GETVAL devPosition
OUTPUT *.MPOS* 0* 

GETVAL devRawPosition
OUTPUT *.RRBV* 0* 

ENDTEST


#
# -------------------------------------------------------------------------------------
# Head for wheel position 0
#

TEST "Place filter wheel 2 device in pos0"
FATAL

DESC "Look for pos0" 

PUTVAL devNamedTarget "pos0"
OUTPUT *.VALS*

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify position with switches
# 

TEST "Test feedback switches"
FATAL

DESC "Check switches"

GETVAL flt2InPosition
OUTPUT *VAL* INPOSITION*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

DESC "Get current position"
GETVAL devPosition
OUTPUT *.MPOS*

GETVAL devRawPosition
OUTPUT *.RRBV*

ENDTEST

#
# -------------------------------------------------------------------------------------
# Move to a position between pos0 and pos1
#

TEST "Place filter wheel 2 device between pos0 and pos1"
FATAL

DESC "Move between pos0/pos1" 

PUTVAL devTarget "-11.0"
OUTPUT *.VAL*

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify switches are not made in between positions
# 

TEST "Test feedback switches"
FATAL

DESC "Check switches"

GETVAL flt2InPosition
OUTPUT *VAL*NOTINPOSITION*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

