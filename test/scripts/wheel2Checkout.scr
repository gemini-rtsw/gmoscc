DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST


#
# -------------------------------------------------------------------------------------
# Head for wheel position 10
#

TEST "Place filter wheel 2 device in pos10"
FATAL

DESC "Look for pos10" 

PUTVAL devNamedTarget "pos10"
OUTPUT *.VALS*

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify position with switches
# 

TEST "Test feedback switches"
FATAL

DESC "Check switches"

GETVAL flt2InPosition
OUTPUT *VAL* INPOSITION*

ENDTEST

