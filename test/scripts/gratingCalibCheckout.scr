# --------------------------------------------------------------------------------------------------

#
# Finally, park the Assembly
#

TEST "Test parking function"
FATAL

DESC "Parking assembly"

PUTVAL grMode "4"
OUTPUT *MODE*MOVE*MODE*PARK*

CMD "startCommand cmdDir cmdAck cmdAction"
OUTPUT *Started*

CMD "sleep 1"
OUTPUT *
CMD "checkState cmdState MOVING"
OUTPUT *Success*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

CMD "finishCommand cmdAction"
OUTPUT *Success*

ENDTEST

#
# check resulting status fields....
#

TEST "Verify status fields"
FATAL

DESC "Grating assembly parked?"
CMD "sleep 1"
OUTPUT *
GETVAL sadPark
OUTPUT *VAL* 1*
 
DESC "Grating assembly indexed?"

GETVAL sadIndex
OUTPUT *VAL* 1*

DESC "Grating assembly initialized?"

GETVAL sadInit
OUTPUT *VAL* 1*

DESC "Grating assembly state IDLE?"

GETVAL sadState
OUTPUT *VAL*IDLE*

CMD "compareField sadState cmdState"
OUTPUT *Equal*

DESC "Grating assembly health GOOD?"

GETVAL sadHealth
OUTPUT *VAL*GOOD*

DESC "Grating tilt in SAD zero?"

GETVAL sadTilt
OUTPUT *VAL* -0*

ENDTEST


#
#  Grating Calibration check completed
#

COMMENT "Grating calibration check complete"



