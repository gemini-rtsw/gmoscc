# =============================================================================

TEST "Restore the BLCO back to normal and reindex"
FATAL

DESC "Restoring BLCO and reindexing"

PUTVAL devVelocity "3.75"
OUTPUT *.VELO* *

PUTVAL devBacklash "4.00"
OUTPUT *.BLCO* 4*

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

# -----------------------------------------------------------------------------

TEST "Move grating turret back to position B - normal velocity with BLCO"
FATAL

DESC "Moving turret back to position B"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devNamedTarget "posB"
OUTPUT *VALS*VALS* posB*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
