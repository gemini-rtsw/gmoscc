# =============================================================================

# Now we're going to reverse the direction of backlash and move the turret backwards
# through each position (D->C->B), again using a low velocity initial move to take
# out backlash before the executing the full movement.
# This will show if the juddering in the turret mechanism is dependent on the direction
# of backlash compensation.
#

TEST "Move grating turret towards position D - slowly, with no BLCO"
FATAL

DESC "Moving turret toward position D at VBAS, zero BLCO"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devVelocity "1.25"
OUTPUT *.VELO* *

PUTVAL devBacklash "0.0"
OUTPUT *.BLCO* 0*

DESC "Wind up backlash, towards position D"
PUTVAL devTarget "96.64"
OUTPUT *VAL*VAL* 96.64*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify state and log current position
#

TEST "Verify state and log position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

DESC "Get current position"
GETVAL devPosition
OUTPUT *.MPOS*

ENDTEST

# -----------------------------------------------------------------------------

TEST "Move grating turret to position D - normal velocity with negative BLCO"
FATAL

DESC "Moving turret to position D"

PUTVAL devVelocity "3.75"
OUTPUT *.VELO* *

PUTVAL devBacklash "-4.00"
OUTPUT *.BLCO* -4*

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devNamedTarget "posD"
OUTPUT *VALS*VALS* posD*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify state and log current position
#

TEST "Verify state and log position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

DESC "Get current position"
GETVAL devPosition
OUTPUT *.MPOS*

ENDTEST

# -----------------------------------------------------------------------------

