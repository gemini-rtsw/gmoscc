GETVAL devLimited
OUTPUT *.LSWA* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

DESC "Get current position"
GETVAL devPosition
OUTPUT *.MPOS*

ENDTEST

# -----------------------------------------------------------------------------

TEST "Finally switch off the turret power"
FATAL

PUTVAL devManualPower "0"
OUTPUT *VAL*VAL* OFF*

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
#  All grating turret backlash experiment complete
#

COMMENT "Grating turret backlash experiment OK"


 
