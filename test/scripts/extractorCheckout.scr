#
# Then re-index the device and return to slow velocity
#

TEST "Re-index on home switch"
FATAL

DESC "Indexing extractor"

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

GETVAL devIndexed
OUTPUT *HPVL* 1*

PUTVAL devVelocity "15"
OUTPUT *.VELO*

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Adjust upper and lower target limits to allow moves beyond limits
#

TEST "Adjust upper and lower target limits"
FATAL

DESC "Adjust upper and lower target limits"

PUTVAL devMinPosition "-501"
OUTPUT *.PLLM*

PUTVAL devMaxPosition "51"
OUTPUT *.PHLM*

ENDTEST

#
# Check distance from home to upper limit position
#

TEST "Attempting to move extractor past upper limit"
FATAL

DESC "Moving extractor"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devTarget "50"
OUTPUT *VAL*VAL* 50*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Failed*

ENDTEST

#
# Verify error message and log current position
#

TEST "Verify error message and log current position"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* ERROR* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

GETVAL devMess
OUTPUT *.MESS*Device hit a soft limit*

GETVAL devPosition
OUTPUT *.MPOS*

GETVAL devRawPosition
OUTPUT *.RRBV*

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Index the device to get back to normal
#

TEST "Indexing extractor"
FATAL

DESC "Indexing extractor"

PUTVAL devMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

