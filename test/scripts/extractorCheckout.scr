#
# DHS Test Commander
# Extractor device functionality test script
#

#
# Do the variable substitution thing....
#

# Device INPUTS
VAR     extractorDevice   devDir                  devDir               1
VAR     extractorDevice   devMode                 devMode              1
VAR     extractorDevice   devTarget               devTarget            1
VAR     extractorDevice   devNamedTarget          devNamedTarget       1
VAR     extractorDevice   devIndexType            devIndexType         1
VAR     extractorDevice   devDbug                 devDbug              1
VAR     extractorDevice   devSimm                 devSimm              1
VAR     extractorDevice   devMinPosition          devMinPosition       1
VAR     extractorDevice   devMaxPosition          devMaxPosition       1
VAR     extractorDevice   devVelocity             devVelocity          1
VAR     extractorDevice   devMinVelocity          devMinVelocity       1
VAR     extractorDevice   devMaxVelocity          devMaxVelocity       1
VAR     extractorDevice   devAcceleration         devAcceleration      1
VAR     extractorDevice   devLutFile              devLutFile           1
VAR     extractorDevice   devLutDirectory         devLutDirectory      1
VAR     extractorDevice   devDevType              devDevType           1
VAR     extractorDevice   devEgu                  devEgu               1
VAR     extractorDevice   devMotorRes             devMotorRes          1
VAR     extractorDevice   devMotionDeadBand       devMotionDeadBand    1
VAR     extractorDevice   devBaseVelo             devBaseVelo          1
VAR     extractorDevice   devUsePwrStatus         devUsePwrStatus      1
VAR     extractorDevice   devPwrStatusTimeout     devPwrStatusTimeout  1
VAR     extractorDevice   devPower                devPower             1
VAR     extractorDevice   devUseBrkStatus         devUseBrkStatus      1
VAR     extractorDevice   devBrkStatusTimeout     devBrkStatusTimeout  1
VAR     extractorDevice   devBrake                devBrake             1
VAR     extractorDevice   devUseAuxPwr            devUseAuxPwr         1
VAR     extractorDevice   devUseEncoder           devUseEncoder        1
VAR     extractorDevice   devEncoderRes           devEncoderRes        1
VAR     extractorDevice   devEncoderDeadBand      devEncoderDeadBand   1

# Device OUPUTS
VAR     extractorDevice   devPosition             devPosition          1
VAR     extractorDevice   devRawPosition          devRawPosition       1
VAR     extractorDevice   devAck                  devAck               1
VAR     extractorDevice   devBusy                 devBusy              1
VAR     extractorDevice   devState                devState             1
VAR     extractorDevice   devMess                 devMess              1
VAR     extractorDevice   devIndexed              devIndexed           1
VAR     extractorDevice   devLimited              devLimited           1

# other outputs
VAR     maskStatus        lvdtZone                lvdtZone             1
VAR     maskStatus        lvdtVal                 lvdtVal              1
VAR     maskStatus        lvdtLo                  lvdtLo               1
VAR     maskStatus        lvdtGrpLo               lvdtGrpLo            1
VAR     maskStatus        lvdtGrpHi               lvdtGrpHi            1
VAR     maskStatus        lvdtRelLo               lvdtRelLo            1
VAR     maskStatus        lvdtRelHi               lvdtRelHi            1

#
# Is it safe to proceed?
#

PROMPT "Read the assumptions.  Is it safe to move the extractor?"

#
# Verify startup state
#

TEST "Verify startup state"
FATAL

DESC "Verify startup state"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Log the current device record configuration
#
TEST "Log the current device record configuration"
FATAL

DESC "Get deviceControl record device layer type"
GETVAL devDevType
OUTPUT *.DTYP*DEV CTL OMS 8/44*

DESC "Get simulation level"
GETVAL devSimm
OUTPUT *.SIMM*NONE*

DESC "Get debug level"
GETVAL devDbug
OUTPUT *.DBUG*

DESC "Get enginering units"
GETVAL devEgu
OUTPUT *.EGU*mm*

DESC "Get motor resolution, in microsteps per EGU"
GETVAL devMotorRes
OUTPUT *.MRES*

DESC "Get motion deadband"
GETVAL devMotionDeadBand
OUTPUT *.MDBD*

DESC "Get upper target limit, max EGU target allowed"
GETVAL devMaxPosition
OUTPUT *.PHLM*

DESC "Get lower target limit, min EGU target allowed"
GETVAL devMinPosition
OUTPUT *.PLLM*

DESC "Get motion velocity"
GETVAL devVelocity
OUTPUT *.VELO*

DESC "Get upper velocity limit, max EGU velocity allowed"
GETVAL devMaxVelocity
OUTPUT *.VHLM*

DESC "Get lower velocity limit, min EGU velocity allowed"
GETVAL devMinVelocity
OUTPUT *.VLLM*

DESC "Get motion startup velocity"
GETVAL devBaseVelo
OUTPUT *.VBAS*

DESC "Get acceleration, VBAS to VELO in EGUs per second per second"
GETVAL devAcceleration
OUTPUT *.ACCL*

DESC "Get the indexing algorithm number"
GETVAL devIndexType
OUTPUT *.IALG* UPPHOME*

DESC "Using Power status?"
GETVAL devUsePwrStatus
OUTPUT *.UPSB* YES*
# Comment out check on UPSB until power status electronics problem fixed
#OUTPUT *.UPSB*

DESC "Get the power status timeout"
GETVAL devPwrStatusTimeout
OUTPUT *.PTMO*

DESC "Using Brake status?"
GETVAL devUseBrkStatus
OUTPUT *.UBSB* NO*

DESC "Get the brake status timeout"
GETVAL devBrkStatusTimeout
OUTPUT *.BTMO*

DESC "Using AUX to enable drives?"
GETVAL devUseAuxPwr
OUTPUT *.UAPB* YES*

DESC "Using Encoder?"
GETVAL devUseEncoder
OUTPUT *.UEIP* NO*

DESC "Get encoder resolution in counts per EGU"
GETVAL devEncoderRes
OUTPUT *.ERES*

DESC "Get encoder deadband"
GETVAL devEncoderDeadBand
OUTPUT *.EDBD*

DESC "Get lookup table name"
GETVAL devLutFile
OUTPUT *.TFIL* mskExt.lut*

DESC "Get lookup table directory name"
GETVAL devLutDirectory
OUTPUT *.TDIR*

ENDTEST

#
# First try to initialize the device control record
#

TEST "Test extractor device INIT mode"
FATAL

DESC "Initializing extractor"

PUTVAL devMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

ENDTEST

#
# Test extractor device TEST mode
#

TEST "Test extractor device TEST mode"
FATAL

DESC "Testing extractor"

PUTVAL devMode "5"
OUTPUT *MODE*MODE*TEST*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 0* 

ENDTEST

#
# Get all the LVDT stuff
#
TEST "Get all the LVDT stuff"

DESC "Get the LVDT zone word"
GETVAL lvdtZone
OUTPUT *VALA*

DESC "Get the actual LVDT value"
GETVAL lvdtVal
OUTPUT *VAL*

DESC "Get the LVDT value representing the lower LVDT limit"
GETVAL lvdtLo
OUTPUT *VAL*

DESC "Get the LVDT value representing the lower grip position limit"
GETVAL lvdtGrpLo
OUTPUT *VAL*

DESC "Get the LVDT value representing the upper grip position limit"
GETVAL lvdtGrpHi
OUTPUT *VAL*

DESC "Get the LVDT value representing the lower release position limit"
GETVAL lvdtRelLo
OUTPUT *VAL*

DESC "Get the LVDT value representing the upper release position limit"
GETVAL lvdtRelHi
OUTPUT *VAL*

ENDTEST

#
# Set to reduced velocity for moves into limits
#

TEST "Setting to reduced velocity for moves into limits"
FATAL

DESC "Setting to reduced velocity for moves into limits"

PUTVAL devVelocity "15"
OUTPUT *.VELO*

ENDTEST

#
# Test limit switch by indexing on 
# upper soft limit switch
#

TEST "Testing upper limit switch"
FATAL

DESC "Testing upper limit switch"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devNamedTarget "i5"
OUTPUT *

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

#
# Test limit switch by indexing on 
# lower soft limit switch
#

TEST "Testing lower limit switch"
FATAL

DESC "Testing lower limit switch"

PUTVAL devMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL devNamedTarget "i4"
OUTPUT *.VALS*

CMD "deviceCommand devDir devAck devBusy"
OUTPUT *Success*

ENDTEST

#
# Verify device state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL devState
OUTPUT *.MIP* STOPPED* 

GETVAL devIndexed
OUTPUT *.HPVL* 1* 

GETVAL devLimited
OUTPUT *.LSWA* 1* 

DESC "Check device power status"
GETVAL devPower
OUTPUT *.PSTA* 0* 

ENDTEST

