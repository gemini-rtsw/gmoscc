#
#  check invalid cassette position strings
#

TEST "Try invalid position strings with the check directive"
FATAL

DESC "Reject invalid string"

PUTVAL cassetteMode "1"
OUTPUT *MODE*

PUTVAL cassetteNamedTarget "c1s0"
OUTPUT *VALS*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *reject*

DESC "check for correct cassette error message"

GETVAL cassetteMess
OUTPUT *MESS*Cannot translate named position*

PUTVAL cassetteNamedTarget "c1s1"
OUTPUT *VALS*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *accept*

DESC "Reject valid string in Caps"

PUTVAL cassetteNamedTarget "C1S1"
OUTPUT *VALS*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *reject*

DESC "check for correct cassette error message"

GETVAL cassetteMess
OUTPUT *MESS*Cannot translate named position*

PUTVAL cassetteNamedTarget "c1s1"
OUTPUT *VALS*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *accept*

DESC "Initializing cassette to clear SVAL field"

PUTVAL cassetteMode "0"
OUTPUT *MODE*MODE*INIT*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

ENDTEST

#
#  check out of bounds cassette positions
#

TEST "Try out of bounds positions with the check directive"
FATAL

DESC "Reject bottom limit position"

PUTVAL cassetteMode "1"
OUTPUT *MODE*

PUTVAL cassetteTarget "-10.1"
OUTPUT *VAL*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *reject*

GETVAL cassetteMess
OUTPUT *MESS*Target position out of range*

CMD "setField cassetteTarget cassetteMinPos"
OUTPUT *Success*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *accept*

DESC "Reject top limit position"

PUTVAL cassetteMode "1"
OUTPUT *MODE*

PUTVAL cassetteTarget "276.1"
OUTPUT *VAL*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *reject*

GETVAL cassetteMess
OUTPUT *MESS*Target position out of range*

CMD "setField cassetteTarget cassetteMaxPos"
OUTPUT *Success*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *accept*

#DESC "Reject alpha position"

#PUTVAL cassetteMode "1"
#OUTPUT *MODE*

#PUTVAL cassetteTarget "c1s1"
#OUTPUT *VAL*

#CMD "checkCommand cassetteDir cassetteAck"
#OUTPUT *reject*

#GETVAL cassetteMess
#OUTPUT *MESS*Target position out of range*

#CMD "setField cassetteTarget cassetteMaxPos"
#OUTPUT *Success*

#CMD "checkCommand cassetteDir cassetteAck"
#OUTPUT *accept*

ENDTEST

#
#  check invalid cassette velocities
#

TEST "Try invalid velocities with the check directive"
FATAL

DESC "Reject velocities below low limit"

PUTVAL cassetteMode "1"
OUTPUT *MODE*

PUTVAL cassetteVelo "4.9"
OUTPUT *VELO*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *reject*

GETVAL cassetteMess
OUTPUT *MESS*Velocity out of range*

CMD "setField cassetteVelo cassetteMinVel"
OUTPUT *Success*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *accept*

DESC "Reject velocities above high limit"

PUTVAL cassetteMode "1"
OUTPUT *MODE*

PUTVAL cassetteVelo "25.1"
OUTPUT *VELO*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *reject*

GETVAL cassetteMess
OUTPUT *MESS*Velocity out of range*

PUTVAL cassetteVelo "20"
OUTPUT *VELO*

CMD "checkCommand cassetteDir cassetteAck"
OUTPUT *accept*

ENDTEST

#
#  check cassette/extractor interlock
#

TEST "Attempt cassette move with extractor at ID"
FATAL

DESC "INDEX cassette"

PUTVAL cassetteMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

DESC "check to ensure cassette is currently indexed"

GETVAL cassetteIndex
OUTPUT *HPVL* 1*

DESC "move extractor to ID position"

PUTVAL extractorVelo "35"
OUTPUT *

PUTVAL extractorMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL extractorNamedTarget "id"
OUTPUT *

CMD "deviceCommand extractorDir extractorAck extractorBusy"
OUTPUT *Success*

DESC "attempt to INDEX cassette"

PUTVAL cassetteMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Failed*

DESC "check for correct cassette error message"

GETVAL cassetteMess
OUTPUT *MESS*no motor power ... interlocked?*

DESC "check to ensure index is lost"

GETVAL cassetteIndex
OUTPUT *HPVL* 0*

DESC "move extractor back to clear position"

PUTVAL extractorNamedTarget "clear"
OUTPUT *

CMD "deviceCommand extractorDir extractorAck extractorBusy"
OUTPUT *Success*

DESC "INDEX cassette"

PUTVAL cassetteMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

DESC "check to ensure cassette is currently indexed"

GETVAL cassetteIndex
OUTPUT *HPVL* 1*

ENDTEST

#
#  check cassette/release interlock
#

TEST "Attempt cassette move with release released"
FATAL

DESC "move release to release position"

PUTVAL releaseMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL releaseNamedTarget "release"
OUTPUT *VALS*

CMD "deviceCommand releaseDir releaseAck releaseBusy"
OUTPUT *Success*

DESC "attempt to INDEX cassette"

PUTVAL cassetteMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Failed*

DESC "check for correct cassette error message"

GETVAL cassetteMess
OUTPUT *MESS*no motor power ... interlocked?*

DESC "check to ensure index is lost"

GETVAL cassetteIndex
OUTPUT *HPVL* 0*

DESC "move release back to lock position"

PUTVAL releaseNamedTarget "lock"
OUTPUT *VALS*

CMD "deviceCommand releaseDir releaseAck releaseBusy"
OUTPUT *Success*

DESC "INDEX cassette"

PUTVAL cassetteMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

DESC "check to ensure cassette is currently indexed"

GETVAL cassetteIndex
OUTPUT *HPVL* 1*

ENDTEST


#
#  Ensure position limits from gmMask.pv are reachable
#

TEST "Ensure upper & lower position limits are reachable"
FATAL

DESC "move to lower position limit"

CMD "setField cassetteTarget cassetteMinPos"
OUTPUT *Success*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

DESC "move to upper position limit"

CMD "setField cassetteTarget cassetteMaxPos"
OUTPUT *Success*

PUTVAL cassetteMode "1"
OUTPUT *MODE*MODE*MOVE*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

ENDTEST

#
#  Drive into upper limit and check response
#

TEST "Drive into upper limit and check response"
FATAL

DESC "index on upper limit switch"

PUTVAL cassetteMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL cassetteNamedTarget "i5"
OUTPUT *VALS*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

GETVAL cassetteIndex
OUTPUT *HPVL* 1*

DESC "move negative 10 steps"

PUTVAL cassetteMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL cassetteTarget "-10"
OUTPUT *VAL*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

DESC "attempt move positive 15 steps into limit"

PUTVAL cassetteTarget "15"
OUTPUT *VAL*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Failed*

DESC "check for message 'Device hit a soft limit' "

GETVAL cassetteMess
OUTPUT *MESS*Device hit a soft limit*

GETVAL cassetteIndex
OUTPUT *HPVL* 0*

ENDTEST

#
#  Attempt to move without first indexing
#

TEST "Attempt to move without first indexing"
FATAL

DESC "attempt another move positive 30 steps"

PUTVAL cassetteTarget "30"
OUTPUT *VAL*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *rejected*

DESC "check for message 'Must re-index device before moving' "

GETVAL cassetteMess
OUTPUT *MESS*Must re-index device before moving*


ENDTEST

#
#  Attempt to move further into upper limit
#

TEST "Attempt to move further into upper limit"
FATAL

DESC "index on upper limit switch"

PUTVAL cassetteNamedTarget "i5"
OUTPUT *VALS*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

DESC "attempt another move positive 30 steps"

PUTVAL cassetteMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL cassetteTarget "30"
OUTPUT *VAL*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Failed*

DESC "check for message 'Can not move into a soft limit' "

GETVAL cassetteMess
OUTPUT *MESS*Can not move into a soft limit*


ENDTEST

#
#  Drive into lower limit and check response
#

TEST "Drive into lower limit and check response"
FATAL

DESC "index on lower limit switch"

PUTVAL cassetteNamedTarget "i4"
OUTPUT *VALS*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

GETVAL cassetteIndex
OUTPUT *HPVL* 1*

DESC "move positive 10 steps"

PUTVAL cassetteMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL cassetteTarget "10"
OUTPUT *VAL*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

DESC "attempt move negative 10 steps into limit"

PUTVAL cassetteTarget "-10"
OUTPUT *VAL*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Failed*

GETVAL cassetteIndex
OUTPUT *HPVL* 0*

DESC "check for message 'Device hit a soft limit' "

GETVAL cassetteMess
OUTPUT *MESS*Device hit a soft limit*

ENDTEST

#
#  Attempt to move without first indexing
#

TEST "Attempt to move without first indexing"
FATAL

DESC "attempt move again"

PUTVAL cassetteTarget "-10"
OUTPUT *VAL*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *rejected*

DESC "check for message 'Must re-index device before moving' "

GETVAL cassetteMess
OUTPUT *MESS*Must re-index device before moving*


ENDTEST

#
#  Attempt to move further into lower limit
#

TEST "Attempt to move further into lower limit"
FATAL

DESC "index on lower limit switch"

PUTVAL cassetteNamedTarget "i4"
OUTPUT *VALS*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

DESC "attempt to move negative 10 steps"

PUTVAL cassetteMode "1"
OUTPUT *MODE*MODE*MOVE*

PUTVAL cassetteTarget "-10"
OUTPUT *VAL*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Failed*

DESC "check for message 'Can not move into a soft limit' "

GETVAL cassetteMess
OUTPUT *MESS*Can not move into a soft limit*

DESC "Index cassette"

PUTVAL cassetteMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "deviceCommand cassetteDir cassetteAck cassetteBusy"
OUTPUT *Success*

GETVAL cassetteIndex
OUTPUT *HPVL* 1*

ENDTEST

COMMENT "Cassette error check is OK"

 
