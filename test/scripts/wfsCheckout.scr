CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next X"
PUTVAL wfsMXTarget "90"
OUTPUT *.A*.A* 90*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next X"
PUTVAL wfsMXTarget "80"
OUTPUT *.A*.A* 80*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

