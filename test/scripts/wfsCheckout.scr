#
# Do a series of short probe moves
#

TEST "Do a series of short probe moves"
FATAL

DESC "Index first"

PUTVAL wfsMode "3"
OUTPUT *MODE*MODE*INDEX*

CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Moving to first corner"

PUTVAL wfsMXTarget "-1"
OUTPUT * -1*

PUTVAL wfsMYTarget "-1"
OUTPUT * -1*

PUTVAL wfsMode "1"
OUTPUT *MODE*MODE*MOVE*

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Moving to second corner"

PUTVAL wfsMYTarget "1"
OUTPUT * 1*

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Moving to third corner"

PUTVAL wfsMXTarget "1"
OUTPUT * 1*

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Moving to fourth corner"

PUTVAL wfsMYTarget "-1"
OUTPUT * -1*

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST

#
# Move the probe to lower left corner
#

TEST "Checking field coverage - min X edge"
FATAL

DESC "Moving to first corner"

DESC "Load X attribute with minimum value"
PUTVAL wfsMXTarget "-7.1"
OUTPUT *.A*.A* -7.1*

DESC "Load Y attribute with minimum value"
PUTVAL wfsMYTarget "-21.7"
OUTPUT *.B*.B* -21.7*

DESC "Set MODE to TRACK"
PUTVAL wfsMode "2"
OUTPUT *.MODE*.MODE*TRACK*

DESC "Set solution type to 1"
PUTVAL wfsSol "1"
OUTPUT *.C*.C* 1*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next Y"
PUTVAL wfsMYTarget "-10"
OUTPUT *.B*.B* -10*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next Y"
PUTVAL wfsMYTarget "0"
OUTPUT *.B*.B* 0*

