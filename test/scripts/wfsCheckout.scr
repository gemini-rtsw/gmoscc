OUTPUT *.A*.A* -7.1*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST


#
# Verify assembly state after command
#

TEST "Verify state after command"
FATAL

DESC "Verify state after command"

GETVAL wfsState
OUTPUT *.ASTA* IDLE* 

GETVAL wfsInitialized
OUTPUT *.INIT* 1* 

GETVAL wfsIndexed
OUTPUT *.INDX* 1* 

GETVAL wfsParked
OUTPUT *.PARK* 0* 

GETVAL wfsHealth
OUTPUT *.HLTH* GOOD* 

DESC "Check device power status"
GETVAL basePower
OUTPUT *.PSTA* 1* 
# COMMENT OUT UNTIL POWER STATUS PROBLEM FIXED
#OUTPUT *
GETVAL pickoffPower
OUTPUT *.PSTA* 1* 
# COMMENT OUT UNTIL POWER STATUS PROBLEM FIXED
#OUTPUT *

ENDTEST

#
# And back to center
#

TEST "Put the wfs to the optical axis"
FATAL

DESC "Putting the wfs to center"

PUTVAL wfsMXTarget "0.0"
OUTPUT *0*

PUTVAL wfsMYTarget "0.0"
OUTPUT *0*

DESC "Set MODE to MOVE"
PUTVAL wfsMode "1"
OUTPUT *.MODE*.MODE*MOVE*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

DESC "Check device power status"
GETVAL basePower
OUTPUT *.PSTA* 0* 
# COMMENT OUT UNTIL POWER STATUS PROBLEM FIXED
#OUTPUT *
GETVAL pickoffPower
OUTPUT *.PSTA* 0* 
# COMMENT OUT UNTIL POWER STATUS PROBLEM FIXED
#OUTPUT *

ENDTEST

#
# Log the actual XY coordinates
#
TEST "Log the actual XY coordinates"
FATAL

DESC "Log the current X position"
GETVAL wfsMXPos
OUTPUT *VALA*

DESC "Log the current Y position"
GETVAL wfsMYPos
OUTPUT *VALB*

ENDTEST

#
# Log the base/pickoff angles calculated from sin/cos pots
#
TEST "Log the base/pickoff angles calculated from sin/cos pots"
FATAL

DESC "Log the absolute base angle"
GETVAL wfsBasAbs
OUTPUT *VALA*

DESC "Log the absolute pickoff angle"
GETVAL wfsPkoAbs
OUTPUT *VALB*

ENDTEST

#
# Test receipt of new target while already moving
#

TEST "Test receipt of new target while already moving"
FATAL

DESC "Start in upper left corner"

DESC "Load X attribute with minimum value"
CMD "setField wfsMXTarget wfsXMin"
OUTPUT *Success*

DESC "Load Y attribute with maximum value"
CMD "setField wfsMYTarget wfsYMax"
OUTPUT *Success*

DESC "Start the command and wait for Car to finish"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Start move to upper right corner"

DESC "Load X attribute with maximum value"
CMD "setField wfsMXTarget wfsXMax"
OUTPUT *Success*

DESC "Load Y attribute with maximum value"
CMD "setField wfsMYTarget wfsYMax"
OUTPUT *Success*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Give it awhile to get into the move"
CMD "sleep 1"
OUTPUT *

DESC "Interrupt with move to optical centre"

PUTVAL wfsMXTarget "0.0"
OUTPUT *.A* 0.0*

PUTVAL wfsMYTarget "0.0"
OUTPUT *.B* 0.0*

DESC "Start the command"
CMD "startCommand wfsDir wfsAck wfsBusy"
OUTPUT *Started*

DESC "Check the state"
CMD "checkState wfsState MOVING"
OUTPUT *Success*

DESC "Check the Car"
GETVAL wfsBusy
OUTPUT *.BUSY*BUSY*

DESC "Look for successful completion"
CMD "finishCommand wfsBusy"
OUTPUT *Success*

ENDTEST

