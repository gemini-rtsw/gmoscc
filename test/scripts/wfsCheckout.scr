OUTPUT *Success*

DESC "Load next Y"
PUTVAL wfsMYTarget "130"
OUTPUT *.B*.B* 130*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

ENDTEST

