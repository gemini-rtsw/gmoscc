PUTVAL wfsMXTarget "70"
OUTPUT *.A*.A* 70*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next X"
PUTVAL wfsMXTarget "60"
OUTPUT *.A*.A* 60*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next X"
PUTVAL wfsMXTarget "50"
OUTPUT *.A*.A* 50*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next X"
PUTVAL wfsMXTarget "40"
OUTPUT *.A*.A* 40*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next X"
PUTVAL wfsMXTarget "30"
OUTPUT *.A*.A* 30*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

DESC "Load next X"
PUTVAL wfsMXTarget "20"
OUTPUT *.A*.A* 20*

DESC "Execute the command"
CMD "executeCommand wfsDir wfsAck wfsBusy"
OUTPUT *Success*

