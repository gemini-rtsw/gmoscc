# monitor_tolerance.cau
#
# cau macro which monitors CAD/CAR records associated with OIWFS tolerance.
# Invoked using cau "source" command.
#

monitor gm:wfs:tolerance.DIR
monitor gm:wfs:tolerance.VAL
monitor gm:wfs:tolerance.A
monitor gm:wfs:tolerance.B
monitor gm:wfs:tolerance.OMSS

# Type dataOut cau_tolerance.log
